<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || 'Dashboard Admin' %> - SIPAT</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'Inter', 'sans-serif']
          },
          colors: {
            primary: '#1f2937',
            brand: { 50: '#f4f4f5', 100: '#e4e4e7', 700: '#1f2937', 800: '#111827' }
          },
          boxShadow: {
            '2xs': '0 1px 2px 0 rgb(0 0 0 / 0.04)',
            'primary': '0 4px 14px -3px rgba(31, 41, 55, 0.35)'
          },
          borderRadius: {
            'xl': '0.875rem',
            '2xl': '1.25rem'
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="font-sans bg-slate-50 text-slate-900 min-h-screen overflow-x-hidden antialiased">
  <div id="app-shell" class="flex h-screen w-full overflow-hidden">
    <%- include('../partials/sidebar-admin') %>

    <div class="flex flex-1 flex-col min-w-0 h-full overflow-hidden">
      <%- include('../partials/header') %>

      <main class="flex-1 overflow-x-hidden overflow-y-auto p-4 sm:p-6 lg:p-8 pb-20 lg:pb-8">
        <div class="max-w-[1600px] mx-auto w-full flex flex-col h-full">
          <%- body %>
        </div>
      </main>
    </div>
  </div>

  <%- include('../partials/mobile-nav-admin') %>

  <!-- Global Modal Logout -->
  <div id="modal-logout" class="fixed inset-0 z-[100] hidden">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity duration-300" id="modal-logout-overlay"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
      <div id="modal-logout-content" class="w-full max-w-md bg-white rounded-2xl shadow-2xl border border-slate-100 flex flex-col overflow-hidden pointer-events-auto transform transition-all duration-300 scale-95 opacity-0 translate-y-4">
        <div class="px-6 py-5 border-b border-slate-100 flex items-start justify-between gap-4">
          <div class="flex items-center space-x-3">
            <div class="w-11 h-11 rounded-xl bg-red-50 text-red-600 border border-red-100 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">logout</span>
            </div>
            <div>
              <h2 class="text-lg font-bold text-slate-900 leading-tight">Konfirmasi Keluar</h2>
              <p class="text-xs text-slate-500 mt-1">Anda akan mengakhiri sesi login saat ini.</p>
            </div>
          </div>
          <button id="btn-close-logout" type="button" class="p-2 -mt-1 -mr-2 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors ml-2">
            <span class="material-symbols-outlined text-[20px]">close</span>
          </button>
        </div>
        <div class="px-6 py-4 bg-slate-50/60 border-t border-slate-100 flex items-center justify-end gap-3 shrink-0">
          <button id="btn-cancel-logout" type="button" class="px-5 py-2.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-800 hover:bg-slate-200/60 border border-slate-200 bg-white transition shadow-2xs">Batal</button>
          <button id="btn-confirm-logout" type="button" class="px-6 py-2.5 rounded-xl text-xs font-semibold text-white bg-red-600 hover:bg-red-700 transition shadow-sm inline-flex items-center gap-2">
            <span class="material-symbols-outlined text-[16px]">logout</span>
            <span>Ya, Keluar</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Reusable Confirmation / Alert Modal -->
  <dialog id="action-modal" data-sipat-modal class="hidden fixed inset-0 z-[120] m-0 w-full h-full max-w-none max-h-none border-0 p-4 bg-slate-900/50 backdrop-blur-sm backdrop:bg-transparent flex items-center justify-center" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="action-modal-title">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-md transform transition-all duration-200 scale-95 opacity-0">
      <div class="p-5 border-b border-slate-100 flex items-start justify-between gap-3">
        <div class="flex items-start gap-3 min-w-0">
          <div id="action-modal-icon-wrap" class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 border border-blue-100 flex items-center justify-center shrink-0">
            <span id="action-modal-icon" class="material-symbols-outlined text-[21px]">help</span>
          </div>
          <div class="min-w-0">
            <h2 class="text-lg font-bold text-slate-900 leading-tight" id="action-modal-title">Konfirmasi</h2>
            <p id="action-modal-subtitle" class="text-xs text-slate-500 mt-1 hidden"></p>
          </div>
        </div>
        <button id="action-modal-close" type="button" class="p-2 -mt-1 -mr-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors shrink-0" aria-label="Tutup modal">
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
      </div>
      <div id="action-modal-body" class="p-6 space-y-4 max-h-[60vh] overflow-y-auto"></div>
      <div id="action-modal-footer" class="p-5 bg-slate-50/60 border-t border-slate-100 flex flex-col sm:flex-row gap-3 sm:justify-end">
        <button id="action-modal-cancel" type="button" class="px-5 py-2.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-800 hover:bg-slate-200/60 border border-slate-200 bg-white transition shadow-2xs flex-1 sm:flex-none">Batal</button>
        <button id="action-modal-confirm" type="button" class="px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-brand-700 hover:bg-brand-800 transition shadow-sm flex-1 sm:flex-none">Ya, Lanjut</button>
      </div>
    </div>
  </dialog>

  <!-- Reusable Form Modal (edit / quick forms) -->
  <dialog id="action-form-modal" data-sipat-modal class="hidden fixed inset-0 z-[120] m-0 w-full h-full max-w-none max-h-none border-0 p-4 bg-slate-900/50 backdrop-blur-sm backdrop:bg-transparent flex items-center justify-center" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="action-form-modal-title">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-lg transform transition-all duration-200 scale-95 opacity-0 flex flex-col max-h-[90vh]">
      <div class="p-5 border-b border-slate-100 flex items-start justify-between gap-3 shrink-0">
        <div class="flex items-start gap-3 min-w-0">
          <div id="action-form-modal-icon-wrap" class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 border border-blue-100 flex items-center justify-center shrink-0">
            <span id="action-form-modal-icon" class="material-symbols-outlined text-[21px]">edit_note</span>
          </div>
          <div class="min-w-0">
            <h2 class="text-lg font-bold text-slate-900 leading-tight" id="action-form-modal-title">Edit Data</h2>
            <p id="action-form-modal-subtitle" class="text-xs text-slate-500 mt-1 hidden"></p>
          </div>
        </div>
        <button id="action-form-modal-close" type="button" class="p-2 -mt-1 -mr-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors shrink-0" aria-label="Tutup modal">
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
      </div>
      <div id="action-form-modal-body" class="p-6 space-y-5 overflow-y-auto"></div>
      <div id="action-form-modal-footer" class="p-5 bg-slate-50/60 border-t border-slate-100 flex flex-col sm:flex-row gap-3 sm:justify-end shrink-0">
        <button id="action-form-modal-cancel" type="button" class="px-5 py-2.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-800 hover:bg-slate-200/60 border border-slate-200 bg-white transition shadow-2xs">Batal</button>
        <button id="action-form-modal-save" type="button" class="px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-brand-700 hover:bg-brand-800 transition shadow-sm inline-flex items-center justify-center gap-2">
          <span class="material-symbols-outlined text-[16px]">save</span><span>Simpan</span>
        </button>
      </div>
    </div>
  </dialog>

  <!-- Reusable Info / Detail Modal -->
  <dialog id="action-info-modal" data-sipat-modal class="hidden fixed inset-0 z-[120] m-0 w-full h-full max-w-none max-h-none border-0 p-4 bg-slate-900/50 backdrop-blur-sm backdrop:bg-transparent flex items-center justify-center" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="action-info-modal-title">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-lg transform transition-all duration-200 scale-95 opacity-0 flex flex-col max-h-[90vh]">
      <div class="p-5 border-b border-slate-100 flex items-start justify-between gap-3 shrink-0">
        <div class="flex items-start gap-3 min-w-0">
          <div id="action-info-modal-icon-wrap" class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 border border-blue-100 flex items-center justify-center shrink-0">
            <span id="action-info-modal-icon" class="material-symbols-outlined text-[21px]">info</span>
          </div>
          <div class="min-w-0">
            <h2 class="text-lg font-bold text-slate-900 leading-tight" id="action-info-modal-title">Detail</h2>
            <p id="action-info-modal-subtitle" class="text-xs text-slate-500 mt-1 hidden"></p>
          </div>
        </div>
        <button id="action-info-modal-close" type="button" class="p-2 -mt-1 -mr-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors shrink-0" aria-label="Tutup modal">
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
      </div>
      <div id="action-info-modal-body" class="p-6 space-y-4 overflow-y-auto"></div>
      <div class="p-5 bg-slate-50/60 border-t border-slate-100 flex justify-end shrink-0">
        <button id="action-info-modal-ok" type="button" class="px-5 py-2.5 rounded-xl bg-slate-900 text-white text-xs font-semibold hover:bg-slate-800 transition shadow-sm">Tutup</button>
      </div>
    </div>
  </dialog>

  <!-- Toast feedback -->
  <div id="sipat-toast-container" class="fixed top-4 right-4 z-[200] flex flex-col gap-2 w-[calc(100%-2rem)] max-w-sm pointer-events-none" aria-live="polite" aria-atomic="false"></div>

  <script src="/js/admin-layout.js"></script>
  <script>
    /*
     * SIPAT shared UI helpers.
     * All admin tables use these helpers so confirmations, detail dialogs,
     * edit forms, loading states, and feedback stay consistent.
     */
    (function () {
      'use strict';

      var actionModal = document.getElementById('action-modal');
      var actionModalContent = actionModal ? actionModal.querySelector(':scope > div') : null;
      var actionModalTitle = document.getElementById('action-modal-title');
      var actionModalSubtitle = document.getElementById('action-modal-subtitle');
      var actionModalBody = document.getElementById('action-modal-body');
      var actionModalCancel = document.getElementById('action-modal-cancel');
      var actionModalConfirm = document.getElementById('action-modal-confirm');
      var actionModalClose = document.getElementById('action-modal-close');
      var actionModalIconWrap = document.getElementById('action-modal-icon-wrap');
      var actionModalIcon = document.getElementById('action-modal-icon');

      var formModal = document.getElementById('action-form-modal');
      var formModalContent = formModal ? formModal.querySelector(':scope > div') : null;
      var formModalTitle = document.getElementById('action-form-modal-title');
      var formModalSubtitle = document.getElementById('action-form-modal-subtitle');
      var formModalBody = document.getElementById('action-form-modal-body');
      var formModalCancel = document.getElementById('action-form-modal-cancel');
      var formModalSave = document.getElementById('action-form-modal-save');
      var formModalClose = document.getElementById('action-form-modal-close');
      var formModalIconWrap = document.getElementById('action-form-modal-icon-wrap');
      var formModalIcon = document.getElementById('action-form-modal-icon');

      var infoModal = document.getElementById('action-info-modal');
      var infoModalContent = infoModal ? infoModal.querySelector(':scope > div') : null;
      var infoModalTitle = document.getElementById('action-info-modal-title');
      var infoModalSubtitle = document.getElementById('action-info-modal-subtitle');
      var infoModalBody = document.getElementById('action-info-modal-body');
      var infoModalClose = document.getElementById('action-info-modal-close');
      var infoModalOk = document.getElementById('action-info-modal-ok');
      var infoModalIconWrap = document.getElementById('action-info-modal-icon-wrap');
      var infoModalIcon = document.getElementById('action-info-modal-icon');

      var toastContainer = document.getElementById('sipat-toast-container');
      var modalStates = new WeakMap();

      var TONES = {
        info: { wrap: 'bg-blue-50 text-blue-600 border-blue-100', icon: 'info' },
        success: { wrap: 'bg-emerald-50 text-emerald-600 border-emerald-100', icon: 'check_circle' },
        warning: { wrap: 'bg-amber-50 text-amber-600 border-amber-100', icon: 'warning' },
        danger: { wrap: 'bg-rose-50 text-rose-600 border-rose-100', icon: 'delete_forever' }
      };

      function escapeHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function (character) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character];
        });
      }

      function isOpen(modal) {
        return Boolean(modal && !modal.classList.contains('hidden'));
      }

      function anyModalOpen() {
        return Array.prototype.some.call(document.querySelectorAll('[data-sipat-modal]'), isOpen);
      }

      function lockScroll() {
        document.body.style.overflow = 'hidden';
      }

      function unlockScroll() {
        if (!anyModalOpen()) document.body.style.overflow = '';
      }

      function iconElement(wrap, icon, tone) {
        var selected = TONES[tone] || TONES.info;
        if (wrap) {
          wrap.className = 'w-10 h-10 rounded-xl border flex items-center justify-center shrink-0 ' + selected.wrap;
        }
        if (icon) {
          icon.textContent = selected.icon;
        }
      }

      function setSubtitle(element, subtitle) {
        if (!element) return;
        if (subtitle) {
          element.textContent = subtitle;
          element.classList.remove('hidden');
        } else {
          element.textContent = '';
          element.classList.add('hidden');
        }
      }

      function animateOpen(modal, content) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        modal.setAttribute('aria-hidden', 'false');
        if (modal.tagName === 'DIALOG' && typeof modal.showModal === 'function' && !modal.open) {
          try { modal.showModal(); } catch (error) { /* no-op */ }
        }
        if (content) {
          content.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
          content.classList.add('scale-95', 'opacity-0', 'translate-y-4');
          requestAnimationFrame(function () {
            content.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
            content.classList.add('scale-100', 'opacity-100', 'translate-y-0');
          });
        }
        lockScroll();
      }

      function animateClose(modal, content, callback) {
        if (!modal) return;
        var state = modalStates.get(modal);
        if (!state || state.closing) return;
        state.closing = true;

        if (content) {
          content.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
          content.classList.add('scale-95', 'opacity-0', 'translate-y-4');
        }

        window.setTimeout(function () {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          modal.setAttribute('aria-hidden', 'true');
          if (modal.tagName === 'DIALOG' && modal.open && typeof modal.close === 'function') {
            try { modal.close(); } catch (error) { /* no-op */ }
          }
          modalStates.delete(modal);
          unlockScroll();
          if (state.restoreFocus && document.contains(state.restoreFocus)) {
            try { state.restoreFocus.focus(); } catch (error) { /* no-op */ }
          }
          if (typeof callback === 'function') callback();
        }, 180);
      }

      function openWithState(modal, content, state) {
        if (!modal) return;
        modalStates.set(modal, state);
        animateOpen(modal, content);
        window.setTimeout(function () {
          var focusTarget = modal.querySelector('[data-autofocus]') || modal.querySelector('input:not([type="hidden"]), select, textarea, button');
          if (focusTarget) {
            try { focusTarget.focus(); } catch (error) { /* no-op */ }
          }
        }, 80);
      }

      function buttonContent(button, icon, label) {
        if (!button) return;
        button.innerHTML = '';
        var iconSpan = document.createElement('span');
        iconSpan.className = 'material-symbols-outlined text-[16px]';
        iconSpan.textContent = icon;
        var textSpan = document.createElement('span');
        textSpan.textContent = label;
        button.appendChild(iconSpan);
        button.appendChild(textSpan);
      }

      function confirmAction(options) {
        var opts = options || {};
        return new Promise(function (resolve) {
          if (!actionModal) {
            resolve(false);
            return;
          }

          var tone = opts.tone || (String(opts.confirmClass || '').indexOf('rose') !== -1 ? 'danger' : 'info');
          var finished = false;
          var processing = false;

          function finish(result) {
            if (finished) return;
            finished = true;
            animateClose(actionModal, actionModalContent, function () {
              resolve(result);
            });
          }

          actionModalTitle.textContent = opts.title || 'Konfirmasi';
          setSubtitle(actionModalSubtitle, opts.subtitle);
          iconElement(actionModalIconWrap, actionModalIcon, tone);
          actionModalBody.innerHTML = opts.message || '';

          actionModalCancel.style.display = '';
          actionModalCancel.textContent = opts.cancelText || 'Batal';
          buttonContent(
            actionModalConfirm,
            tone === 'danger' ? 'delete' : (tone === 'success' ? 'check_circle' : 'check'),
            opts.confirmText || 'Ya, Lanjut'
          );

          if (opts.confirmClass) {
            actionModalConfirm.className = opts.confirmClass;
          } else {
            actionModalConfirm.className = 'px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-brand-700 hover:bg-brand-800 transition shadow-sm flex-1 sm:flex-none';
          }
          actionModalConfirm.classList.add('inline-flex', 'items-center', 'justify-center', 'gap-2');

          var state = {
            closing: false,
            restoreFocus: document.activeElement,
            cancel: function () { if (!processing) finish(false); }
          };

          actionModalCancel.onclick = function () { finish(false); };
          actionModalClose.onclick = function () { finish(false); };
          actionModalConfirm.onclick = function () {
            if (processing) return;

            if (typeof opts.onConfirm !== 'function') {
              finish(true);
              return;
            }

            processing = true;
            var originalHtml = actionModalConfirm.innerHTML;
            var originalClass = actionModalConfirm.className;
            actionModalConfirm.disabled = true;
            actionModalConfirm.classList.add('opacity-70', 'cursor-wait', 'inline-flex', 'items-center', 'justify-center', 'gap-2');
            actionModalConfirm.innerHTML = '<span class="material-symbols-outlined text-[16px] animate-spin">progress_activity</span><span>' + escapeHtml(opts.loadingText || 'Memproses...') + '</span>';

            Promise.resolve()
              .then(function () { return opts.onConfirm(); })
              .then(function () {
                finish(true);
              })
              .catch(function (error) {
                processing = false;
                actionModalConfirm.disabled = false;
                actionModalConfirm.className = originalClass;
                actionModalConfirm.innerHTML = originalHtml;
                toast((error && error.message) || 'Terjadi kesalahan. Silakan coba lagi.', 'danger');
              });
          };
          actionModal.onclick = function (event) {
            if (event.target === actionModal && !processing) finish(false);
          };
          actionModal.oncancel = function (event) {
            event.preventDefault();
            if (!processing) finish(false);
          };

          openWithState(actionModal, actionModalContent, state);
        });
      }

      function alertAction(options) {
        var opts = options || {};
        return new Promise(function (resolve) {
          if (!actionModal) {
            resolve();
            return;
          }

          var tone = opts.tone || 'info';
          var finished = false;

          function finish() {
            if (finished) return;
            finished = true;
            actionModalCancel.style.display = 'none';
            animateClose(actionModal, actionModalContent, function () {
              actionModalCancel.style.display = '';
              resolve();
            });
          }

          actionModalTitle.textContent = opts.title || 'Informasi';
          setSubtitle(actionModalSubtitle, opts.subtitle);
          iconElement(actionModalIconWrap, actionModalIcon, tone);
          actionModalBody.innerHTML = opts.message || '';
          actionModalCancel.style.display = 'none';
          buttonContent(actionModalConfirm, 'check', opts.okText || 'Mengerti');
          actionModalConfirm.className = 'px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-brand-700 hover:bg-brand-800 transition shadow-sm flex-1 sm:flex-none inline-flex items-center justify-center gap-2';

          var state = {
            closing: false,
            restoreFocus: document.activeElement,
            cancel: finish
          };

          actionModalConfirm.onclick = finish;
          actionModalClose.onclick = finish;
          actionModal.onclick = function (event) {
            if (event.target === actionModal) finish();
          };
          actionModal.oncancel = function (event) {
            event.preventDefault();
            finish();
          };

          openWithState(actionModal, actionModalContent, state);
        });
      }

      function infoAction(options) {
        var opts = options || {};
        return new Promise(function (resolve) {
          if (!infoModal) {
            resolve();
            return;
          }

          var finished = false;
          function finish() {
            if (finished) return;
            finished = true;
            animateClose(infoModal, infoModalContent, resolve);
          }

          infoModalTitle.textContent = opts.title || 'Detail Data';
          setSubtitle(infoModalSubtitle, opts.subtitle);
          iconElement(infoModalIconWrap, infoModalIcon, opts.tone || 'info');
          infoModalBody.innerHTML = opts.message || '';
          infoModalOk.textContent = opts.okText || 'Tutup';

          var state = {
            closing: false,
            restoreFocus: document.activeElement,
            cancel: finish
          };

          infoModalOk.onclick = finish;
          infoModalClose.onclick = finish;
          infoModal.onclick = function (event) {
            if (event.target === infoModal) finish();
          };
          infoModal.oncancel = function (event) {
            event.preventDefault();
            finish();
          };

          openWithState(infoModal, infoModalContent, state);
        });
      }

      function formAction(options) {
        var opts = options || {};
        return new Promise(function (resolve) {
          if (!formModal) {
            resolve(null);
            return;
          }

          var finished = false;
          function finish(result) {
            if (finished) return;
            finished = true;
            animateClose(formModal, formModalContent, function () {
              resolve(result);
            });
          }

          formModalTitle.textContent = opts.title || 'Edit Data';
          setSubtitle(formModalSubtitle, opts.subtitle);
          iconElement(formModalIconWrap, formModalIcon, opts.tone || 'info');
          formModalBody.innerHTML = opts.formHtml || '';
          buttonContent(formModalSave, 'save', opts.saveText || 'Simpan');
          formModalSave.className = 'px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-brand-700 hover:bg-brand-800 transition shadow-sm inline-flex items-center justify-center gap-2';

          var state = {
            closing: false,
            restoreFocus: document.activeElement,
            cancel: function () { if (!submitting) finish(null); }
          };
          var submitting = false;

          function restoreSaveButton(html, className) {
            formModalSave.disabled = false;
            formModalSave.className = className;
            formModalSave.innerHTML = html;
          }

          function submit() {
            if (submitting) return;

            var invalid = Array.prototype.find.call(
              formModalBody.querySelectorAll('input, select, textarea'),
              function (input) { return typeof input.checkValidity === 'function' && !input.checkValidity(); }
            );

            if (invalid) {
              if (typeof invalid.reportValidity === 'function') invalid.reportValidity();
              return;
            }

            var data = {};
            formModalBody.querySelectorAll('input, select, textarea').forEach(function (input) {
              if (!input.name || input.disabled) return;
              if (input.type === 'checkbox') {
                data[input.name] = input.checked;
              } else if (input.type === 'radio') {
                if (input.checked) data[input.name] = input.value;
              } else {
                data[input.name] = input.value;
              }
            });

            if (typeof opts.onSubmit !== 'function') {
              finish(data);
              return;
            }

            submitting = true;
            var originalHtml = formModalSave.innerHTML;
            var originalClass = formModalSave.className;
            formModalSave.disabled = true;
            formModalSave.classList.add('opacity-70', 'cursor-wait');
            formModalSave.innerHTML = '<span class="material-symbols-outlined text-[16px] animate-spin">progress_activity</span><span>' + escapeHtml(opts.loadingText || 'Menyimpan...') + '</span>';

            Promise.resolve()
              .then(function () { return opts.onSubmit(data, formModalBody); })
              .then(function (result) {
                if (result === false) {
                  submitting = false;
                  restoreSaveButton(originalHtml, originalClass);
                  return;
                }
                restoreSaveButton(originalHtml, originalClass);
                finish(data);
              })
              .catch(function (error) {
                submitting = false;
                restoreSaveButton(originalHtml, originalClass);
                toast((error && error.message) || 'Gagal menyimpan data. Silakan coba lagi.', 'danger');
              });
          }

          formModalCancel.onclick = function () { if (!submitting) finish(null); };
          formModalClose.onclick = function () { if (!submitting) finish(null); };
          formModalSave.onclick = submit;
          formModal.onclick = function (event) {
            if (event.target === formModal && !submitting) finish(null);
          };
          formModal.oncancel = function (event) {
            event.preventDefault();
            if (!submitting) finish(null);
          };

          openWithState(formModal, formModalContent, state);
        });
      }

      function toast(message, type, duration) {
        if (!toastContainer || !message) return;
        var tone = TONES[type] ? type : 'success';
        var palette = {
          success: { color: '#047857', bg: '#ecfdf5', border: '#a7f3d0', icon: 'check_circle' },
          danger: { color: '#be123c', bg: '#fff1f2', border: '#fecdd3', icon: 'error' },
          warning: { color: '#b45309', bg: '#fffbeb', border: '#fde68a', icon: 'warning' },
          info: { color: '#1d4ed8', bg: '#eff6ff', border: '#bfdbfe', icon: 'info' }
        }[tone];

        var item = document.createElement('div');
        item.className = 'pointer-events-auto flex items-start gap-3 rounded-xl border px-4 py-3 shadow-lg shadow-slate-900/5 opacity-0 translate-y-2 transition-all duration-200';
        item.style.backgroundColor = palette.bg;
        item.style.borderColor = palette.border;
        item.style.color = palette.color;
        item.setAttribute('role', 'status');

        var icon = document.createElement('span');
        icon.className = 'material-symbols-outlined text-[20px] shrink-0';
        icon.textContent = palette.icon;

        var text = document.createElement('p');
        text.className = 'text-xs font-semibold leading-relaxed flex-1 pt-0.5';
        text.textContent = message;

        var close = document.createElement('button');
        close.type = 'button';
        close.className = 'p-0.5 rounded-md opacity-60 hover:opacity-100 transition-opacity shrink-0';
        close.setAttribute('aria-label', 'Tutup notifikasi');
        close.innerHTML = '<span class="material-symbols-outlined text-[16px]">close</span>';
        close.onclick = function () { remove(); };

        item.appendChild(icon);
        item.appendChild(text);
        item.appendChild(close);
        toastContainer.appendChild(item);

        requestAnimationFrame(function () {
          item.classList.remove('opacity-0', 'translate-y-2');
          item.classList.add('opacity-100', 'translate-y-0');
        });

        var timeout = window.setTimeout(remove, duration || 3800);

        function remove() {
          window.clearTimeout(timeout);
          if (!item.parentNode) return;
          item.classList.add('opacity-0', 'translate-y-1');
          window.setTimeout(function () {
            if (item.parentNode) item.parentNode.removeChild(item);
          }, 180);
        }
      }

      function busy(button, isBusy, busyText) {
        if (!button) return;
        if (isBusy) {
          if (!button.dataset.sipatOriginalHtml) {
            button.dataset.sipatOriginalHtml = button.innerHTML;
            button.dataset.sipatOriginalClass = button.className;
          }
          button.disabled = true;
          button.className = button.dataset.sipatOriginalClass;
          button.classList.add('inline-flex', 'items-center', 'justify-center', 'gap-2', 'opacity-70');
          button.innerHTML = '<span class="material-symbols-outlined text-[16px] animate-spin">progress_activity</span><span>' + escapeHtml(busyText || 'Memproses...') + '</span>';
        } else {
          button.disabled = false;
          if (button.dataset.sipatOriginalClass) button.className = button.dataset.sipatOriginalClass;
          if (button.dataset.sipatOriginalHtml) button.innerHTML = button.dataset.sipatOriginalHtml;
          delete button.dataset.sipatOriginalHtml;
          delete button.dataset.sipatOriginalClass;
        }
      }

      function detailList(fields) {
        return '<div class="rounded-xl border border-slate-200 overflow-hidden divide-y divide-slate-100 bg-white">' +
          (fields || []).map(function (field) {
            var value = field.html != null ? field.html : escapeHtml(field.value == null || field.value === '' ? '-' : field.value);
            var valueClass = field.mono ? 'font-mono text-xs text-slate-900' : 'text-sm font-medium text-slate-900';
            return '<div class="flex items-start justify-between gap-4 px-4 py-3">' +
              '<span class="text-xs text-slate-500 shrink-0 pt-0.5">' + escapeHtml(field.label) + '</span>' +
              '<span class="text-right break-words ' + valueClass + '">' + value + '</span>' +
              '</div>';
          }).join('') +
          '</div>';
      }

      function inputField(options) {
        var opts = options || {};
        var attributes = [
          'type="' + escapeHtml(opts.type || 'text') + '"',
          'name="' + escapeHtml(opts.name || '') + '"',
          'id="sipat-field-' + escapeHtml(opts.name || '') + '"',
          'value="' + escapeHtml(opts.value == null ? '' : opts.value) + '"',
          'placeholder="' + escapeHtml(opts.placeholder || '') + '"',
          'class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs' + (opts.readonly ? ' bg-slate-50 text-slate-500' : '') + '"'
        ];
        if (opts.required) attributes.push('required');
        if (opts.readonly) attributes.push('readonly');
        if (opts.min != null) attributes.push('min="' + escapeHtml(opts.min) + '"');
        if (opts.max != null) attributes.push('max="' + escapeHtml(opts.max) + '"');
        if (opts.step != null) attributes.push('step="' + escapeHtml(opts.step) + '"');

        return '<div>' +
          '<label class="block font-semibold text-slate-800 text-xs mb-1.5" for="sipat-field-' + escapeHtml(opts.name || '') + '">' + escapeHtml(opts.label || '') + (opts.required ? ' <span class="text-rose-500">*</span>' : '') + '</label>' +
          '<input ' + attributes.join(' ') + '>' +
          (opts.hint ? '<p class="text-[11px] text-slate-400 mt-1.5">' + escapeHtml(opts.hint) + '</p>' : '') +
          '</div>';
      }

      function selectField(options) {
        var opts = options || {};
        var current = opts.value == null ? '' : String(opts.value);
        var choices = (opts.options || []).map(function (choice) {
          var value = String(choice.value);
          return '<option value="' + escapeHtml(value) + '"' + (value === current ? ' selected' : '') + '>' + escapeHtml(choice.label) + '</option>';
        }).join('');

        return '<div>' +
          '<label class="block font-semibold text-slate-800 text-xs mb-1.5" for="sipat-field-' + escapeHtml(opts.name || '') + '">' + escapeHtml(opts.label || '') + (opts.required ? ' <span class="text-rose-500">*</span>' : '') + '</label>' +
          '<div class="relative">' +
          '<select name="' + escapeHtml(opts.name || '') + '" id="sipat-field-' + escapeHtml(opts.name || '') + '" class="w-full px-4 py-2.5 pr-9 bg-white border border-slate-200 rounded-xl text-xs text-slate-700 appearance-none focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs cursor-pointer"' + (opts.required ? ' required' : '') + '>' + choices + '</select>' +
          '<span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>' +
          '</div>' +
          '</div>';
      }

      function textareaField(options) {
        var opts = options || {};
        return '<div>' +
          '<label class="block font-semibold text-slate-800 text-xs mb-1.5" for="sipat-field-' + escapeHtml(opts.name || '') + '">' + escapeHtml(opts.label || '') + (opts.required ? ' <span class="text-rose-500">*</span>' : '') + '</label>' +
          '<textarea name="' + escapeHtml(opts.name || '') + '" id="sipat-field-' + escapeHtml(opts.name || '') + '" rows="' + escapeHtml(opts.rows || 3) + '" placeholder="' + escapeHtml(opts.placeholder || '') + '" class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs resize-y"' + (opts.required ? ' required' : '') + '>' + escapeHtml(opts.value == null ? '' : opts.value) + '</textarea>' +
          '</div>';
      }

      function statusBadge(text, tone) {
        var selected = {
          success: { color: '#047857', bg: '#ecfdf5', border: '#a7f3d0', dot: '#10b981' },
          danger: { color: '#be123c', bg: '#fff1f2', border: '#fecdd3', dot: '#f43f5e' },
          warning: { color: '#b45309', bg: '#fffbeb', border: '#fde68a', dot: '#f59e0b' },
          info: { color: '#1d4ed8', bg: '#eff6ff', border: '#bfdbfe', dot: '#3b82f6' },
          neutral: { color: '#475569', bg: '#f8fafc', border: '#e2e8f0', dot: '#94a3b8' }
        }[tone || 'info'];

        return '<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-[11px] font-semibold" style="color:' + selected.color + ';background-color:' + selected.bg + ';border-color:' + selected.border + '">' +
          '<span class="w-1.5 h-1.5 rounded-full" style="background-color:' + selected.dot + '"></span>' +
          escapeHtml(text) +
          '</span>';
      }

      document.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') return;
        var open = [actionModal, formModal, infoModal].filter(isOpen);
        if (!open.length) return;
        var top = open[open.length - 1];
        var state = modalStates.get(top);
        if (state && typeof state.cancel === 'function') {
          event.preventDefault();
          state.cancel();
        }
      });

      window.sipatModal = {
        confirm: confirmAction,
        alert: alertAction,
        info: infoAction,
        form: formAction,
        toast: toast,
        busy: busy,
        detailList: detailList,
        inputField: inputField,
        selectField: selectField,
        textareaField: textareaField,
        statusBadge: statusBadge,
        escape: escapeHtml
      };
    })();
  </script>
</body>
</html>