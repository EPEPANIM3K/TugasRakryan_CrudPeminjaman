<!-- Main Content -->
<div class="flex flex-col w-full space-y-6">
  <!-- Header Section -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-semibold text-brand-700 tracking-wider uppercase">Peminjaman Alat Laboratorium</span>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Peminjaman Alat dan Barang</h1>
      <p class="text-sm text-slate-500 mt-1">Daftar seluruh instrumen, peralatan laboratorium, dan ketersediaan stok fisik.</p>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5" id="alat-stats">
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-blue-50 text-blue-700">Total Alat</span>
        <span class="material-symbols-outlined text-[20px] text-slate-300">inventory_2</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-total-alat"><%= stats.total %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Inventaris laboratorium</div>
      </div>
    </div>
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-50 text-emerald-700">Tersedia</span>
        <span class="material-symbols-outlined text-[20px] text-slate-300">check_circle</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-tersedia"><%= stats.tersedia %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Alat siap dipinjam</div>
      </div>
    </div>
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-amber-50 text-amber-700">Sedang Dipinjam</span>
        <span class="material-symbols-outlined text-[20px] text-slate-300">pending_actions</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-dipinjam"><%= stats.dipinjam %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Alat sedang dipinjam</div>
      </div>
    </div>
  </div>

  <!-- Filter Toolbar -->
  <div class="flex flex-col lg:flex-row lg:items-center gap-4">
    <div class="flex-1 flex flex-col md:flex-row gap-3 w-full">
      <div class="flex-1 min-w-[240px] relative">
        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]">search</span>
        <input id="search-alat" class="w-full h-10 pl-10 pr-4 bg-white border border-slate-200 text-slate-900 text-sm rounded-lg focus:outline-none focus:border-blue-600 transition-colors placeholder:text-slate-400" placeholder="Cari nama alat atau kode..." type="text">
      </div>
      <div class="relative w-full sm:w-auto min-w-[200px]">
        <select id="filter-status" class="w-full h-10 appearance-none pl-3.5 pr-9 bg-white border border-slate-200 text-slate-700 text-sm rounded-lg cursor-pointer focus:outline-none focus:border-blue-600 transition-colors">
          <option value="">Semua Status</option>
          <option value="Tersedia">Tersedia</option>
          <option value="Sedang Dipinjam">Sedang Dipinjam</option>
        </select>
        <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>
      </div>
    </div>
  </div>

  <!-- Grid Cards -->
  <div id="alat-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <% items.forEach(function (item) { var tersedia = isTersedia(item); var stok = Number(item.stok_tersedia) || 0; %>
    <div class="alat-card bg-white rounded-xl overflow-hidden flex flex-col border border-slate-100 shadow-sm" data-nama="<%= item.nama_alat %>" data-kode="<%= item.kode_alat %>" data-status="<%= tersedia ? 'Tersedia' : 'Sedang Dipinjam' %>" data-stok="<%= stok %>">
      <div class="relative aspect-[4/3] bg-slate-100 rounded-lg m-3 mb-0 overflow-hidden">
        <img class="w-full h-full object-cover rounded-lg" alt="<%= item.nama_alat %>" src="<%= item.foto_url || '/images/alat/placeholder.svg' %>" onerror="this.onerror=null;this.src='/images/alat/placeholder.svg';">
        <div class="absolute top-3 left-3">
          <span class="px-2.5 py-1 rounded-md bg-white/90 backdrop-blur-sm text-slate-800 border border-slate-200 text-xs font-semibold shadow-sm inline-flex items-center gap-1"><%= stok %> Unit</span>
        </div>
        <div class="absolute bottom-3 left-3">
          <span class="px-2.5 py-1 rounded-md <%= tersedia ? 'bg-emerald-50/95 text-emerald-700 border-emerald-200' : 'bg-amber-50/95 text-amber-700 border-amber-200' %> backdrop-blur-sm border text-xs font-semibold inline-flex items-center gap-1.5 shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full <%= tersedia ? 'bg-emerald-500' : 'bg-amber-500' %>"></span> <%= tersedia ? 'Tersedia' : 'Sedang Dipinjam' %>
          </span>
        </div>
      </div>
      <div class="p-4 flex flex-col flex-1">
        <div class="space-y-2 flex-1">
          <div class="flex items-center gap-1 text-slate-500 text-xs truncate">
            <span class="material-symbols-outlined text-[15px] shrink-0">room</span>
            <span class="truncate"><%= item.nama_lab || '-' %></span>
          </div>
          <div>
            <h3 class="text-base font-semibold text-slate-900 line-clamp-1"><%= item.nama_alat %></h3>
            <p class="text-xs text-slate-500 truncate mt-0.5"><%= item.kode_alat %> · <%= item.merk || '-' %></p>
          </div>
          <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed"><%= item.deskripsi || '-' %></p>
        </div>
        <% if (tersedia) { %>
        <button type="button" class="mt-4 w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold transition-colors">Pinjam</button>
        <% } else { %>
        <button type="button" disabled class="mt-4 w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-slate-200 text-slate-500 text-sm font-semibold cursor-not-allowed">Tidak Tersedia</button>
        <% } %>
      </div>
    </div>
    <% }); %>
  </div><!-- Empty State -->
  <div id="alat-empty-state" class="hidden bg-white border border-slate-200 rounded-xl p-10 text-center">
    <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center">
      <span class="material-symbols-outlined text-[28px]">search_off</span>
    </div>
    <h3 class="text-base font-semibold text-slate-800">Tidak ada alat ditemukan</h3>
    <p class="text-sm text-slate-500 mt-1">Coba ubah kata kunci pencarian atau filter status.</p>
  </div>

  <!-- Modal Ajukan Peminjaman (sama persis dengan halaman riwayat) -->
  <div id="peminjaman-modal" class="fixed inset-0 z-[100] hidden">
    <div id="peminjaman-modal-overlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity duration-300"></div>
    <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
      <div id="peminjaman-modal-content" class="w-full max-w-2xl bg-white rounded-2xl shadow-2xl border border-slate-100 flex flex-col overflow-hidden pointer-events-auto transform transition-all duration-300 scale-95 opacity-0 translate-y-4 max-h-[92vh]">
        <div class="px-6 py-5 border-b border-slate-100 flex items-start justify-between bg-white shrink-0 gap-4">
          <div class="flex items-start gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[22px]">add_circle</span>
            </div>
            <div>
              <h2 class="text-base font-bold text-slate-900 leading-tight">Ajukan Permohonan Peminjaman</h2>
              <p class="text-xs text-slate-500 mt-1">Isi formulir untuk mengajukan permohonan peminjaman alat.</p>
            </div>
          </div>
          <button id="btn-close-peminjaman-modal" type="button" class="p-2 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors shrink-0" aria-label="Tutup modal">
            <span class="material-symbols-outlined text-[20px]">close</span>
          </button>
        </div>
        <form id="peminjaman-form" class="p-6 space-y-5 overflow-y-auto">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Nama Alat</label>
            <input type="text" id="input-nama-alat" readonly class="w-full h-11 px-4 bg-slate-100 border border-slate-200 rounded-xl text-slate-700 text-sm cursor-not-allowed">
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Kode Alat</label>
            <input type="text" id="input-kode-alat" readonly class="w-full h-11 px-4 bg-slate-100 border border-slate-200 rounded-xl text-slate-700 text-sm cursor-not-allowed">
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Laboratorium <span class="text-rose-500">*</span></label>
            <select id="input-lab" required class="w-full h-11 appearance-none pl-3.5 pr-9 bg-white border border-slate-200 text-slate-800 text-sm cursor-pointer focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors">
              <option value="">Pilih laboratorium</option>
              <option value="Lab Biologi">Lab Biologi</option>
              <option value="Lab Kimia">Lab Kimia</option>
              <option value="Laboratorium Instrumentasi">Laboratorium Instrumentasi</option>
              <option value="Lab Biokimia">Lab Biokimia</option>
            </select>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Tanggal Peminjaman <span class="text-rose-500">*</span></label>
              <input type="date" id="input-tanggal-pinjam" required class="w-full h-11 px-4 bg-white border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors">
              <label class="mt-2.5 inline-flex items-center gap-2 text-sm text-slate-600 cursor-pointer select-none">
                <input type="checkbox" id="checkbox-pinjam-hari-ini" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
                <span>Pinjam hari ini</span>
              </label>
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-1.5">Tanggal Pengembalian <span class="text-rose-500">*</span></label>
              <input type="date" id="input-tanggal-kembali" required class="w-full h-11 px-4 bg-white border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors">
            </div>
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Jumlah <span class="text-rose-500">*</span></label>
            <input type="number" id="input-jumlah" min="1" value="1" required class="w-full h-11 px-4 bg-white border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors">
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Tujuan Peminjaman <span class="text-rose-500">*</span></label>
            <textarea id="input-tujuan" rows="3" required class="w-full px-4 py-3 bg-white border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors resize-none placeholder:text-slate-400" placeholder="Contoh: Praktikum Biologi Sel"></textarea>
          </div>
        </form>
        <div class="px-6 pb-6 pt-0 shrink-0">
          <button type="submit" form="peminjaman-form" class="w-full h-11 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold shadow-sm transition-all active:scale-[0.99]">
            Ajukan Peminjaman
          </button>
        </div>
      </div>
    </div>
  </div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const searchInput = document.getElementById('search-alat');
  const statusFilter = document.getElementById('filter-status');
  const cards = Array.from(document.querySelectorAll('.alat-card'));
  const emptyState = document.getElementById('alat-empty-state');
  const grid = document.getElementById('alat-grid');

  function applyFilters() {
    const query = (searchInput.value || '').trim().toLowerCase();
    const status = statusFilter.value || '';
    let visibleCount = 0;
    let tersediaCount = 0;
    let dipinjamCount = 0;

    cards.forEach((card) => {
      const nama = (card.dataset.nama || '').toLowerCase();
      const kode = (card.dataset.kode || '').toLowerCase();
      const cardStatus = card.dataset.status || '';
      const matchesQuery = !query || nama.includes(query) || kode.includes(query);
      const matchesStatus = !status || cardStatus === status;
      const visible = matchesQuery && matchesStatus;

      card.classList.toggle('hidden', !visible);
      if (visible) {
        visibleCount++;
        if (cardStatus === 'Tersedia') tersediaCount++;
        if (cardStatus === 'Sedang Dipinjam') dipinjamCount++;
      }
    });

    const totalEl = document.getElementById('stat-total-alat');
    const tersediaEl = document.getElementById('stat-tersedia');
    const dipinjamEl = document.getElementById('stat-dipinjam');
    if (totalEl) totalEl.textContent = String(visibleCount);
    if (tersediaEl) tersediaEl.textContent = String(tersediaCount);
    if (dipinjamEl) dipinjamEl.textContent = String(dipinjamCount);

    const isEmpty = visibleCount === 0;
    if (emptyState) emptyState.classList.toggle('hidden', !isEmpty);
    if (grid) grid.classList.toggle('hidden', isEmpty);
  }

  if (searchInput) searchInput.addEventListener('input', applyFilters);
  if (statusFilter) statusFilter.addEventListener('change', applyFilters);
  applyFilters();

  function getStoredBorrowings() {
    try {
      const raw = localStorage.getItem('sipat_borrowings');
      return raw ? JSON.parse(raw) : [];
    } catch (e) {
      return [];
    }
  }

  function setStoredBorrowings(list) {
    localStorage.setItem('sipat_borrowings', JSON.stringify(list));
  }

  function generateCode() {
    const now = new Date();
    const y = now.getFullYear();
    const m = String(now.getMonth() + 1).padStart(2, '0');
    const d = String(now.getDate()).padStart(2, '0');
    const rand = Math.floor(1000 + Math.random() * 9000);
    return 'PJ-' + y + m + d + '-' + rand;
  }

  function openModal(prefill) {
    var modal = document.getElementById('peminjaman-modal');
    var content = document.getElementById('peminjaman-modal-content');
    if (prefill) {
      document.getElementById('input-nama-alat').value = prefill.nama || '';
      document.getElementById('input-kode-alat').value = prefill.kode || '';
    } else {
      document.getElementById('input-nama-alat').value = '';
      document.getElementById('input-kode-alat').value = '';
    }
    document.getElementById('input-lab').value = '';
    document.getElementById('input-jumlah').value = '1';
    document.getElementById('input-tujuan').value = '';
    var tanggalInput = document.getElementById('input-tanggal-pinjam');
    var tanggalKembaliInput = document.getElementById('input-tanggal-kembali');
    var cbToday = document.getElementById('checkbox-pinjam-hari-ini');
    if (tanggalInput) {
      var todayStr = new Date().toISOString().slice(0, 10);
      tanggalInput.value = todayStr;
      tanggalInput.min = todayStr;
      if (cbToday) cbToday.checked = true;
      tanggalInput.disabled = true;
    }
    if (tanggalKembaliInput) {
      tanggalKembaliInput.value = '';
      tanggalKembaliInput.min = new Date().toISOString().slice(0, 10);
    }
    modal.classList.remove('hidden');
    requestAnimationFrame(function () {
      content.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
      content.classList.add('scale-100', 'opacity-100', 'translate-y-0');
    });
  }

  function closeModal() {
    var modal = document.getElementById('peminjaman-modal');
    var content = document.getElementById('peminjaman-modal-content');
    if (!modal || !content) return;
    content.classList.add('scale-95', 'opacity-0', 'translate-y-4');
    content.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
    setTimeout(function () { modal.classList.add('hidden'); }, 200);
  }

  document.querySelectorAll('.alat-card button').forEach(function (btn) {
    if (btn.disabled) return;
    btn.addEventListener('click', function () {
      const card = btn.closest('.alat-card');
      if (!card) return;
      const nama = card.dataset.nama || '';
      const kode = card.dataset.kode || '';
      openModal({ nama: nama, kode: kode });
    });
  });

  var btnClose = document.getElementById('btn-close-peminjaman-modal');
  var overlay = document.getElementById('peminjaman-modal-overlay');
  var form = document.getElementById('peminjaman-form');
  var cbToday = document.getElementById('checkbox-pinjam-hari-ini');
  var tanggalInput = document.getElementById('input-tanggal-pinjam');
  var tanggalKembaliInput = document.getElementById('input-tanggal-kembali');

  if (cbToday && tanggalInput) {
    cbToday.addEventListener('change', function () {
      var todayStr = new Date().toISOString().slice(0, 10);
      if (cbToday.checked) {
        tanggalInput.value = todayStr;
        tanggalInput.disabled = true;
      } else {
        tanggalInput.disabled = false;
        tanggalInput.focus();
      }
      if (tanggalKembaliInput) {
        tanggalKembaliInput.min = tanggalInput.value || todayStr;
        if (tanggalKembaliInput.value && tanggalKembaliInput.value < tanggalKembaliInput.min) {
          tanggalKembaliInput.value = '';
        }
      }
    });
  }
  if (tanggalInput && tanggalKembaliInput) {
    tanggalInput.addEventListener('change', function () {
      tanggalKembaliInput.min = tanggalInput.value || new Date().toISOString().slice(0, 10);
      if (tanggalKembaliInput.value && tanggalKembaliInput.value < tanggalKembaliInput.min) {
        tanggalKembaliInput.value = '';
      }
    });
  }
  if (btnClose) btnClose.addEventListener('click', closeModal);
  if (overlay) overlay.addEventListener('click', closeModal);

  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var tanggalVal = (document.getElementById('input-tanggal-pinjam').value || '').trim();
      var tanggalKembaliVal = (document.getElementById('input-tanggal-kembali').value || '').trim();
      var item = {
        kode: generateCode(),
        kodeAlat: (document.getElementById('input-kode-alat').value || '').trim(),
        namaAlat: (document.getElementById('input-nama-alat').value || '').trim(),
        lab: document.getElementById('input-lab').value || '',
        jadwal: tanggalVal,
        tanggalKembali: tanggalKembaliVal,
        jumlah: parseInt(document.getElementById('input-jumlah').value || '1', 10) || 1,
        tujuan: (document.getElementById('input-tujuan').value || '').trim(),
        status: 'Menunggu Persetujuan',
        peminjam: 'Peminjam',
        email: '',
        createdAt: new Date().toISOString()
      };
      if (!item.kodeAlat || !item.namaAlat || !item.lab || !item.jadwal || !item.tanggalKembali || !item.tujuan) {
        alert('Mohon lengkapi semua field yang wajib diisi.');
        return;
      }
      if (item.tanggalKembali < item.jadwal) {
        alert('Tanggal pengembalian tidak boleh sebelum tanggal peminjaman.');
        return;
      }
      var list = getStoredBorrowings();
      list.unshift(item);
      setStoredBorrowings(list);
      closeModal();
      alert('Permohonan peminjaman berhasil diajukan.');
    });
  }
});
</script>
