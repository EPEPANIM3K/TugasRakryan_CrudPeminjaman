    <!-- Card 2 -->
    <div class="alat-card bg-white rounded-xl overflow-hidden flex flex-col border border-slate-100 shadow-sm" data-nama="Digital Hotplate Stirrer" data-kode="HTP-002" data-status="Sedang Dipinjam" data-stok="0">
      <div class="relative aspect-[4/3] bg-slate-100 rounded-lg m-3 mb-0 overflow-hidden">
        <img class="w-full h-full object-cover rounded-lg" alt="Digital Hotplate Stirrer" src="/images/alat/placeholder.svg" onerror="this.onerror=null;this.src='/images/alat/placeholder.svg';">
        <div class="absolute top-3 left-3">
          <span class="px-2.5 py-1 rounded-md bg-white/90 backdrop-blur-sm text-slate-800 border border-slate-200 text-xs font-semibold shadow-sm inline-flex items-center gap-1">0 Unit</span>
        </div>
        <div class="absolute bottom-3 left-3">
          <span class="px-2.5 py-1 rounded-md bg-amber-50/95 backdrop-blur-sm text-amber-700 border border-amber-200 text-xs font-semibold inline-flex items-center gap-1.5 shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Sedang Dipinjam
          </span>
        </div>
      </div>
      <div class="p-4 flex flex-col flex-1">
        <div class="space-y-2 flex-1">
          <div class="flex items-center gap-1 text-slate-500 text-xs truncate">
            <span class="material-symbols-outlined text-[15px] shrink-0">room</span>
            <span class="truncate">Lab Kimia</span>
          </div>
          <div>
            <h3 class="text-base font-semibold text-slate-900 line-clamp-1">Digital Hotplate Stirrer</h3>
            <p class="text-xs text-slate-500 truncate mt-0.5">HTP-002 · Thermo Scientific</p>
          </div>
          <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">Pemanas dan pengaduk magnetik digital dengan kontrol suhu presisi.</p>
        </div>
        <button type="button" disabled class="mt-4 w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-slate-200 text-slate-500 text-sm font-semibold cursor-not-allowed">Tidak Tersedia</button>
      </div>
    </div>

    <!-- Card 3 -->
    <div class="alat-card bg-white rounded-xl overflow-hidden flex flex-col border border-slate-100 shadow-sm" data-nama="Autoclave Steam Sterilizer" data-kode="ATC-003" data-status="Tersedia" data-stok="2">
      <div class="relative aspect-[4/3] bg-slate-100 rounded-lg m-3 mb-0 overflow-hidden">
        <img class="w-full h-full object-cover rounded-lg" alt="Autoclave Steam Sterilizer" src="/images/alat/placeholder.svg" onerror="this.onerror=null;this.src='/images/alat/placeholder.svg';">
        <div class="absolute top-3 left-3">
          <span class="px-2.5 py-1 rounded-md bg-white/90 backdrop-blur-sm text-slate-800 border border-slate-200 text-xs font-semibold shadow-sm inline-flex items-center gap-1">2 Unit</span>
        </div>
        <div class="absolute bottom-3 left-3">
          <span class="px-2.5 py-1 rounded-md bg-emerald-50/95 backdrop-blur-sm text-emerald-700 border border-emerald-200 text-xs font-semibold inline-flex items-center gap-1.5 shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Tersedia
          </span>
        </div>
      </div>
      <div class="p-4 flex flex-col flex-1">
        <div class="space-y-2 flex-1">
          <div class="flex items-center gap-1 text-slate-500 text-xs truncate">
            <span class="material-symbols-outlined text-[15px] shrink-0">room</span>
            <span class="truncate">Lab Biologi</span>
          </div>
          <div>
            <h3 class="text-base font-semibold text-slate-900 line-clamp-1">Autoclave Steam Sterilizer</h3>
            <p class="text-xs text-slate-500 truncate mt-0.5">ATC-003 · Hirayama</p>
          </div>
          <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">Autoklaf sterilisasi uap bertekanan untuk sterilisasi alat dan media.</p>
