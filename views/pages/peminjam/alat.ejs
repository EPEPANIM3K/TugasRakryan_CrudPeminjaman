        <img class="w-full h-full object-cover rounded-lg" alt="Microscope Olympus CX23" src="/images/alat/placeholder.svg" onerror="this.onerror=null;this.src='/images/alat/placeholder.svg';">
        <div class="absolute top-3 left-3">
          <span class="px-2.5 py-1 rounded-md bg-white/90 backdrop-blur-sm text-slate-800 border border-slate-200 text-xs font-semibold shadow-sm inline-flex items-center gap-1">12 Unit</span>
        </div>
        <div class="absolute bottom-3 left-3">
          <span class="px-2.5 py-1 rounded-md bg-emerald-50/95 backdrop-blur-sm text-emerald-700 border border-emerald-200 text-xs font-semibold inline-flex items-center gap-1.5 shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Tersedia
