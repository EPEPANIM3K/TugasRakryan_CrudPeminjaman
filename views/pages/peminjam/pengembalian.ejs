<!-- Modal Ajukan Pengembalian -->
<div id="modal-return" class="fixed inset-0 z-[100] hidden">
  <div id="modal-return-overlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity duration-300"></div>
  <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
    <div id="modal-return-content" class="w-full max-w-2xl bg-white rounded-2xl shadow-2xl border border-slate-100 flex flex-col overflow-hidden pointer-events-auto transform transition-all duration-300 scale-95 opacity-0 translate-y-4 max-h-[92vh]">
      <div class="px-6 py-5 border-b border-slate-100 flex items-start justify-between bg-white shrink-0 gap-4">
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[22px]">assignment_return</span>
          </div>
          <div>
            <h2 class="text-base font-bold text-slate-900 leading-tight">Ajukan Pengembalian</h2>
            <p class="text-xs text-slate-500 mt-1">Pastikan kondisi alat sesuai sebelum diserahkan ke petugas lab.</p>
          </div>
        </div>
        <button id="btn-close-return" type="button" class="p-2 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors shrink-0" aria-label="Tutup modal">
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>

      <form id="form-return" class="flex flex-col min-h-0 flex-1" novalidate>
        <div class="p-6 space-y-5 overflow-y-auto">
          <!-- Item Summary -->
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex items-start gap-3.5">
            <div class="w-11 h-11 rounded-xl bg-white text-blue-600 border border-slate-200 flex items-center justify-center shrink-0">
              <span id="modal-item-icon" class="material-symbols-outlined text-[24px]">biotech</span>
            </div>
            <div class="flex-1 min-w-0">
              <h3 id="modal-item-name" class="text-sm font-bold text-slate-900 leading-tight truncate">Mikroskop Binokuler CX23</h3>
              <p id="modal-item-code" class="text-xs text-slate-500 mt-0.5 truncate">PJ-2025-0891 &middot; Lab Biologi</p>
              <p class="text-xs text-slate-500 mt-1.5">
                Jatuh tempo: <span id="modal-item-tempo" class="font-semibold text-slate-700">25 Feb 2025</span>
              </p>
            </div>
          </div>

          <div id="modal-denda-box" class="hidden bg-rose-50 border border-rose-200 rounded-xl px-4 py-3 flex items-start gap-2.5">
            <span class="material-symbols-outlined text-[18px] text-rose-600 shrink-0 mt-0.5">payments</span>
