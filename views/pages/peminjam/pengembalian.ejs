          <button id="btn-confirm-pay" type="submit" class="w-full sm:flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-sm font-semibold text-white transition-colors shadow-sm">
