<!-- Main Content -->
<div class="flex flex-col w-full space-y-6">
  <!-- Header Section -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-semibold text-brand-700 tracking-wider uppercase">Pengembalian Instrumen Laboratorium</span>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Pengembalian Alat</h1>
      <p class="text-sm text-slate-500 mt-1">Ajukan pengembalian alat yang masih Anda pinjam, lalu serahkan langsung ke petugas laboratorium untuk diverifikasi.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2.5 shrink-0"></div>
  </div>

  <%
    const _today = new Date(); _today.setHours(0,0,0,0);
    const _loans = (eligibleLoans || []).map(l => {
      const due = l.tanggal_kembali_rencana ? new Date(l.tanggal_kembali_rencana) : null;
      if (due) due.setHours(0,0,0,0);
      const diff = due ? Math.round((due - _today) / 86400000) : null;
      const isLate = l.status === 'Terlambat' || (diff !== null && diff < 0);
      const isDueToday = diff === 0;
      const lateDays = isLate && diff !== null ? Math.abs(diff) : 0;
      return Object.assign({}, l, { _diff: diff, _isLate: isLate, _isDueToday: isDueToday, _lateDays: lateDays });
    });
    const _aktif = _loans.length;
    const _jatuhTempo = _loans.filter(l => l._isLate || l._isDueToday).length;
    const _dueToday = _loans.filter(l => l._isDueToday).length;
    const _late = _loans.filter(l => l._isLate).length;
    const _overdue = _loans.find(l => l._isLate);
    const _pending = ((stats && stats.pendingVerify) || 0) + ((stats && stats.penaltyCount) || 0);
    const _dueNoteParts = [];
    if (_dueToday) _dueNoteParts.push(_dueToday + ' hari ini');
    if (_late) _dueNoteParts.push(_late + ' terlambat');
  %>
  <!-- Statistics Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-blue-50 text-blue-700">Peminjaman Aktif</span>
        <span class="material-symbols-outlined text-[20px] text-slate-300">assignment_return</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-aktif"><%= _aktif %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Alat yang masih ada di tangan Anda</div>
      </div>
    </div>
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-amber-50 text-amber-700">Jatuh Tempo</span>
        <span class="material-symbols-outlined text-[20px] text-slate-300">schedule</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-jatuh-tempo"><%= _jatuhTempo %></div>
        <div class="text-xs font-medium text-slate-400 mt-1" id="stat-jatuh-tempo-note"><%= _dueNoteParts.length ? _dueNoteParts.join(' · ') : 'Semua pengembalian sesuai jadwal' %></div>
      </div>
    </div>
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-violet-50 text-violet-700">Perlu Tindakan</span>
        <span class="material-symbols-outlined text-[20px] text-slate-300">pending_actions</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-menunggu"><%= _pending %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Menunggu verifikasi petugas atau pembayaran denda</div>
      </div>
    </div>
  </div>

  <!-- Overdue Alert -->
  <% if (_overdue) { %>
  <div id="overdue-alert" class="bg-rose-50 border border-rose-200 rounded-xl p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center gap-4">
    <div class="w-11 h-11 rounded-xl bg-white text-rose-600 border border-rose-200 flex items-center justify-center shrink-0">
      <span class="material-symbols-outlined text-[24px]">notification_important</span>
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="text-sm font-bold text-rose-900"><%= _late %> alat melewati batas pengembalian</h3>
      <p class="text-xs text-rose-700 mt-0.5 leading-relaxed">
        <span class="font-semibold"><%= _overdue.alat_nama || '-' %></span> terlambat <%= _overdue._lateDays %> hari. Estimasi denda
        <span class="font-semibold">Rp <%= (_overdue._lateDays * 5000).toLocaleString('id-ID') %></span> (Rp 5.000/hari). Segera kembalikan ke petugas lab.
      </p>
    </div>
    <button type="button" data-target="card-<%= _overdue.id %>" class="overdue-return-btn shrink-0 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold transition-colors shadow-sm">
      <span class="material-symbols-outlined text-[18px]">assignment_return</span>
      <span>Kembalikan Sekarang</span>
    </button>
  </div>
  <% } %>

  <!-- Filter Toolbar -->
  <div class="flex flex-col lg:flex-row lg:items-center gap-4">
    <div class="flex-1 flex flex-col md:flex-row gap-3 w-full">
      <div class="flex-1 min-w-[240px] relative">
        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none select-none">search</span>
        <input id="search-loan" class="w-full h-10 pl-10 pr-4 bg-white border border-slate-200 text-slate-900 text-sm rounded-lg focus:outline-none focus:border-blue-600 transition-colors placeholder:text-slate-400" placeholder="Cari nama alat, kode pinjam, atau lab..." type="text">
      </div>
      <div class="relative w-full sm:w-auto min-w-[200px]">
        <select id="filter-status" class="w-full h-10 appearance-none pl-3.5 pr-9 bg-white border border-slate-200 text-slate-700 text-sm rounded-lg cursor-pointer focus:outline-none focus:border-blue-600 transition-colors">
          <option value="">Semua Status</option>
          <option value="Sedang Dipinjam">Sedang Dipinjam</option>
          <option value="Jatuh Tempo">Jatuh Tempo</option>
          <option value="Terlambat">Terlambat</option>
          <option value="Menunggu Verifikasi">Menunggu Verifikasi</option>
          <option value="Bayar Denda">Bayar Denda</option>
        </select>
        <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>
      </div>
    </div>
  </div>

  <!-- Loan List -->
  <div class="space-y-4">
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <h2 class="text-base font-bold text-slate-900">Peminjaman Saya</h2>
        <span id="loan-count" class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 text-[11px] font-semibold"><%= _loans.length %> transaksi</span>
      </div>
      <span class="text-xs text-slate-400 hidden sm:block">Pilih alat lalu ajukan pengembalian</span>
    </div>

    <div id="loan-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <% 
        const _activeCards = returnCards.filter(c => c.type === "loan");
        const _penaltyCards = returnCards.filter(c => c.type === "penalty");
        const _pendingCards = returnCards.filter(c => c.type === "pending");
        const _paidCards = returnCards.filter(c => c.type === "paid");
        function fmtDate(d) { if(!d) return "-"; const dt=new Date(d); return dt.toLocaleDateString("id-ID",{day:"2-digit",month:"short",year:"numeric"}); }
        function dueNote(l) {
          const due = new Date(l.tanggal_kembali_rencana); due.setHours(0,0,0,0);
          const diff = Math.round((due - _today)/86400000);
          if (diff < 0) return {text: "Terlambat " + Math.abs(diff) + " hari", cls: "text-rose-600", dot: "bg-rose-500"};
          if (diff === 0) return {text: "Jatuh tempo hari ini", cls: "text-amber-600", dot: "bg-amber-500"};
          return {text: diff + " hari lagi", cls: "text-emerald-600", dot: "bg-emerald-500"};
        }
        function statusStyle(st) {
          if (st === "Terlambat" || st === "Bayar Denda") return {badge:"bg-rose-50/95 backdrop-blur-sm text-rose-700 border-rose-200", dot:"bg-rose-500"};
          if (st === "Jatuh Tempo") return {badge:"bg-amber-50/95 backdrop-blur-sm text-amber-700 border-amber-200", dot:"bg-amber-500"};
          if (st === "Menunggu Verifikasi") return {badge:"bg-violet-50/95 backdrop-blur-sm text-violet-700 border-violet-200", dot:"bg-violet-500"};
          return {badge:"bg-blue-50/95 backdrop-blur-sm text-blue-700 border-blue-200", dot:"bg-blue-500"};
        }
        const rupiah = (v) => "Rp " + Number(v || 0).toLocaleString("id-ID");
      %>
      <% _activeCards.forEach(c => { const l=c.loan; const st=l.status; const ss=statusStyle(st); const dn=dueNote(l); const lateDays=c.lateDays||0; const denda=lateDays*5000; %>
      <article class="return-card bg-white rounded-xl overflow-hidden flex flex-col border border-slate-100 shadow-sm" data-id="<%= l.id %>" data-nama="<%= l.alat_nama || '-' %>" data-kode="<%= l.kode_peminjaman %>" data-status="<%= st %>" data-lab="<%= l.nama_lab || '-' %>" data-tempo="<%= fmtDate(l.tanggal_kembali_rencana) %>" data-jumlah="<%= l.total_jumlah || 1 %>" data-icon="<%= c.icon || 'science' %>" data-denda="<%= denda ? 'Rp ' + denda.toLocaleString('id-ID') : '' %>">
        <div class="relative aspect-[4/3] bg-slate-100 rounded-lg m-3 mb-0 overflow-hidden">
          <img class="w-full h-full object-cover rounded-lg" alt="<%= l.alat_nama || 'Alat' %>" src="/images/alat/placeholder.svg" onerror="this.onerror=null;this.src='/images/alat/placeholder.svg';">
          <div class="absolute top-3 left-3"><span class="px-2.5 py-1 rounded-md bg-white/90 backdrop-blur-sm text-slate-800 border border-slate-200 text-xs font-semibold shadow-sm inline-flex items-center gap-1"><%= l.total_jumlah || 1 %> Unit</span></div>
          <div class="absolute bottom-3 left-3"><span class="status-badge px-2.5 py-1 rounded-md <%= ss.badge %> text-xs font-semibold inline-flex items-center gap-1.5 shadow-sm border"><span class="w-1.5 h-1.5 rounded-full <%= ss.dot %>"></span> <%= st %></span></div>
        </div>
        <div class="p-4 flex flex-col flex-1">
          <div class="space-y-2 flex-1">
            <div class="flex items-center gap-1 text-slate-500 text-xs truncate"><span class="material-symbols-outlined text-[15px] shrink-0">room</span><span class="truncate"><%= l.nama_lab || '-' %></span></div>
            <div><h3 class="text-base font-semibold text-slate-900 line-clamp-1"><%= l.alat_nama || '-' %></h3><p class="text-xs text-slate-500 truncate mt-0.5"><%= l.kode_peminjaman %> &middot; <%= l.alat_merk || '-' %></p></div>
            <div class="rounded-lg bg-slate-50 border border-slate-100 px-3 py-2.5 space-y-1.5">
              <div class="flex items-center justify-between gap-2 text-[11px]"><span class="text-slate-500">Tgl Pinjam</span><span class="font-semibold text-slate-800"><%= fmtDate(l.tanggal_pinjam) %></span></div>
              <div class="flex items-center justify-between gap-2 text-[11px]"><span class="text-slate-500">Jatuh Tempo</span><span class="font-semibold text-slate-800"><%= fmtDate(l.tanggal_kembali_rencana) %></span></div>
              <div class="flex items-center justify-end pt-0.5"><span class="due-note text-[11px] font-semibold <%= dn.cls %> inline-flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full <%= dn.dot %>"></span> <%= dn.text %></span></div>
            </div>
          </div>
          <button type="button" class="btn-return mt-4 w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold transition-colors"><span class="material-symbols-outlined text-[18px]">assignment_return</span><span>Kembalikan</span></button>
        </div>
      </article>
      <% }) %>

      <% _pendingCards.forEach(p => { const pinjam = p.loan || p.pengembalian || p; if (!pinjam) return; const ss=statusStyle("Menunggu Verifikasi"); %>
      <article class="return-card bg-white rounded-xl overflow-hidden flex flex-col border border-slate-100 shadow-sm" data-id="<%= pinjam.id %>" data-nama="<%= pinjam.alat_nama || '-' %>" data-kode="<%= pinjam.kode_peminjaman %>" data-status="Menunggu Verifikasi" data-lab="<%= pinjam.nama_lab || '-' %>" data-tempo="<%= fmtDate(pinjam.tanggal_kembali_rencana) %>" data-jumlah="1" data-icon="<%= p.icon || 'science' %>" data-denda="">
        <div class="relative aspect-[4/3] bg-slate-100 rounded-lg m-3 mb-0 overflow-hidden">
          <img class="w-full h-full object-cover rounded-lg" alt="<%= pinjam.alat_nama || 'Alat' %>" src="/images/alat/placeholder.svg" onerror="this.onerror=null;this.src='/images/alat/placeholder.svg';">
          <div class="absolute top-3 left-3"><span class="px-2.5 py-1 rounded-md bg-white/90 backdrop-blur-sm text-slate-800 border border-slate-200 text-xs font-semibold shadow-sm inline-flex items-center gap-1">1 Unit</span></div>
          <div class="absolute bottom-3 left-3"><span class="status-badge px-2.5 py-1 rounded-md <%= ss.badge %> text-xs font-semibold inline-flex items-center gap-1.5 shadow-sm border"><span class="w-1.5 h-1.5 rounded-full <%= ss.dot %>"></span> Menunggu Verifikasi</span></div>
        </div>
        <div class="p-4 flex flex-col flex-1">
          <div class="space-y-2 flex-1">
            <div class="flex items-center gap-1 text-slate-500 text-xs truncate"><span class="material-symbols-outlined text-[15px] shrink-0">room</span><span class="truncate"><%= pinjam.nama_lab || '-' %></span></div>
            <div><h3 class="text-base font-semibold text-slate-900 line-clamp-1"><%= pinjam.alat_nama || '-' %></h3><p class="text-xs text-slate-500 truncate mt-0.5"><%= pinjam.kode_peminjaman %> &middot; <%= pinjam.alat_merk || '-' %></p></div>
            <div class="rounded-lg bg-slate-50 border border-slate-100 px-3 py-2.5 space-y-1.5">
              <div class="flex items-center justify-between gap-2 text-[11px]"><span class="text-slate-500">Tgl Pinjam</span><span class="font-semibold text-slate-800"><%= fmtDate(pinjam.tanggal_pinjam) %></span></div>
              <div class="flex items-center justify-between gap-2 text-[11px]"><span class="text-slate-500">Jatuh Tempo</span><span class="font-semibold text-slate-800"><%= fmtDate(pinjam.tanggal_kembali_rencana) %></span></div>
              <div class="flex items-center justify-end pt-0.5"><span class="due-note text-[11px] font-semibold text-violet-600 inline-flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-violet-500"></span> Menunggu cek petugas</span></div>
            </div>
          </div>
          <button type="button" disabled class="btn-return mt-4 w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-slate-100 text-slate-500 text-sm font-semibold cursor-not-allowed"><span class="material-symbols-outlined text-[18px]">hourglass_top</span><span>Menunggu Verifikasi</span></button>
        </div>
      </article>
      <% }) %>

      <% _penaltyCards.forEach(p => { const pg = p.pengembalian || p.loan || p; if (!pg) return; const ss=statusStyle("Bayar Denda"); %>
      <article class="return-card bg-white rounded-xl overflow-hidden flex flex-col border border-rose-200 shadow-sm"
        data-id="<%= pg.id %>"
        data-nama="<%= pg.alat_nama || '-' %>"
        data-kode="<%= pg.kode_peminjaman || '-' %>"
        data-status="Bayar Denda"
        data-lab="<%= pg.nama_lab || '-' %>"
        data-tempo="<%= fmtDate(pg.tanggal_kembali_rencana) %>"
        data-jumlah="<%= pg.jumlah_pinjam || 1 %>"
        data-denda="<%= Number(pg.denda || 0) %>"
        data-catatan="<%= pg.catatan_petugas || '' %>">
        <div class="relative aspect-[4/3] bg-slate-100 rounded-lg m-3 mb-0 overflow-hidden">
          <img class="w-full h-full object-cover rounded-lg" alt="<%= pg.alat_nama || 'Alat' %>" src="/images/alat/placeholder.svg" onerror="this.onerror=null;this.src='/images/alat/placeholder.svg';">
          <div class="absolute top-3 left-3"><span class="px-2.5 py-1 rounded-md bg-white/90 backdrop-blur-sm text-slate-800 border border-slate-200 text-xs font-semibold shadow-sm inline-flex items-center gap-1"><%= pg.jumlah_pinjam || 1 %> Unit</span></div>
          <div class="absolute bottom-3 left-3"><span class="status-badge px-2.5 py-1 rounded-md <%= ss.badge %> text-xs font-semibold inline-flex items-center gap-1.5 shadow-sm border"><span class="w-1.5 h-1.5 rounded-full <%= ss.dot %>"></span> Bayar Denda</span></div>
        </div>
        <div class="p-4 flex flex-col flex-1">
          <div class="space-y-2 flex-1">
            <div class="flex items-center gap-1 text-slate-500 text-xs truncate"><span class="material-symbols-outlined text-[15px] shrink-0">room</span><span class="truncate"><%= pg.nama_lab || '-' %></span></div>
            <div><h3 class="text-base font-semibold text-slate-900 line-clamp-1"><%= pg.alat_nama || '-' %></h3><p class="text-xs text-slate-500 truncate mt-0.5"><%= pg.kode_peminjaman || '-' %> &middot; <%= pg.alat_merk || '-' %></p></div>
            <div class="rounded-lg bg-rose-50 border border-rose-100 px-3 py-2.5 space-y-1.5">
              <div class="flex items-center justify-between gap-2 text-[11px]"><span class="text-slate-500">Nominal Denda</span><span class="font-bold text-rose-700"><%= rupiah(pg.denda) %></span></div>
              <div class="flex items-center justify-between gap-2 text-[11px]"><span class="text-slate-500">Jatuh Tempo</span><span class="font-semibold text-slate-800"><%= fmtDate(pg.tanggal_kembali_rencana) %></span></div>
              <% if (pg.catatan_petugas) { %>
              <div class="text-[11px] text-rose-700 leading-relaxed line-clamp-2" title="<%= pg.catatan_petugas %>"><%= pg.catatan_petugas %></div>
              <% } %>
            </div>
          </div>
          <button type="button" class="btn-pay-denda mt-4 w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold transition-colors"><span class="material-symbols-outlined text-[18px]">payments</span><span>Bayar Denda</span></button>
        </div>
      </article>
      <% }) %>

      <% _paidCards.forEach(p => { const pg = p.pengembalian || p.loan || p; if (!pg) return; const ss=statusStyle("Menunggu Verifikasi"); %>
      <article class="return-card bg-white rounded-xl overflow-hidden flex flex-col border border-blue-200 shadow-sm"
        data-id="<%= pg.id %>"
        data-nama="<%= pg.alat_nama || '-' %>"
        data-kode="<%= pg.kode_peminjaman || '-' %>"
        data-status="Menunggu Verifikasi"
        data-lab="<%= pg.nama_lab || '-' %>"
        data-tempo="<%= fmtDate(pg.tanggal_kembali_rencana) %>"
        data-jumlah="<%= pg.jumlah_pinjam || 1 %>"
        data-denda="<%= Number(pg.denda || 0) %>">
        <div class="relative aspect-[4/3] bg-slate-100 rounded-lg m-3 mb-0 overflow-hidden">
          <img class="w-full h-full object-cover rounded-lg" alt="<%= pg.alat_nama || 'Alat' %>" src="/images/alat/placeholder.svg" onerror="this.onerror=null;this.src='/images/alat/placeholder.svg';">
          <div class="absolute top-3 left-3"><span class="px-2.5 py-1 rounded-md bg-white/90 backdrop-blur-sm text-slate-800 border border-slate-200 text-xs font-semibold shadow-sm inline-flex items-center gap-1"><%= pg.jumlah_pinjam || 1 %> Unit</span></div>
          <div class="absolute bottom-3 left-3"><span class="status-badge px-2.5 py-1 rounded-md <%= ss.badge %> text-xs font-semibold inline-flex items-center gap-1.5 shadow-sm border"><span class="w-1.5 h-1.5 rounded-full <%= ss.dot %>"></span> Menunggu Verifikasi</span></div>
        </div>
        <div class="p-4 flex flex-col flex-1">
          <div class="space-y-2 flex-1">
            <div class="flex items-center gap-1 text-slate-500 text-xs truncate"><span class="material-symbols-outlined text-[15px] shrink-0">room</span><span class="truncate"><%= pg.nama_lab || '-' %></span></div>
            <div><h3 class="text-base font-semibold text-slate-900 line-clamp-1"><%= pg.alat_nama || '-' %></h3><p class="text-xs text-slate-500 truncate mt-0.5"><%= pg.kode_peminjaman || '-' %> &middot; <%= pg.alat_merk || '-' %></p></div>
            <div class="rounded-lg bg-blue-50 border border-blue-100 px-3 py-2.5 space-y-1.5">
              <div class="flex items-center justify-between gap-2 text-[11px]"><span class="text-slate-500">Denda</span><span class="font-bold text-blue-700"><%= rupiah(pg.denda) %></span></div>
              <div class="flex items-center justify-between gap-2 text-[11px]"><span class="text-slate-500">Pembayaran</span><span class="font-semibold text-blue-700 inline-flex items-center gap-1"><span class="material-symbols-outlined text-[13px]">verified</span>Sudah Dibayarkan</span></div>
            </div>
          </div>
          <button type="button" disabled class="mt-4 w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-50 text-blue-600 border border-blue-200 text-sm font-semibold cursor-not-allowed"><span class="material-symbols-outlined text-[18px]">hourglass_top</span><span>Menunggu Verifikasi Petugas</span></button>
        </div>
      </article>
      <% }) %>
    </div>

    <div id="loan-empty-state" class="<%= returnCards.length ? 'hidden' : '' %> bg-white border border-slate-200 rounded-xl p-10 text-center">
      <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center"><span class="material-symbols-outlined text-[28px]">search_off</span></div>
      <h3 class="text-base font-semibold text-slate-800">Tidak ada transaksi ditemukan</h3>
      <p class="text-sm text-slate-500 mt-1">Coba ubah kata kunci pencarian atau filter status.</p>
    </div>
  </div>

<!-- Modal Ajukan Pengembalian -->
<div id="modal-return" class="fixed inset-0 z-[100] hidden">
  <div id="modal-return-overlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity duration-300"></div>
  <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
    <div id="modal-return-content" class="w-full max-w-2xl bg-white rounded-2xl shadow-2xl border border-slate-100 flex flex-col overflow-hidden pointer-events-auto transform transition-all duration-300 scale-95 opacity-0 translate-y-4 max-h-[92vh]">
      <div class="px-6 py-5 border-b border-slate-100 flex items-start justify-between bg-white shrink-0 gap-4">
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[22px]">assignment_return</span>
          </div>
          <div>
            <h2 class="text-base font-bold text-slate-900 leading-tight">Ajukan Pengembalian</h2>
            <p class="text-xs text-slate-500 mt-1">Pastikan kondisi alat sesuai sebelum diserahkan ke petugas lab.</p>
          </div>
        </div>
        <button id="btn-close-return" type="button" class="p-2 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors shrink-0" aria-label="Tutup modal">
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>

      <form id="form-return" class="flex flex-col min-h-0 flex-1" novalidate>
        <div class="p-6 space-y-5 overflow-y-auto">
          <!-- Item Summary -->
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex items-start gap-3.5">
            <div class="w-11 h-11 rounded-xl bg-white text-blue-600 border border-slate-200 flex items-center justify-center shrink-0">
              <span id="modal-item-icon" class="material-symbols-outlined text-[24px]">biotech</span>
            </div>
            <div class="flex-1 min-w-0">
              <h3 id="modal-item-name" class="text-sm font-bold text-slate-900 leading-tight truncate">Mikroskop Binokuler CX23</h3>
              <p id="modal-item-code" class="text-xs text-slate-500 mt-0.5 truncate">PJ-2025-0891 &middot; Lab Biologi</p>
              <p class="text-xs text-slate-500 mt-1.5">
                Jatuh tempo: <span id="modal-item-tempo" class="font-semibold text-slate-700">25 Feb 2025</span>
              </p>
            </div>
          </div>

          <div id="modal-denda-box" class="hidden bg-rose-50 border border-rose-200 rounded-xl px-4 py-3 flex items-start gap-2.5">
            <span class="material-symbols-outlined text-[18px] text-rose-600 shrink-0 mt-0.5">payments</span>
            <p class="text-xs text-rose-700 leading-relaxed">Estimasi denda keterlambatan: <span id="modal-denda" class="font-bold">Rp 10.000</span>. Denda final ditentukan petugas saat verifikasi.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="input-jumlah" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Jumlah Unit</label>
              <div class="relative">
                <input id="input-jumlah" name="jumlah" type="number" min="1" value="1" class="w-full h-10 pl-3.5 pr-14 bg-white border border-slate-200 text-slate-800 text-sm rounded-lg focus:outline-none focus:border-blue-600 transition-colors">
                <span class="absolute inset-y-0 right-3 flex items-center text-xs font-medium text-slate-400 pointer-events-none">unit</span>
              </div>
            </div>
            <div>
              <label for="input-metode" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Metode Serah Terima</label>
              <div class="relative">
                <select id="input-metode" name="metode" class="w-full h-10 appearance-none pl-3.5 pr-9 bg-white border border-slate-200 text-slate-700 text-sm rounded-lg cursor-pointer focus:outline-none focus:border-blue-600 transition-colors">
                  <option value="Serah langsung ke petugas lab">Serah langsung ke petugas lab</option>
                  <option value="Titipkan di loker pengembalian">Titipkan di loker pengembalian</option>
                </select>
                <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>
              </div>
            </div>
          </div>

          <div>
            <span class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Kondisi Alat Saat Dikembalikan</span>
            <div id="condition-group" class="space-y-2.5">
              <label class="condition-option flex items-start gap-3 p-3 rounded-xl border border-slate-200 bg-white cursor-pointer transition-all hover:border-slate-300">
                <input class="sr-only" name="kondisi" type="radio" value="Baik &amp; Lengkap">
                <span class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-[20px]">check_circle</span>
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-slate-800">Baik &amp; Lengkap</span>
                  <span class="block text-xs text-slate-500 mt-0.5">Tidak ada kerusakan, seluruh aksesori lengkap.</span>
                </span>
              </label>
              <label class="condition-option flex items-start gap-3 p-3 rounded-xl border border-slate-200 bg-white cursor-pointer transition-all hover:border-slate-300">
                <input class="sr-only" name="kondisi" type="radio" value="Rusak Ringan">
                <span class="w-9 h-9 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-[20px]">build</span>
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-slate-800">Rusak Ringan</span>
                  <span class="block text-xs text-slate-500 mt-0.5">Ada lecet, komponen longgar, atau perlu kalibrasi ulang.</span>
                </span>
              </label>
              <label class="condition-option flex items-start gap-3 p-3 rounded-xl border border-slate-200 bg-white cursor-pointer transition-all hover:border-slate-300">
                <input class="sr-only" name="kondisi" type="radio" value="Hilang / Tidak Lengkap">
                <span class="w-9 h-9 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-[20px]">report</span>
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-slate-800">Hilang / Tidak Lengkap</span>
                  <span class="block text-xs text-slate-500 mt-0.5">Ada komponen atau unit yang tidak ikut dikembalikan.</span>
                </span>
              </label>
            </div>
          </div>

          <div>
            <label for="input-catatan" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Catatan Tambahan <span class="text-slate-400 font-medium normal-case tracking-normal">(opsional)</span></label>
            <textarea id="input-catatan" name="catatan" rows="3" class="w-full px-3.5 py-2.5 bg-white border border-slate-200 text-slate-800 text-sm rounded-lg focus:outline-none focus:border-blue-600 transition-colors resize-none placeholder:text-slate-400" placeholder="Contoh: alat diserahkan bersama kabel dan kotak penyimpanan."></textarea>
          </div>

          <label class="flex items-start gap-2.5 cursor-pointer select-none">
            <input id="agree-return" type="checkbox" class="mt-0.5 w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
            <span class="text-xs text-slate-600 leading-relaxed">Saya menyatakan data pengembalian di atas benar dan bersedia menanggung denda apabila terdapat kerusakan atau kekurangan sesuai ketentuan laboratorium.</span>
          </label>

          <p id="form-error" class="hidden text-xs font-semibold text-rose-600 bg-rose-50 border border-rose-200 rounded-lg px-3.5 py-2.5"></p>
        </div>

        <div class="px-6 py-4 bg-slate-50/70 border-t border-slate-100 flex flex-col-reverse sm:flex-row items-center justify-end gap-2.5 shrink-0">
          <button id="btn-cancel-return" type="button" class="w-full sm:w-auto px-5 py-2.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-800 hover:bg-slate-200/60 border border-slate-200 bg-white transition shadow-2xs">Batal</button>
          <button type="submit"
            class="w-full sm:flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-sm font-semibold text-white transition-colors shadow-sm shadow-blue-600/20">
            <span class="material-symbols-outlined text-[16px]">send</span>
            <span>Kirim Pengembalian</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal Pembayaran Denda -->
