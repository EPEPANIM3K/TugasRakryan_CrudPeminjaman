              <p class="text-[11px] font-bold uppercase tracking-wider text-rose-700 mb-1">Catatan Pelanggaran dari Petugas</p>
              <p id="pay-catatan" class="text-xs text-slate-700 leading-relaxed whitespace-pre-line">-</p>
            </div>
          </div>

          <p id="pay-error" class="hidden text-xs font-semibold text-rose-600 bg-rose-50 border border-rose-200 rounded-lg px-3.5 py-2.5"></p>
        </div>

        <div class="px-6 py-4 bg-slate-50/70 border-t border-slate-100 flex flex-col-reverse sm:flex-row items-center justify-end gap-2.5 shrink-0">
