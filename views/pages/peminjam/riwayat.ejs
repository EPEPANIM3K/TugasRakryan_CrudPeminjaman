<!-- Header Section -->
<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <span class="text-xs font-semibold text-brand-700 tracking-wider uppercase">Sistem Peminjaman Alat</span>
    </div>
    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Peminjaman Alat</h1>
    <p class="text-sm text-slate-500 mt-1">Lihat status permohonan peminjaman dan alat yang telah dipinjam.</p>
  </div>
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-5" id="peminjam-stats">
  <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
    <div class="flex items-center justify-between mb-3">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-blue-50 text-brand-700">Menunggu Persetujuan</span>
      <span class="material-symbols-outlined text-[20px] text-slate-300">schedule</span>
    </div>
    <div class="my-2">
      <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-pending">0</div>
      <div class="text-xs font-medium text-slate-400 mt-1">Permohonan menunggu verifikasi</div>
    </div>
  </div>
  <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
    <div class="flex items-center justify-between mb-3">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-50 text-emerald-700">Disetujui</span>
      <span class="material-symbols-outlined text-[20px] text-slate-300">check_circle</span>
    </div>
    <div class="my-2">
      <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-approved">0</div>
      <div class="text-xs font-medium text-slate-400 mt-1">Permohonan telah disetujui</div>
    </div>
  </div>
  <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
    <div class="flex items-center justify-between mb-3">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-rose-50 text-rose-700">Ditolak</span>
      <span class="material-symbols-outlined text-[20px] text-slate-300">close</span>
    </div>
    <div class="my-2">
      <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-rejected">0</div>
      <div class="text-xs font-medium text-slate-400 mt-1">Permohonan ditolak</div>
    </div>
  </div>
</div>

<!-- Search & Filter Toolbar -->
<div class="rounded-xl p-4 mb-5 bg-white border border-slate-200 shadow-sm">
  <div class="flex flex-col lg:flex-row gap-3 items-stretch md:items-center justify-between">
    <div class="relative flex-1">
      <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none select-none">search</span>
      <input id="search-peminjam" class="w-full pl-10 pr-4 h-10 border border-slate-200 text-slate-700 text-sm rounded-lg placeholder-slate-400 focus:outline-none focus:bg-white focus:border-brand-700 transition-colors bg-white" placeholder="Cari kode pinjam, nama alat, atau nama peminjam..." type="text">
    </div>
    <div class="flex flex-col sm:flex-row items-center gap-3">
      <div class="relative w-full sm:w-auto min-w-[210px]">
        <select id="filter-status-peminjam" class="w-full h-10 appearance-none pl-3.5 pr-9 bg-white border border-slate-200 text-slate-700 text-sm rounded-lg cursor-pointer focus:outline-none focus:border-brand-700 transition-colors">
          <option value="">Semua Status</option>
          <option value="Menunggu Persetujuan">Menunggu Persetujuan</option>
          <option value="Disetujui">Disetujui</option>
          <option value="Ditolak">Ditolak</option>
        </select>
        <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>
      </div>
      <div class="relative w-full sm:w-auto min-w-[190px]">
        <select id="filter-lab-peminjam" class="w-full h-10 appearance-none pl-3.5 pr-9 bg-white border border-slate-200 text-slate-700 text-sm rounded-lg cursor-pointer focus:outline-none focus:border-brand-700 transition-colors">
          <option value="">Semua Laboratorium</option>
          <option value="Lab Biologi">Lab Biologi</option>
          <option value="Lab Kimia">Lab Kimia</option>
          <option value="Laboratorium Instrumentasi">Laboratorium Instrumentasi</option>
          <option value="Lab Biokimia">Lab Biokimia</option>
        </select>
        <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>
      </div>
    </div>
  </div>
</div>

<!-- Data Table Container -->
<div class="bg-white rounded-xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col">
  <div class="w-full overflow-x-auto overflow-y-auto max-h-[520px]">
    <table class="w-full text-left border-collapse">
      <thead class="sticky top-0 z-10 bg-slate-50 border-b border-slate-200 text-slate-500 uppercase tracking-wider text-[11px] font-semibold">
        <tr>
          <th class="w-12 px-3.5 py-3.5 text-center bg-slate-50 whitespace-nowrap" scope="col">NO</th>
          <th class="min-w-[130px] px-4 py-3.5 bg-slate-50 whitespace-nowrap" scope="col">KODE PINJAM</th>
          <th class="min-w-[200px] px-4 py-3.5 bg-slate-50 whitespace-nowrap" scope="col">PEMINJAM</th>
          <th class="min-w-[220px] px-4 py-3.5 bg-slate-50 whitespace-nowrap" scope="col">ALAT & LAB</th>
          <th class="min-w-[200px] px-4 py-3.5 bg-slate-50 whitespace-nowrap" scope="col">JADWAL PAKAI</th>
          <th class="min-w-[160px] px-4 py-3.5 bg-slate-50 whitespace-nowrap" scope="col">TUJUAN</th>
          <th class="min-w-[130px] px-4 py-3.5 bg-slate-50 whitespace-nowrap" scope="col">STATUS</th>
          <th class="w-24 px-4 py-3.5 text-center bg-slate-50 whitespace-nowrap" scope="col">AKSI</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 text-sm bg-white" id="peminjam-table-body">
        <tr id="peminjam-empty-state">
          <td colspan="8" class="p-8 text-center text-slate-500">
            <span class="material-symbols-outlined text-[48px] mb-3 block">inbox</span>
            <p class="font-medium">Belum ada permohonan peminjaman</p>
            <p class="text-xs mt-1">Ajukan peminjaman dari halaman Alat atau klik "Ajukan Peminjaman".</p>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- Borrowing Form Modal -->
<div id="peminjaman-modal" class="fixed inset-0 z-[100] hidden">
  <div id="peminjaman-modal-overlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity duration-300"></div>
  <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
    <div id="peminjaman-modal-content" class="w-full max-w-2xl bg-white rounded-2xl shadow-2xl border border-slate-100 flex flex-col overflow-hidden pointer-events-auto transform transition-all duration-300 scale-95 opacity-0 translate-y-4 max-h-[92vh]">
      <div class="px-6 py-5 border-b border-slate-100 flex items-start justify-between bg-white shrink-0 gap-4">
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[22px]">add_circle</span>
          </div>
          <div>
            <h2 class="text-base font-bold text-slate-900 leading-tight">Ajukan Permohonan Peminjaman</h2>
            <p class="text-xs text-slate-500 mt-1">Isi formulir untuk mengajukan permohonan peminjaman alat.</p>
          </div>
        </div>
        <button id="btn-close-peminjaman-modal" type="button" class="p-2 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors shrink-0" aria-label="Tutup modal">
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>
      <form id="peminjaman-form" class="p-6 space-y-5 overflow-y-auto">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Nama Alat</label>
          <input type="text" id="input-nama-alat" readonly class="w-full h-11 px-4 bg-slate-100 border border-slate-200 rounded-xl text-slate-700 text-sm cursor-not-allowed">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Kode Alat</label>
          <input type="text" id="input-kode-alat" readonly class="w-full h-11 px-4 bg-slate-100 border border-slate-200 rounded-xl text-slate-700 text-sm cursor-not-allowed">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Laboratorium <span class="text-rose-500">*</span></label>
          <select id="input-lab" required class="w-full h-11 appearance-none pl-4 pr-10 bg-white border border-slate-200 rounded-xl text-slate-800 text-sm cursor-pointer focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors">
            <option value="">Pilih laboratorium</option>
            <option value="Lab Biologi">Lab Biologi</option>
            <option value="Lab Kimia">Lab Kimia</option>
            <option value="Laboratorium Instrumentasi">Laboratorium Instrumentasi</option>
            <option value="Lab Biokimia">Lab Biokimia</option>
          </select>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Tanggal Peminjaman <span class="text-rose-500">*</span></label>
            <input type="date" id="input-tanggal-pinjam" required class="w-full h-11 px-4 bg-white border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors">
            <label class="mt-2.5 inline-flex items-center gap-2 text-sm text-slate-600 cursor-pointer select-none">
              <input type="checkbox" id="checkbox-pinjam-hari-ini" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
              <span>Pinjam hari ini</span>
            </label>
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Tanggal Pengembalian <span class="text-rose-500">*</span></label>
            <input type="date" id="input-tanggal-kembali" required class="w-full h-11 px-4 bg-white border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors">
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Jumlah <span class="text-rose-500">*</span></label>
          <input type="number" id="input-jumlah" min="1" value="1" required class="w-full h-11 px-4 bg-white border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Tujuan Peminjaman <span class="text-rose-500">*</span></label>
          <textarea id="input-tujuan" rows="3" required class="w-full px-4 py-3 bg-white border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors resize-none placeholder:text-slate-400" placeholder="Contoh: Praktikum Biologi Sel"></textarea>
        </div>
      </form>
      <div class="px-6 pb-6 pt-0 shrink-0">
        <button type="submit" form="peminjaman-form" class="w-full h-11 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold shadow-sm transition-all active:scale-[0.99]">
          Ajukan Peminjaman
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  function getStoredBorrowings() {
    try {
      const raw = localStorage.getItem('sipat_borrowings');
      return raw ? JSON.parse(raw) : [];
    } catch (e) {
      return [];
    }
  }

  function setStoredBorrowings(list) {
    localStorage.setItem('sipat_borrowings', JSON.stringify(list));
  }

  function generateCode() {
    const now = new Date();
    const y = now.getFullYear();
    const m = String(now.getMonth() + 1).padStart(2, '0');
    const d = String(now.getDate()).padStart(2, '0');
    const rand = Math.floor(1000 + Math.random() * 9000);
    return 'PJ-' + y + m + d + '-' + rand;
  }

  function formatDate(dateStr) {
    if (!dateStr) return '-';
    try {
      const d = new Date(dateStr + 'T00:00:00');
      return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
    } catch (e) {
      return dateStr;
    }
  }

  function statusBadge(status) {
    const map = {
      'Menunggu Persetujuan': 'bg-amber-50 text-amber-700 border border-amber-200',
      'Disetujui': 'bg-emerald-50 text-emerald-700 border border-emerald-200',
      'Ditolak': 'bg-rose-50 text-rose-700 border border-rose-200'
    };
    const cls = map[status] || 'bg-slate-50 text-slate-700 border border-slate-200';
    return '<span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold ' + cls + '">' + status + '</span>';
  }

  function renderTable() {
    const list = getStoredBorrowings();
    const tbody = document.getElementById('peminjam-table-body');
    const emptyEl = document.getElementById('peminjam-empty-state');
    if (!tbody) return;

    const q = (document.getElementById('search-peminjam') || {}).value || '';
    const statusFilter = (document.getElementById('filter-status-peminjam') || {}).value || '';
    const labFilter = (document.getElementById('filter-lab-peminjam') || {}).value || '';
    const query = q.trim().toLowerCase();

    const filtered = list.filter(function (item) {
      const hay = ((item.kode || '') + ' ' + (item.namaAlat || '') + ' ' + (item.peminjam || '')).toLowerCase();
      if (query && hay.indexOf(query) === -1) return false;
      if (statusFilter && item.status !== statusFilter) return false;
      if (labFilter && item.lab !== labFilter) return false;
      return true;
    });

    let pending = 0, approved = 0, rejected = 0;
    list.forEach(function (item) {
      if (item.status === 'Menunggu Persetujuan') pending++;
      else if (item.status === 'Disetujui') approved++;
      else if (item.status === 'Ditolak') rejected++;
    });
    var elPending = document.getElementById('stat-pending');
    var elApproved = document.getElementById('stat-approved');
    var elRejected = document.getElementById('stat-rejected');
    if (elPending) elPending.textContent = String(pending);
    if (elApproved) elApproved.textContent = String(approved);
    if (elRejected) elRejected.textContent = String(rejected);

    var rows = '';
    if (filtered.length === 0) {
      rows = '<tr><td colspan="8" class="p-8 text-center text-slate-500">' +
        '<span class="material-symbols-outlined text-[48px] mb-3 block">inbox</span>' +
        '<p class="font-medium">Tidak ada data peminjaman</p>' +
        '<p class="text-xs mt-1">Ubah filter atau ajukan peminjaman baru.</p>' +
        '</td></tr>';
    } else {
      filtered.forEach(function (item, idx) {
        rows += '<tr class="hover:bg-slate-50/80 transition-colors duration-150">' +
          '<td class="w-12 px-3.5 py-3.5 text-center font-mono text-xs text-slate-400">' + String(idx + 1).padStart(2, '0') + '</td>' +
          '<td class="px-4 py-3.5 font-mono text-xs font-semibold text-brand-700 whitespace-nowrap">' + (item.kode || '-') + '</td>' +
          '<td class="px-4 py-3.5"><div class="font-medium text-slate-900 whitespace-nowrap">' + (item.peminjam || 'Peminjam') + '</div>' +
          (item.email ? '<div class="text-[11px] text-slate-400 mt-0.5 whitespace-nowrap">' + item.email + '</div>' : '') + '</td>' +
          '<td class="px-4 py-3.5"><div class="font-medium text-slate-800">' + (item.namaAlat || '-') + '</div>' +
          '<div class="text-xs text-slate-400 mt-0.5">' + (item.lab || '-') + ' &bull; ' + (item.kodeAlat || '-') + '</div></td>' +
          '<td class="px-4 py-3.5 text-xs font-mono text-slate-700 whitespace-nowrap"><div class="text-slate-500">Pinjam</div><div class="font-medium">' + formatDate(item.jadwal) + '</div>' +
          (item.tanggalKembali ? '<div class="text-slate-500 mt-1">Kembali</div><div class="font-medium">' + formatDate(item.tanggalKembali) + '</div>' : '') +
          '<div class="text-slate-400 mt-1">' + (item.jumlah || 1) + ' unit</div></td>' +
          '<td class="px-4 py-3.5"><span class="text-xs text-slate-600 line-clamp-2 leading-relaxed">' + (item.tujuan || '-') + '</span></td>' +
          '<td class="px-4 py-3.5 whitespace-nowrap">' + statusBadge(item.status || 'Menunggu Persetujuan') + '</td>' +
          '<td class="px-4 py-3.5 text-center"><span class="text-xs text-slate-400">-</span></td>' +
          '</tr>';
      });
    }
    tbody.innerHTML = rows;
  }

  function openModal(prefill) {
    var modal = document.getElementById('peminjaman-modal');
    var content = document.getElementById('peminjaman-modal-content');
    if (prefill) {
      document.getElementById('input-nama-alat').value = prefill.nama || '';
      document.getElementById('input-kode-alat').value = prefill.kode || '';
    } else {
      document.getElementById('input-nama-alat').value = '';
      document.getElementById('input-kode-alat').value = '';
    }
    document.getElementById('input-lab').value = '';
    document.getElementById('input-jumlah').value = '1';
    document.getElementById('input-tujuan').value = '';
    var tanggalInput = document.getElementById('input-tanggal-pinjam');
    var tanggalKembaliInput = document.getElementById('input-tanggal-kembali');
    var cbToday = document.getElementById('checkbox-pinjam-hari-ini');
    if (tanggalInput) {
      var todayStr = new Date().toISOString().slice(0, 10);
      tanggalInput.value = todayStr;
      tanggalInput.min = todayStr;
      if (cbToday) cbToday.checked = true;
      tanggalInput.disabled = true;
    }
    if (tanggalKembaliInput) {
      var todayStr = new Date().toISOString().slice(0, 10);
      tanggalKembaliInput.value = '';
      tanggalKembaliInput.min = todayStr;
    }
    modal.classList.remove('hidden');
    requestAnimationFrame(function () {
      content.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
      content.classList.add('scale-100', 'opacity-100', 'translate-y-0');
    });
  }

  function closeModal() {
    var modal = document.getElementById('peminjaman-modal');
    var content = document.getElementById('peminjaman-modal-content');
    content.classList.add('scale-95', 'opacity-0', 'translate-y-4');
    content.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
    setTimeout(function () { modal.classList.add('hidden'); }, 200);
  }

  document.addEventListener('DOMContentLoaded', function () {
    var btnClose = document.getElementById('btn-close-peminjaman-modal');
    var overlay = document.getElementById('peminjaman-modal-overlay');

    var form = document.getElementById('peminjaman-form');
    var cbToday = document.getElementById('checkbox-pinjam-hari-ini');
    var tanggalInput = document.getElementById('input-tanggal-pinjam');
    var tanggalKembaliInput = document.getElementById('input-tanggal-kembali');

    if (cbToday && tanggalInput) {
      cbToday.addEventListener('change', function () {
        var todayStr = new Date().toISOString().slice(0, 10);
        if (cbToday.checked) {
          tanggalInput.value = todayStr;
          tanggalInput.disabled = true;
        } else {
          tanggalInput.disabled = false;
          tanggalInput.focus();
        }
        if (tanggalKembaliInput) {
          tanggalKembaliInput.min = tanggalInput.value || todayStr;
          if (tanggalKembaliInput.value && tanggalKembaliInput.value < tanggalKembaliInput.min) {
            tanggalKembaliInput.value = '';
          }
        }
      });
    }
    if (tanggalInput && tanggalKembaliInput) {
      tanggalInput.addEventListener('change', function () {
        tanggalKembaliInput.min = tanggalInput.value || new Date().toISOString().slice(0, 10);
        if (tanggalKembaliInput.value && tanggalKembaliInput.value < tanggalKembaliInput.min) {
          tanggalKembaliInput.value = '';
        }
      });
    }
    if (btnClose) btnClose.addEventListener('click', closeModal);
    if (overlay) overlay.addEventListener('click', closeModal);

    // Auto-open modal if navigated from Alat with prefill
    <% if (typeof openModal !== 'undefined' && openModal) { %>
    openModal({ kode: <%- JSON.stringify(prefillKode || '') %>, nama: <%- JSON.stringify(prefillNama || '') %> });
    <% } %>

    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var tanggalVal = (document.getElementById('input-tanggal-pinjam').value || '').trim();
        var tanggalKembaliVal = (document.getElementById('input-tanggal-kembali').value || '').trim();
        var item = {
          kode: generateCode(),
          kodeAlat: (document.getElementById('input-kode-alat').value || '').trim(),
          namaAlat: (document.getElementById('input-nama-alat').value || '').trim(),
          lab: document.getElementById('input-lab').value || '',
          jadwal: tanggalVal,
          tanggalKembali: tanggalKembaliVal,
          jumlah: parseInt(document.getElementById('input-jumlah').value || '1', 10) || 1,
          tujuan: (document.getElementById('input-tujuan').value || '').trim(),
          status: 'Menunggu Persetujuan',
          peminjam: 'Peminjam',
          email: '',
          createdAt: new Date().toISOString()
        };
        if (!item.kodeAlat || !item.namaAlat || !item.lab || !item.jadwal || !item.tanggalKembali || !item.tujuan) {
          alert('Mohon lengkapi semua field yang wajib diisi.');
          return;
        }
        if (item.tanggalKembali < item.jadwal) {
          alert('Tanggal pengembalian tidak boleh sebelum tanggal peminjaman.');
          return;
        }
        var list = getStoredBorrowings();
        list.unshift(item);
        setStoredBorrowings(list);
        closeModal();
        renderTable();
      });
    }

    var searchInput = document.getElementById('search-peminjam');
    var statusFilter = document.getElementById('filter-status-peminjam');
    var labFilter = document.getElementById('filter-lab-peminjam');
    if (searchInput) searchInput.addEventListener('input', renderTable);
    if (statusFilter) statusFilter.addEventListener('change', renderTable);
    if (labFilter) labFilter.addEventListener('change', renderTable);

    renderTable();
  });
})();
</script>