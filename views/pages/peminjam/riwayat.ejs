<!-- Header Section -->
<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <span class="text-xs font-semibold text-brand-700 tracking-wider uppercase">Sistem Peminjaman Alat</span>
    </div>
    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Peminjaman Alat</h1>
    <p class="text-sm text-slate-500 mt-1">Lihat status permohonan peminjaman dan alat yang telah dipinjam.</p>
  </div>
  <button class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold shadow-sm transition-colors" id="btn-open-peminjaman" type="button">
    <span class="material-symbols-outlined text-[18px]">add_circle</span>
    <span>Ajukan Peminjaman</span>
  </button>
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-5" id="peminjam-stats">
  <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
    <div class="flex items-center justify-between mb-3">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-blue-50 text-brand-700">Menunggu Persetujuan</span>
      <span class="material-symbols-outlined text-[20px] text-slate-300">schedule</span>
    </div>
    <div class="my-2">
      <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-pending"><%= stats.pending %></div>
      <div class="text-xs font-medium text-slate-400 mt-1">Permohonan menunggu verifikasi</div>
    </div>
  </div>
  <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
    <div class="flex items-center justify-between mb-3">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-50 text-emerald-700">Disetujui</span>
      <span class="material-symbols-outlined text-[20px] text-slate-300">check_circle</span>
    </div>
    <div class="my-2">
      <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-approved"><%= stats.approved %></div>
      <div class="text-xs font-medium text-slate-400 mt-1">Permohonan telah disetujui</div>
    </div>
  </div>
  <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
    <div class="flex items-center justify-between mb-3">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-rose-50 text-rose-700">Ditolak</span>
      <span class="material-symbols-outlined text-[20px] text-slate-300">close</span>
    </div>
    <div class="my-2">
      <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-rejected"><%= stats.rejected %></div>
      <div class="text-xs font-medium text-slate-400 mt-1">Permohonan ditolak</div>
    </div>
  </div>
</div>

<!-- Search & Filter Toolbar -->
<div class="rounded-xl p-4 mb-5 bg-white border border-slate-200 shadow-sm">
  <div class="flex flex-col lg:flex-row gap-3 items-stretch md:items-center justify-between">
    <div class="relative flex-1">
      <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none select-none">search</span>
      <input id="search-peminjam" class="w-full pl-10 pr-4 h-10 border border-slate-200 text-slate-700 text-sm rounded-lg placeholder-slate-400 focus:outline-none focus:bg-white focus:border-brand-700 transition-colors bg-white" placeholder="Cari kode pinjam, nama alat, atau nama peminjam..." type="text">
    </div>
    <div class="flex flex-col sm:flex-row items-center gap-3">
      <div class="relative w-full sm:w-auto min-w-[210px]">
        <select id="filter-status-peminjam" class="w-full h-10 appearance-none pl-3.5 pr-9 bg-white border border-slate-200 text-slate-700 text-sm rounded-lg cursor-pointer focus:outline-none focus:border-brand-700 transition-colors">
          <option value="">Semua Status</option>
          <option value="Menunggu Persetujuan">Menunggu Persetujuan</option>
          <option value="Disetujui">Disetujui</option>
          <option value="Dipinjam">Dipinjam</option>
          <option value="Ditolak">Ditolak</option>
          <option value="Selesai">Selesai</option>
          <option value="Dibatalkan">Dibatalkan</option>
        </select>
        <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>
      </div>
      <div class="relative w-full sm:w-auto min-w-[190px]">
        <select id="filter-lab-peminjam" class="w-full h-10 appearance-none pl-3.5 pr-9 bg-white border border-slate-200 text-slate-700 text-sm rounded-lg cursor-pointer focus:outline-none focus:border-brand-700 transition-colors">
          <option value="">Semua Laboratorium</option>
          <% var labNames = items.map(function (row) { return row.nama_lab; }).filter(function (value, index, list) { return value && list.indexOf(value) === index; }); %>
          <% labNames.forEach(function (lab) { %>
            <option value="<%= lab %>"><%= lab %></option>
          <% }); %>
        </select>
        <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>
      </div>
    </div>
  </div>
</div>

<!-- Data Table Container -->
<div class="bg-white rounded-xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col">
  <div class="w-full overflow-x-auto overflow-y-auto max-h-[520px]">
    <table class="w-full text-left border-collapse">
      <thead class="sticky top-0 z-10 bg-slate-50 border-b border-slate-200 text-slate-500 uppercase tracking-wider text-[11px] font-semibold">
        <tr>
          <th class="w-12 px-3.5 py-3.5 text-center bg-slate-50 whitespace-nowrap" scope="col">NO</th>
          <th class="min-w-[130px] px-4 py-3.5 bg-slate-50 whitespace-nowrap" scope="col">KODE PINJAM</th>
          <th class="min-w-[200px] px-4 py-3.5 bg-slate-50 whitespace-nowrap" scope="col">PEMINJAM</th>
          <th class="min-w-[220px] px-4 py-3.5 bg-slate-50 whitespace-nowrap" scope="col">ALAT & LAB</th>
          <th class="min-w-[200px] px-4 py-3.5 bg-slate-50 whitespace-nowrap" scope="col">TANGGAL PINJAM / KEMBALI</th>
          <th class="min-w-[160px] px-4 py-3.5 bg-slate-50 whitespace-nowrap" scope="col">TUJUAN</th>
          <th class="min-w-[130px] px-4 py-3.5 bg-slate-50 whitespace-nowrap" scope="col">STATUS</th>
          <th class="w-28 px-4 py-3.5 text-center bg-slate-50 whitespace-nowrap" scope="col">AKSI</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 text-sm bg-white" id="peminjam-table-body">
        <% if (!items.length) { %>
        <tr id="peminjam-empty-state">
          <td colspan="8" class="p-8 text-center text-slate-500">
            <span class="material-symbols-outlined text-[48px] mb-3 block">inbox</span>
            <p class="font-medium">Belum ada permohonan peminjaman</p>
            <p class="text-xs mt-1">Ajukan peminjaman dari halaman Alat atau klik "Ajukan Peminjaman".</p>
          </td>
        </tr>
        <% } else { %>
          <% items.forEach(function (item, idx) { var meta = statusMeta(item.status); var pinjam = formatTanggal(item.tanggal_pinjam); var kembali = formatTanggal(item.tanggal_kembali_rencana); %>
          <tr class="peminjaman-row hover:bg-slate-50/80 transition-colors duration-150"
              data-kode="<%= item.kode_peminjaman %>"
              data-nama="<%= item.nama_lengkap %>"
              data-alat="<%= item.alat_nama || '-' %>"
              data-lab="<%= item.nama_lab || '-' %>"
              data-status="<%= item.status %>">
            <td class="w-12 px-3.5 py-3.5 text-center font-mono text-xs text-slate-400 row-number"><%= String(idx + 1).padStart(2, '0') %></td>
            <td class="px-4 py-3.5 font-mono text-xs font-semibold text-brand-700 whitespace-nowrap"><%= item.kode_peminjaman %></td>
            <td class="px-4 py-3.5">
              <div class="font-medium text-slate-900 whitespace-nowrap"><%= item.nama_lengkap %></div>
              <div class="text-[11px] text-slate-400 mt-0.5 whitespace-nowrap"><%= item.email || '-' %></div>
            </td>
            <td class="px-4 py-3.5">
              <div class="font-medium text-slate-800"><%= item.alat_nama || '-' %></div>
              <div class="text-xs text-slate-400 mt-0.5"><%= item.nama_lab || '-' %> &bull; <%= item.alat_kode || '-' %></div>
            </td>
            <td class="px-4 py-3.5 text-xs font-mono text-slate-700 whitespace-nowrap">
              <div class="text-slate-500">Pinjam</div>
              <div class="font-medium"><%= pinjam.tanggal %></div>
              <div class="text-slate-500 mt-1">Kembali</div>
              <div class="font-medium"><%= kembali.tanggal %></div>
              <div class="text-slate-400 mt-1"><%= item.total_jumlah || 1 %> unit</div>
            </td>
            <td class="px-4 py-3.5">
              <span class="text-xs text-slate-600 line-clamp-2 leading-relaxed"><%= item.tujuan_peminjaman || '-' %></span>
              <% if (item.alasan_penolakan) { %>
              <div class="text-[11px] text-rose-500 mt-1 line-clamp-2">Alasan: <%= item.alasan_penolakan %></div>
              <% } %>
            </td>
            <td class="px-4 py-3.5 whitespace-nowrap">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold <%= meta.badgeClass %>">
                <span class="w-1.5 h-1.5 rounded-full <%= meta.dotClass %>"></span>
                <%= meta.label %>
              </span>
            </td>
            <td class="px-4 py-3.5 text-center">
              <% if (item.status === 'Menunggu Persetujuan') { %>
              <button type="button" class="btn-cancel-peminjaman inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-rose-600 border border-rose-200 bg-white hover:bg-rose-50 text-[11px] font-semibold transition-colors" data-id="<%= item.id %>" data-kode="<%= item.kode_peminjaman %>">
                <span class="material-symbols-outlined text-[15px]">cancel</span>
                Batalkan
              </button>
              <% } else { %>
              <span class="text-xs text-slate-400">-</span>
              <% } %>
            </td>
          </tr>
          <% }); %>
        <% } %>
        <tr id="peminjam-filter-empty" class="hidden">
          <td colspan="8" class="p-8 text-center text-slate-500">
            <span class="material-symbols-outlined text-[48px] mb-3 block">search_off</span>
            <p class="font-medium">Tidak ada data peminjaman</p>
            <p class="text-xs mt-1">Ubah kata kunci atau filter yang dipilih.</p>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- Borrowing Form Modal -->
<div id="peminjaman-modal" class="fixed inset-0 z-[100] hidden">
  <div id="peminjaman-modal-overlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity duration-300"></div>
  <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
    <div id="peminjaman-modal-content" class="w-full max-w-2xl bg-white rounded-2xl shadow-2xl border border-slate-100 flex flex-col overflow-hidden pointer-events-auto transform transition-all duration-300 scale-95 opacity-0 translate-y-4 max-h-[92vh]">
      <div class="px-6 py-5 border-b border-slate-100 flex items-start justify-between bg-white shrink-0 gap-4">
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[22px]">add_circle</span>
          </div>
          <div>
            <h2 class="text-base font-bold text-slate-900 leading-tight">Ajukan Permohonan Peminjaman</h2>
            <p class="text-xs text-slate-500 mt-1">Isi formulir untuk mengajukan permohonan peminjaman alat.</p>
          </div>
        </div>
        <button id="btn-close-peminjaman-modal" type="button" class="p-2 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors shrink-0" aria-label="Tutup modal">
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>
      <form id="peminjaman-form" class="p-6 space-y-5 overflow-y-auto">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5" for="input-alat">Alat <span class="text-rose-500">*</span></label>
          <div class="relative">
            <select id="input-alat" required class="w-full h-11 appearance-none pl-4 pr-10 bg-white border border-slate-200 rounded-xl text-slate-800 text-sm cursor-pointer focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors">
              <option value="">Pilih alat yang tersedia</option>
              <% available.forEach(function (alat) { var stok = Number(alat.stok_tersedia) || 0; %>
              <option value="<%= alat.id %>" data-nama="<%= alat.nama_alat %>" data-kode="<%= alat.kode_alat %>" data-lab="<%= alat.nama_lab || '-' %>" data-stok="<%= stok %>">
                <%= alat.nama_alat %> (<%= alat.kode_alat %>) - <%= alat.nama_lab || '-' %> &middot; <%= stok %> unit
              </option>
              <% }); %>
            </select>
            <span class="material-symbols-outlined pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]">expand_more</span>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Nama Alat</label>
            <input type="text" id="input-nama-alat" readonly class="w-full h-11 px-4 bg-slate-100 border border-slate-200 rounded-xl text-slate-700 text-sm cursor-not-allowed">
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Kode Alat</label>
            <input type="text" id="input-kode-alat" readonly class="w-full h-11 px-4 bg-slate-100 border border-slate-200 rounded-xl text-slate-700 text-sm cursor-not-allowed">
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Laboratorium</label>
          <input type="text" id="input-lab" readonly class="w-full h-11 px-4 bg-slate-100 border border-slate-200 rounded-xl text-slate-700 text-sm cursor-not-allowed">
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Tanggal Peminjaman <span class="text-rose-500">*</span></label>
            <input type="date" id="input-tanggal-pinjam" required class="w-full h-11 px-4 bg-white border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors">
            <label class="mt-2.5 inline-flex items-center gap-2 text-sm text-slate-600 cursor-pointer select-none">
              <input type="checkbox" id="checkbox-pinjam-hari-ini" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
              <span>Pinjam hari ini</span>
            </label>
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Tanggal Pengembalian <span class="text-rose-500">*</span></label>
            <input type="date" id="input-tanggal-kembali" required class="w-full h-11 px-4 bg-white border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors">
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Jumlah <span class="text-rose-500">*</span></label>
          <input type="number" id="input-jumlah" min="1" value="1" required class="w-full h-11 px-4 bg-white border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Tujuan Peminjaman <span class="text-rose-500">*</span></label>
          <textarea id="input-tujuan" rows="3" required class="w-full px-4 py-3 bg-white border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors resize-none placeholder:text-slate-400" placeholder="Contoh: Praktikum Biologi Sel"></textarea>
        </div>
      </form>
      <div class="px-6 pb-6 pt-0 shrink-0">
        <button type="submit" form="peminjaman-form" class="w-full h-11 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold shadow-sm transition-all active:scale-[0.99] disabled:opacity-60 disabled:cursor-not-allowed">
          Ajukan Peminjaman
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  function formatDate(dateStr) {
    if (!dateStr) return '-';
    try {
      var d = new Date(String(dateStr).slice(0, 10) + 'T00:00:00');
      return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
    } catch (e) {
      return dateStr;
    }
  }

  function todayString() {
    return new Date().toISOString().slice(0, 10);
  }

  document.addEventListener('DOMContentLoaded', function () {
    var modal = document.getElementById('peminjaman-modal');
    var content = document.getElementById('peminjaman-modal-content');
    var overlay = document.getElementById('peminjaman-modal-overlay');
    var btnOpen = document.getElementById('btn-open-peminjaman');
    var btnClose = document.getElementById('btn-close-peminjaman-modal');
    var form = document.getElementById('peminjaman-form');
    var alatSelect = document.getElementById('input-alat');
    var inputNama = document.getElementById('input-nama-alat');
    var inputKode = document.getElementById('input-kode-alat');
    var inputLab = document.getElementById('input-lab');
    var inputJumlah = document.getElementById('input-jumlah');
    var inputTujuan = document.getElementById('input-tujuan');
    var tanggalInput = document.getElementById('input-tanggal-pinjam');
    var tanggalKembaliInput = document.getElementById('input-tanggal-kembali');
    var cbToday = document.getElementById('checkbox-pinjam-hari-ini');
    var submitBtn = document.querySelector('button[type="submit"][form="peminjaman-form"]');

    function syncAlat() {
      var option = alatSelect && alatSelect.options[alatSelect.selectedIndex];
      if (!option || !option.value) {
        if (inputNama) inputNama.value = '';
        if (inputKode) inputKode.value = '';
        if (inputLab) inputLab.value = '';
        if (inputJumlah) { inputJumlah.max = ''; inputJumlah.value = '1'; }
        return;
      }
      if (inputNama) inputNama.value = option.dataset.nama || '';
      if (inputKode) inputKode.value = option.dataset.kode || '';
      if (inputLab) inputLab.value = option.dataset.lab || '-';
      var stok = Math.max(1, parseInt(option.dataset.stok || '1', 10) || 1);
      if (inputJumlah) {
        inputJumlah.max = String(stok);
        if (parseInt(inputJumlah.value, 10) > stok) inputJumlah.value = String(stok);
      }
    }

    function resetModal() {
      if (alatSelect) alatSelect.value = '';
      syncAlat();
      if (inputTujuan) inputTujuan.value = '';
      var today = todayString();
      if (tanggalInput) {
        tanggalInput.value = today;
        tanggalInput.min = today;
        tanggalInput.disabled = true;
      }
      if (cbToday) cbToday.checked = true;
      if (tanggalKembaliInput) {
        tanggalKembaliInput.value = '';
        tanggalKembaliInput.min = today;
      }
    }

    function openModal() {
      if (!modal || !content) return;
      resetModal();
      modal.classList.remove('hidden');
      requestAnimationFrame(function () {
        content.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
        content.classList.add('scale-100', 'opacity-100', 'translate-y-0');
      });
    }

    function closeModal() {
      if (!modal || !content) return;
      content.classList.add('scale-95', 'opacity-0', 'translate-y-4');
      content.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
      setTimeout(function () { modal.classList.add('hidden'); }, 200);
    }

    if (btnOpen) btnOpen.addEventListener('click', openModal);
    if (btnClose) btnClose.addEventListener('click', closeModal);
    if (overlay) overlay.addEventListener('click', closeModal);
    if (alatSelect) alatSelect.addEventListener('change', syncAlat);

    if (cbToday && tanggalInput) {
      cbToday.addEventListener('change', function () {
        var today = todayString();
        if (cbToday.checked) {
          tanggalInput.value = today;
          tanggalInput.disabled = true;
        } else {
          tanggalInput.disabled = false;
          tanggalInput.focus();
        }
        if (tanggalKembaliInput) {
          tanggalKembaliInput.min = tanggalInput.value || today;
          if (tanggalKembaliInput.value && tanggalKembaliInput.value < tanggalKembaliInput.min) {
            tanggalKembaliInput.value = '';
          }
        }
      });
    }
    if (tanggalInput && tanggalKembaliInput) {
      tanggalInput.addEventListener('change', function () {
        tanggalKembaliInput.min = tanggalInput.value || todayString();
        if (tanggalKembaliInput.value && tanggalKembaliInput.value < tanggalKembaliInput.min) {
          tanggalKembaliInput.value = '';
        }
      });
    }

    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var payload = {
          alat_id: alatSelect ? alatSelect.value : '',
          tanggal_pinjam: tanggalInput ? tanggalInput.value : '',
          tanggal_kembali: tanggalKembaliInput ? tanggalKembaliInput.value : '',
          jumlah: inputJumlah ? inputJumlah.value : '1',
          tujuan: inputTujuan ? inputTujuan.value.trim() : ''
        };

        if (!payload.alat_id || !payload.tanggal_pinjam || !payload.tanggal_kembali || !payload.tujuan) {
          await window.sipatModal.alert({
            title: 'Data Belum Lengkap',
            subtitle: 'Periksa kembali isian formulir.',
            message: 'Mohon lengkapi semua field yang wajib diisi sebelum mengajukan peminjaman.',
            tone: 'warning'
          });
          return;
        }
        if (payload.tanggal_kembali < payload.tanggal_pinjam) {
          await window.sipatModal.alert({
            title: 'Tanggal Tidak Sesuai',
            subtitle: 'Periksa kembali tanggal peminjaman.',
            message: 'Tanggal pengembalian tidak boleh sebelum tanggal peminjaman.',
            tone: 'warning'
          });
          return;
        }

        var original = submitBtn ? submitBtn.innerHTML : '';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span><span>Mengirim...</span>';
        }

        try {
          var response = await fetch('/peminjam/peminjaman', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(payload)
          });
          var result = await response.json().catch(function () { return {}; });
          if (!response.ok) throw new Error(result.message || 'Gagal mengajukan peminjaman.');

          closeModal();
          await window.sipatModal.alert({
            title: 'Permohonan Berhasil Diajukan',
            subtitle: result.item && result.item.kode_peminjaman ? 'Kode Peminjaman: ' + result.item.kode_peminjaman : 'Menunggu persetujuan petugas.',
            message: (result.message || 'Permohonan peminjaman berhasil diajukan.') + ' Silakan pantau statusnya di halaman Peminjaman.',
            tone: 'success',
            okText: 'Lihat Peminjaman'
          });
          window.location.reload();
        } catch (error) {
          await window.sipatModal.alert({
            title: 'Gagal Mengajukan',
            subtitle: 'Permohonan belum terkirim.',
            message: error.message || 'Terjadi kesalahan. Silakan coba lagi.',
            tone: 'danger'
          });
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = original;
          }
        }
      });
    }

    // Filters
    var searchInput = document.getElementById('search-peminjam');
    var statusFilter = document.getElementById('filter-status-peminjam');
    var labFilter = document.getElementById('filter-lab-peminjam');
    var emptyFilterRow = document.getElementById('peminjam-filter-empty');

    function applyFilters() {
      var rows = Array.prototype.slice.call(document.querySelectorAll('.peminjaman-row'));
      var query = (searchInput && searchInput.value ? searchInput.value : '').trim().toLowerCase();
      var status = statusFilter ? statusFilter.value : '';
      var lab = labFilter ? labFilter.value : '';
      var visible = 0;

      rows.forEach(function (row) {
        var matchesQuery = !query ||
          (row.dataset.kode || '').toLowerCase().indexOf(query) !== -1 ||
          (row.dataset.nama || '').toLowerCase().indexOf(query) !== -1 ||
          (row.dataset.alat || '').toLowerCase().indexOf(query) !== -1;
        var matchesStatus = !status || row.dataset.status === status;
        var matchesLab = !lab || row.dataset.lab === lab;
        var show = matchesQuery && matchesStatus && matchesLab;
        row.classList.toggle('hidden', !show);
        if (show) {
          visible++;
          var number = row.querySelector('.row-number');
          if (number) number.textContent = String(visible).padStart(2, '0');
        }
      });

      if (emptyFilterRow) emptyFilterRow.classList.toggle('hidden', visible !== 0 || rows.length === 0);
    }

    if (searchInput) searchInput.addEventListener('input', applyFilters);
    if (statusFilter) statusFilter.addEventListener('change', applyFilters);
    if (labFilter) labFilter.addEventListener('change', applyFilters);
    applyFilters();

    // Cancel pending request
    document.querySelectorAll('.btn-cancel-peminjaman').forEach(function (button) {
      button.addEventListener('click', async function () {
        var kode = button.dataset.kode || 'ini';
        var confirmed = await window.sipatModal.confirm({
          title: 'Batalkan Permohonan',
          subtitle: 'Kode Peminjaman: ' + kode,
          message: 'Apakah Anda yakin ingin membatalkan permohonan peminjaman ini? Tindakan ini tidak dapat dibatalkan.',
          confirmText: 'Ya, Batalkan',
          cancelText: 'Kembali',
          tone: 'danger'
        });
        if (!confirmed) return;

        button.disabled = true;
        try {
          var response = await fetch('/peminjam/peminjaman/' + button.dataset.id + '/cancel', { method: 'POST' });
          var result = await response.json().catch(function () { return {}; });
          if (!response.ok) throw new Error(result.message || 'Gagal membatalkan peminjaman.');
          await window.sipatModal.alert({
            title: 'Permohonan Dibatalkan',
            subtitle: 'Kode Peminjaman: ' + kode,
            message: result.message || 'Permohonan peminjaman berhasil dibatalkan.',
            tone: 'success',
            okText: 'Tutup'
          });
          window.location.reload();
        } catch (error) {
          button.disabled = false;
          await window.sipatModal.alert({
            title: 'Gagal Membatalkan',
            subtitle: 'Kode Peminjaman: ' + kode,
            message: error.message || 'Terjadi kesalahan. Silakan coba lagi.',
            tone: 'danger'
          });
        }
      });
    });
  });
})();
</script>