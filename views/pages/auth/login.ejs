<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login — SIPAT (Sistem Peminjaman Alat)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          primary: "#1d4ed8",
          "primary-dark": "#1e40af",
          secondary: "#2563eb",
          "surface-bg": "#f8faff",
        },
        fontFamily: {
          sans: ["Manrope", "sans-serif"],
          headline: ["Plus Jakarta Sans", "sans-serif"],
        },
      },
    },
  };
</script>
</head>

<body class="relative flex min-h-screen flex-col items-center justify-between overflow-x-hidden bg-surface-bg px-4 py-8 font-sans text-slate-800 selection:bg-blue-100 selection:text-blue-700">

  <!-- Background grid & glow -->
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:24px_24px] opacity-40"></div>
  <div class="pointer-events-none absolute left-1/2 top-0 -z-10 h-96 w-full max-w-4xl -translate-x-1/2 bg-gradient-to-b from-blue-100/50 via-blue-50/20 to-transparent blur-3xl"></div>

  <!-- Header -->
  <header class="relative z-10 mb-6 w-full">
    <div class="mx-auto flex max-w-md flex-col items-center justify-center text-center">
      <a href="#" class="group inline-flex items-center gap-3">
        <img alt="Logo SIPAT" class="h-10 w-10 rounded-xl object-contain shadow-sm shadow-blue-500/20"
             src="https://lh3.googleusercontent.com/aida-public/AB6AXuDWZ25V6gR0kW7xUu3v2p-NwJIZVODNe_uc0mb0Zgx-_NtNXWgFOmNyH_-yYgB9_UdHDKEzxiJyHZ8wgFJH9QjtvX7laabbcoDNWgViDzNbdb1CfFcmmmODwomU9mf5OeiEyx6wvhG2olNX6IdN3wOCYwmcAbqHoxZFVoabdk4RvMxHrnOP5bWlWiL0e_ySSyHCISm4QyLuDtX7-pLgGi7dGM-CW3Ym-CBhsAP9B7I-IYZqVrqfD_Be1zEaSLkkQ-USWg">
        <div class="flex flex-col text-left">
          <span class="font-headline text-2xl font-extrabold leading-none tracking-tight text-primary">SIPAT</span>
          <span class="mt-1 font-headline text-xs font-semibold tracking-wide text-slate-500">Sistem Peminjaman Alat</span>
        </div>
      </a>
    </div>
  </header>

  <!-- Login card -->
  <main class="relative z-10 my-auto w-full max-w-4xl">
    <div class="flex flex-col overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-xl shadow-slate-200/70 lg:flex-row">

      <!-- Left panel -->
      <div class="relative flex w-full flex-col justify-between overflow-hidden bg-primary p-8 text-white lg:w-5/12">
        <div class="pointer-events-none absolute -right-16 -top-16 h-60 w-60 rounded-full bg-blue-500/40 blur-2xl"></div>
        <div class="pointer-events-none absolute -bottom-12 -left-12 h-64 w-64 rounded-full bg-indigo-500/30 blur-3xl"></div>

        <div class="relative z-10 mb-4 flex items-center justify-between">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-2.5 py-1 font-mono text-[11px] text-emerald-300 backdrop-blur-sm">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            <span>Online</span>
          </div>
        </div>

        <div class="relative z-10 my-auto">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl border border-white/20 bg-white/15 p-2 shadow-sm backdrop-blur-md">
            <img alt="SIPAT Icon" class="h-full w-full object-contain"
                 src="https://lh3.googleusercontent.com/aida-public/AB6AXuDWZ25V6gR0kW7xUu3v2p-NwJIZVODNe_uc0mb0Zgx-_NtNXWgFOmNyH_-yYgB9_UdHDKEzxiJyHZ8wgFJH9QjtvX7laabbcoDNWgViDzNbdb1CfFcmmmODwomU9mf5OeiEyx6wvhG2olNX6IdN3wOCYwmcAbqHoxZFVoabdk4RvMxHrnOP5bWlWiL0e_ySSyHCISm4QyLuDtX7-pLgGi7dGM-CW3Ym-CBhsAP9B7I-IYZqVrqfD_Be1zEaSLkkQ-USWg">
          </div>
          <h2 class="mb-3 font-headline text-2xl font-bold leading-snug tracking-tight text-white">
            Manajemen Inventaris &amp; Fasilitas Alat
          </h2>
          <p class="mb-6 text-xs leading-relaxed text-blue-100/90">
            Sistem integrasi peminjaman instrumen riset, kalibrasi mesin, dan peralatan bengkel teknik dengan verifikasi digital real-time.
          </p>

          <div class="grid grid-cols-2 gap-3 pt-2">
            <div class="rounded-xl border border-white/10 bg-white/10 p-3 backdrop-blur-sm">
              <div class="font-headline text-xl font-bold text-white">98.4%</div>
              <div class="mt-0.5 text-[11px] text-blue-200">Kesiapan Alat Lab</div>
            </div>
            <div class="rounded-xl border border-white/10 bg-white/10 p-3 backdrop-blur-sm">
              <div class="font-headline text-xl font-bold text-white">1,420+</div>
              <div class="mt-0.5 text-[11px] text-blue-200">Total Aset Aktif</div>
            </div>
          </div>
        </div>

        <div class="relative z-10 mt-6 flex items-center gap-2 border-t border-white/10 pt-6 text-xs text-blue-200"></div>
      </div>

      <!-- Right panel: form -->
      <div class="flex w-full flex-col justify-between bg-white p-8 lg:w-7/12 lg:p-10">
        <div>
          <div class="mb-6">
            <div class="mb-1.5 flex items-center gap-2.5">
              <h1 class="font-headline text-xl font-bold text-slate-900">SIPAT — Sistem Peminjaman Alat</h1>
            </div>
            <p class="text-sm text-slate-500">
              Silakan masuk menggunakan akun institusi/lab Anda untuk melanjutkan.
            </p>
          </div>

          <!-- Role switcher -->
          <div class="mb-6">
            <div class="mb-2 flex items-center justify-between">
              <span class="font-headline text-xs font-bold uppercase tracking-wider text-slate-500">Pilih Peran Demo</span>
            </div>
            <div id="roleTabGroup" class="grid grid-cols-3 gap-1.5 rounded-xl border border-slate-200/60 bg-slate-100/80 p-1.5">
              <button type="button" id="roleBtnAdmin" onclick="setDemoRole('admin')"
                      class="rounded-lg bg-primary px-2 py-2 text-center font-headline text-xs font-semibold text-white shadow-sm transition-all duration-150">
                Admin Utama
              </button>
              <button type="button" id="roleBtnPetugas" onclick="setDemoRole('petugas')"
                      class="rounded-lg px-2 py-2 text-center font-headline text-xs font-medium text-slate-600 transition-all duration-150 hover:bg-white hover:text-slate-900">
                Petugas Bengkel
              </button>
              <button type="button" id="roleBtnPeminjam" onclick="setDemoRole('peminjam')"
                      class="rounded-lg px-2 py-2 text-center font-headline text-xs font-medium text-slate-600 transition-all duration-150 hover:bg-white hover:text-slate-900">
                Peminjam (Mhs)
              </button>
            </div>
          </div>

          <form id="loginForm" class="space-y-4" onsubmit="handleLoginSubmit(event)">
            <!-- Username -->
            <div>
              <label for="usernameInput" class="mb-1.5 block font-headline text-xs font-semibold text-slate-700">
                Username / NIP / NIM
              </label>
              <div class="relative flex items-center">
                <span class="material-symbols-outlined pointer-events-none absolute left-3.5 text-[20px] text-slate-400">badge</span>
                <input id="usernameInput" name="username" type="text" required value="admin1"
                       placeholder="Contoh: admin1 atau 21040188"
                       class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 pl-11 pr-4 text-sm text-slate-800 outline-none transition-all focus:border-blue-600 focus:bg-white focus:ring-4 focus:ring-blue-100">
              </div>
            </div>

            <!-- Password -->
            <div>
              <div class="mb-1.5 flex items-center justify-between">
                <label for="passwordInput" class="font-headline text-xs font-semibold text-slate-700">Kata Sandi</label>
                <a href="javascript:void(0)" onclick="notifyPasswordReset()"
                   class="font-headline text-xs font-semibold text-blue-600 transition-colors hover:text-blue-800 hover:underline">
                  Lupa Password?
                </a>
              </div>
              <div class="relative flex items-center">
                <span class="material-symbols-outlined pointer-events-none absolute left-3.5 text-[20px] text-slate-400">lock</span>
                <input id="passwordInput" name="password" type="password" required value="admin123"
                       placeholder="Masukkan kata sandi..."
                       class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 pl-11 pr-11 text-sm text-slate-800 outline-none transition-all focus:border-blue-600 focus:bg-white focus:ring-4 focus:ring-blue-100">
                <button type="button" id="togglePasswordBtn" onclick="togglePasswordVisibility()" aria-label="Toggle kata sandi"
                        class="absolute right-3 flex items-center justify-center rounded-lg p-1.5 text-slate-400 transition-colors hover:text-slate-600">
                  <span id="pwdEyeIcon" class="material-symbols-outlined text-[20px]">visibility</span>
                </button>
              </div>
            </div>

            <!-- Remember me -->
            <div class="flex items-center justify-between pt-1">
              <label class="inline-flex cursor-pointer select-none items-center gap-2">
                <input id="rememberCheck" type="checkbox" checked
                       class="h-4 w-4 cursor-pointer rounded border-slate-300 text-blue-600 accent-blue-600 focus:ring-0">
                <span class="text-xs text-slate-600">Ingat sesi perangkat ini</span>
              </label>
            </div>

            <!-- Submit -->
            <button id="submitLoginBtn" type="submit"
                    class="mt-3 flex h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-primary font-headline text-sm font-semibold text-white shadow-lg shadow-blue-700/20 transition-all hover:bg-primary-dark active:scale-[0.99]">
              <span>Masuk ke Sistem</span>
              <span class="material-symbols-outlined text-[18px]">login</span>
            </button>
          </form>
        </div>

        <div class="mt-8 border-t border-slate-100 pt-4 text-center">
          <p class="text-xs text-slate-400">
            © 2026 SIPAT Bengkel &amp; Lab Rekayasa Industri. All rights reserved.
            <span class="font-mono text-[11px] font-semibold text-slate-500">v0.1</span>
          </p>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="relative z-10 mt-6 w-full">
    <div class="mx-auto flex max-w-md flex-col items-center justify-center gap-2 px-4 text-center text-xs text-slate-400 sm:flex-row">
      <div class="inline-flex items-center gap-2">
        <span>SIPAT Core Engine</span>
        <span class="inline-block h-1 w-1 rounded-full bg-slate-300"></span>
        <span class="font-mono font-semibold text-blue-600">versi aplikasi 0.1</span>
      </div>
    </div>
  </footer>

  <!-- Toast -->
  <div id="toastNotification"
       class="pointer-events-none fixed bottom-6 right-6 z-50 flex w-full max-w-sm translate-y-4 items-start gap-3 rounded-xl border border-l-4 border-slate-100 border-l-primary bg-white p-4 opacity-0 shadow-2xl transition-all duration-300">
    <span id="toastIcon" class="material-symbols-outlined text-[24px] text-primary">info</span>
    <div class="flex-1">
      <h4 id="toastTitle" class="font-headline text-xs font-bold text-slate-900">Informasi Sistem</h4>
      <p id="toastMessage" class="mt-0.5 text-xs text-slate-600">Memproses permintaan Anda...</p>
    </div>
    <button type="button" onclick="hideToast()" class="text-slate-400 hover:text-slate-700">
      <span class="material-symbols-outlined text-[18px]">close</span>
    </button>
  </div>

<script>
  const demoAccounts = {
    admin: {
      user: 'admin1', pass: 'admin123', name: 'Admin Utama Lab',
      desc: 'Role Administrator Terpilih: Akses penuh inventaris, approval, & kalibrasi.'
    },
    petugas: {
      user: 'pet01', pass: 'pet01pass', name: 'Petugas Bengkel',
      desc: 'Role Petugas: Pengembalian, serah terima alat, & log verifikasi fisik.'
    },
    peminjam: {
      user: 'budi_s', pass: 'mhs2026', name: 'Peminjam (Mahasiswa)',
      desc: 'Role Mahasiswa: Pengajuan pinjam instrumen, riwayat, & kuota unit.'
    }
  };

  const TAB_BASE = "rounded-lg px-2 py-2 text-center font-headline text-xs transition-all duration-150 ";
  const TAB_ACTIVE = TAB_BASE + "bg-primary text-white shadow-sm font-semibold";
  const TAB_IDLE = TAB_BASE + "font-medium text-slate-600 hover:bg-white hover:text-slate-900";

  const TOAST_ACCENT = {
    blue:  { border: 'border-l-primary',   text: 'text-primary' },
    green: { border: 'border-l-green-600', text: 'text-green-600' }
  };

  function setDemoRole(roleKey) {
    const account = demoAccounts[roleKey];
    if (!account) return;

    document.getElementById('usernameInput').value = account.user;
    document.getElementById('passwordInput').value = account.pass;

    const tabs = {
      admin: document.getElementById('roleBtnAdmin'),
      petugas: document.getElementById('roleBtnPetugas'),
      peminjam: document.getElementById('roleBtnPeminjam')
    };
    Object.entries(tabs).forEach(([key, btn]) => {
      btn.className = key === roleKey ? TAB_ACTIVE : TAB_IDLE;
    });

    showToast(account.name, account.desc, 'check_circle', 'green');
  }

  function togglePasswordVisibility() {
    const input = document.getElementById('passwordInput');
    const icon = document.getElementById('pwdEyeIcon');
    const hidden = input.type === 'password';
    input.type = hidden ? 'text' : 'password';
    icon.innerText = hidden ? 'visibility_off' : 'visibility';
  }

  function notifyPasswordReset() {
    showToast(
      'Bantuan Sandi Lab',
      'Silakan hubungi Administrator Lab di lab-support@rekayasa.ac.id atau kunjungi Loket Lab Sentral Lt. 2.',
      'help_outline',
      'blue'
    );
  }

  function handleLoginSubmit(e) {
    e.preventDefault();
    const btn = document.getElementById('submitLoginBtn');
    const userVal = document.getElementById('usernameInput').value.trim();

    btn.disabled = true;
    btn.classList.add('opacity-80', 'cursor-wait');
    btn.innerHTML = `<span class="inline-block h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent"></span><span>Memverifikasi Otoritas...</span>`;

    setTimeout(() => {
      btn.disabled = false;
      btn.classList.remove('opacity-80', 'cursor-wait');
      btn.innerHTML = `<span>Masuk ke Sistem</span><span class="material-symbols-outlined text-[18px]">login</span>`;

      showToast(
        'Autentikasi Berhasil',
        `Selamat datang kembali, ${userVal}. Mengarahkan ke Dashboard Operasional...`,
        'verified',
        'green'
      );
    }, 900);
  }

  let toastTimer = null;
  function showToast(title, message, iconName = 'info', accent = 'blue') {
    const toast = document.getElementById('toastNotification');
    const icon = document.getElementById('toastIcon');

    document.getElementById('toastTitle').innerText = title;
    document.getElementById('toastMessage').innerText = message;
    icon.innerText = iconName;

    // Ganti warna aksen lewat class Tailwind (tanpa inline style)
    Object.values(TOAST_ACCENT).forEach(a => {
      toast.classList.remove(a.border);
      icon.classList.remove(a.text);
    });
    toast.classList.add(TOAST_ACCENT[accent].border);
    icon.classList.add(TOAST_ACCENT[accent].text);

    toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
    toast.classList.add('opacity-100', 'translate-y-0');

    clearTimeout(toastTimer);
    toastTimer = setTimeout(hideToast, 4500);
  }

  function hideToast() {
    const toast = document.getElementById('toastNotification');
    toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
    toast.classList.remove('opacity-100', 'translate-y-0');
  }
</script>
</body>
</html>
