<script>
document.addEventListener('DOMContentLoaded', function () {
  const rows = Array.from(document.querySelectorAll('.return-row'));
  const searchInput = document.getElementById('search-pengembalian');
  const labFilter = document.getElementById('filter-lab-pengembalian');
  const statusFilter = document.getElementById('filter-status-pengembalian');
  const emptyRow = document.getElementById('return-empty-row');
  const summary = document.getElementById('return-summary');

  const statDipinjam = document.getElementById('stat-dipinjam');
  const statTerlambat = document.getElementById('stat-terlambat');
  const statSelesai = document.getElementById('stat-selesai');

  const modal = document.getElementById('modal-return');
  const modalContent = document.getElementById('modal-return-content');
  const modalOverlay = document.getElementById('modal-return-overlay');
  const btnCloseModal = document.getElementById('btn-close-return');
  const btnCancelModal = document.getElementById('btn-modal-return-cancel');
  const btnConfirm = document.getElementById('btn-modal-return-confirm');
  const decisionResult = document.getElementById('return-decision-result');
  const checkboxes = Array.from(document.querySelectorAll('.check-fisik'));

  // Confirm modal
  const confirmModal = document.getElementById('modal-confirm-return');
  const confirmModalContent = document.getElementById('modal-confirm-return-content');
  const confirmModalOverlay = document.getElementById('modal-confirm-return-overlay');
  const btnConfirmCancel = document.getElementById('btn-confirm-return-cancel');
  const btnConfirmOk = document.getElementById('btn-confirm-return-ok');
  const confirmOkText = document.getElementById('modal-confirm-return-oktext');

  const toast = document.getElementById('return-toast');
  const toastInner = document.getElementById('return-toast-inner');
  const toastIconWrap = document.getElementById('return-toast-icon-wrap');
  const toastIcon = document.getElementById('return-toast-icon');
  const toastTitle = document.getElementById('return-toast-title');
  const toastMessage = document.getElementById('return-toast-message');
  const btnCloseToast = document.getElementById('btn-close-return-toast');

  let activeRow = null;
  let toastTimer = null;
  let confirmProcessing = false;

  function openConfirmReturnModal() {
    if (!confirmModal || !confirmModalContent) return;
    confirmProcessing = false;
    btnConfirmOk.disabled = false;
    confirmOkText.textContent = 'Ya, Verifikasi';
    confirmModal.classList.remove('hidden');
    requestAnimationFrame(function () {
      confirmModalContent.classList.remove('scale-95', 'opacity-0');
      confirmModalContent.classList.add('scale-100', 'opacity-100');
    });
  }

  function closeConfirmReturnModal() {
    if (!confirmModal || !confirmModalContent) return;
    confirmModalContent.classList.remove('scale-100', 'opacity-100');
    confirmModalContent.classList.add('scale-95', 'opacity-0');
    setTimeout(function () {
      confirmModal.classList.add('hidden');
      confirmProcessing = false;
      btnConfirmOk.disabled = false;
      confirmOkText.textContent = 'Ya, Verifikasi';
    }, 200);
  }

  function statusBadge(status) {
    if (status === 'Selesai') return 'row-status inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200 text-[11px] font-semibold';
    if (status === 'Terlambat') return 'row-status inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-rose-50 text-rose-700 border border-rose-200 text-[11px] font-semibold';
    if (status === 'Menunggu Verifikasi') return 'row-status inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-amber-50 text-amber-700 border border-amber-200 text-[11px] font-semibold';
    return 'row-status inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-blue-50 text-blue-700 border border-blue-200 text-[11px] font-semibold';
  }

  function statusDot(status) {
    if (status === 'Selesai') return 'bg-emerald-500';
    if (status === 'Terlambat') return 'bg-rose-500';
    if (status === 'Menunggu Verifikasi') return 'bg-amber-500';
    return 'bg-blue-500';
  }

  function updateStats() {
    const dipinjam = rows.filter(function (row) {
      return row.dataset.status === 'Dipinjam' || row.dataset.status === 'Terlambat' || row.dataset.status === 'Menunggu Verifikasi';
    }).length;
    const terlambat = rows.filter(function (row) { return row.dataset.status === 'Terlambat'; }).length;
    const selesai = rows.filter(function (row) { return row.dataset.status === 'Selesai'; }).length;

    if (statDipinjam) statDipinjam.textContent = String(dipinjam);
    if (statTerlambat) statTerlambat.textContent = String(terlambat);
    if (statSelesai) statSelesai.textContent = String(selesai);
  }

  function refreshSummary(visibleCount) {
    if (summary) summary.textContent = visibleCount === 0 ? '0' : '1-' + visibleCount;
  }

  function applyFilters() {
    const query = (searchInput && searchInput.value ? searchInput.value : '').trim().toLowerCase();
    const lab = labFilter ? labFilter.value : '';
    const status = statusFilter ? statusFilter.value : '';
    let visibleCount = 0;

    rows.forEach(function (row) {
      const matchesQuery = !query ||
        (row.dataset.nama || '').toLowerCase().indexOf(query) !== -1 ||
        (row.dataset.kode || '').toLowerCase().indexOf(query) !== -1 ||
        (row.dataset.alat || '').toLowerCase().indexOf(query) !== -1;
      const matchesLab = !lab || row.dataset.lab === lab;
      const matchesStatus = !status || row.dataset.status === status;
      const visible = matchesQuery && matchesLab && matchesStatus;

      row.classList.toggle('hidden', !visible);
      if (visible) visibleCount++;
    });

    if (emptyRow) emptyRow.classList.toggle('hidden', visibleCount !== 0);
    refreshSummary(visibleCount);
  }

  function openModal(row) {
    if (!modal || !modalContent || !row) return;
    activeRow = row;

    const name = row.dataset.nama || '-';
    const initials = name.split(' ').filter(Boolean).slice(0, 2).map(function (part) {
      return part.charAt(0);
    }).join('').toUpperCase();

    document.getElementById('modal-return-initials').textContent = initials || 'PM';
    document.getElementById('modal-return-name').textContent = name;
    document.getElementById('modal-return-contact').textContent = (row.dataset.username || '-') + ' \u00b7 ' + (row.dataset.email || '-');
    document.getElementById('modal-return-icon').textContent = row.dataset.icon || 'science';
    document.getElementById('modal-return-item').textContent = row.dataset.alat || '-';
    document.getElementById('modal-return-item-meta').textContent = (row.dataset.kode || '-') + ' \u00b7 ' + (row.dataset.merk || '-');
    document.getElementById('modal-return-lab').textContent = row.dataset.lab || '-';
    document.getElementById('modal-return-borrow-date').textContent = row.dataset.tglpinjam || '-';
    document.getElementById('modal-return-borrow-time').textContent = row.dataset.jamPinjam || '-';
    document.getElementById('modal-return-deadline').textContent = row.dataset.tenggat || '-';
    document.getElementById('modal-return-deadline-time').textContent = row.dataset.jam || '-';

    const late = row.dataset.terlambat || '-';
    const lateEl = document.getElementById('modal-return-late');
    lateEl.textContent = late.indexOf('+') === 0 ? late.replace('+', 'Terlambat ') : 'Tepat waktu';
    lateEl.className = late.indexOf('+') === 0 ? 'text-xs font-semibold text-rose-600 mt-1' : 'text-xs font-semibold text-emerald-600 mt-1';

    const statusEl = document.getElementById('modal-return-status');
    statusEl.textContent = row.dataset.status || '-';
    statusEl.className = row.dataset.status === 'Selesai'
      ? 'text-xs font-semibold text-emerald-600 mt-1'
      : row.dataset.status === 'Terlambat'
        ? 'text-xs font-semibold text-rose-600 mt-1'
        : row.dataset.status === 'Menunggu Verifikasi'
          ? 'text-xs font-semibold text-amber-600 mt-1'
          : 'text-xs font-semibold text-blue-600 mt-1';

    document.getElementById('return-note').value = '';
    decisionResult.classList.add('hidden');
    decisionResult.textContent = '';
    checkboxes.forEach(function (cb) { cb.checked = true; });

    const isDone = row.dataset.status === 'Selesai';
    btnConfirm.disabled = isDone;
    btnConfirm.classList.toggle('opacity-50', isDone);
    btnConfirm.classList.toggle('cursor-not-allowed', isDone);

    modal.classList.remove('hidden');
    void modalContent.offsetWidth;
    modalContent.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
    modalContent.classList.add('scale-100', 'opacity-100', 'translate-y-0');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal || !modalContent) return;
    modalContent.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
    modalContent.classList.add('scale-95', 'opacity-0', 'translate-y-4');
    setTimeout(function () {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  }

  function showToast(type, title, message) {
    if (!toast) return;
    const palette = type === 'reject'
      ? { border: 'border-rose-200', iconWrap: 'bg-rose-50 text-rose-600', icon: 'cancel' }
      : { border: 'border-emerald-200', iconWrap: 'bg-emerald-50 text-emerald-600', icon: 'check_circle' };

    toastInner.className = 'bg-white border ' + palette.border + ' rounded-xl shadow-lg shadow-slate-900/10 p-4 flex items-start gap-3';
    toastIconWrap.className = 'w-9 h-9 rounded-lg ' + palette.iconWrap + ' flex items-center justify-center shrink-0';
    toastIcon.textContent = palette.icon;
    toastTitle.textContent = title;
    toastMessage.textContent = message;

    toast.classList.remove('hidden');
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { toast.classList.add('hidden'); }, 4500);
  }

  function verifyReturn(row) {
    if (!row || row.dataset.status === 'Selesai') return;

    const unchecked = checkboxes.filter(function (cb) { return !cb.checked; }).length;
    if (unchecked > 0) {
      decisionResult.textContent = 'Lengkapi seluruh checklist inspeksi fisik sebelum memverifikasi pengembalian.';
      decisionResult.className = 'text-xs font-semibold rounded-lg px-3.5 py-2.5 bg-amber-50 text-amber-700 border border-amber-200';
      return;
    }

    row.dataset.status = 'Selesai';
    const badge = row.querySelector('.row-status');
    if (badge) {
      badge.className = statusBadge('Selesai');
      badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full ' + statusDot('Selesai') + '"></span> Selesai';
    }

    const lateCell = row.children[5];
    if (lateCell) {
      lateCell.innerHTML = '<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200 text-[11px] font-semibold">' +
        '<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Diverifikasi</span>';
    }

    const actionCell = row.lastElementChild;
    if (actionCell) {
      actionCell.innerHTML = '<div class="inline-flex items-center justify-center gap-1">' +
        '<button type="button" class="btn-detail p-1.5 rounded-lg text-slate-400 hover:text-brand-700 hover:bg-blue-50 transition-colors" title="Lihat Detail">' +
        '<span class="material-symbols-outlined text-[18px]">visibility</span></button></div>';
      bindDetail(actionCell.querySelector('.btn-detail'));
    }

    updateStats();
    applyFilters();
    closeModal();
    showToast('approve', 'Pengembalian Diverifikasi', 'Pengembalian ' + (row.dataset.alat || 'alat') + ' oleh ' + (row.dataset.nama || 'peminjam') + ' telah selesai.');
    activeRow = null;
  }

  function bindDetail(button) {
    if (!button) return;
    button.addEventListener('click', function () {
      openModal(button.closest('.return-row'));
    });
  }

  rows.forEach(function (row) {
    bindDetail(row.querySelector('.btn-detail'));
    const btnTerima = row.querySelector('.btn-terima');
    if (btnTerima) {
      btnTerima.addEventListener('click', function () { openModal(row); });
    }
  });

  if (btnConfirm) {
    btnConfirm.addEventListener('click', function () {
      if (!activeRow || activeRow.dataset.status === 'Selesai') return;
      openConfirmReturnModal();
    });
  }

  if (btnConfirmCancel) {
    btnConfirmCancel.addEventListener('click', function () {
      if (confirmProcessing) return;
      closeConfirmReturnModal();
    });
  }
  if (confirmModalOverlay) {
    confirmModalOverlay.addEventListener('click', function () {
      if (confirmProcessing) return;
      closeConfirmReturnModal();
    });
  }
  if (btnConfirmOk) {
    btnConfirmOk.addEventListener('click', function () {
      if (confirmProcessing) return;
      confirmProcessing = true;
      btnConfirmOk.disabled = true;
      confirmOkText.textContent = 'Memproses...';
      setTimeout(function () {
        verifyReturn(activeRow);
        closeConfirmReturnModal();
      }, 250);
    });
  }
  if (btnCloseModal) btnCloseModal.addEventListener('click', closeModal);
  if (btnCancelModal) btnCancelModal.addEventListener('click', closeModal);
  if (modalOverlay) modalOverlay.addEventListener('click', closeModal);
  if (btnCloseToast) btnCloseToast.addEventListener('click', function () { toast.classList.add('hidden'); });

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') {
      if (confirmModal && !confirmModal.classList.contains('hidden')) {
        if (!confirmProcessing) closeConfirmReturnModal();
        return;
      }
      if (modal && !modal.classList.contains('hidden')) closeModal();
    }
  });

  [searchInput, labFilter, statusFilter].forEach(function (el) {
    if (!el) return;
    el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', applyFilters);
  });

  const btnRefresh = document.getElementById('btn-refresh-pengembalian');
  if (btnRefresh) {
    btnRefresh.addEventListener('click', function () {
      rows.forEach(function (row) { row.classList.remove('hidden'); });
      if (searchInput) searchInput.value = '';
      if (labFilter) labFilter.value = '';
      if (statusFilter) statusFilter.value = '';
      applyFilters();
      showToast('approve', 'Data Diperbarui', 'Daftar pemantauan pengembalian berhasil dimuat ulang.');
    });
  }

  const btnExport = document.getElementById('btn-export-pengembalian');
  if (btnExport) {
    btnExport.addEventListener('click', function () {
      const header = ['No', 'Kode Pinjam', 'Peminjam', 'Username', 'Email', 'Alat', 'Merk', 'Lab', 'Tenggat', 'Jam', 'Keterlambatan', 'Status'];
      const lines = [header.join(',')];

      rows.filter(function (row) { return !row.classList.contains('hidden'); }).forEach(function (row, index) {
        const values = [
          String(index + 1),
          row.dataset.kode || '',
          row.dataset.nama || '',
          row.dataset.username || '',
          row.dataset.email || '',
          row.dataset.alat || '',
          row.dataset.merk || '',
          row.dataset.lab || '',
          row.dataset.tenggat || '',
          row.dataset.jam || '',
          row.dataset.terlambat || '',
          row.dataset.status || ''
        ].map(function (value) { return '"' + String(value).replace(/"/g, '""') + '"'; });
        lines.push(values.join(','));
      });

      const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      const url = URL.createObjectURL(blob);
      link.href = url;
      link.download = 'pemantauan-pengembalian-petugas.csv';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
      showToast('approve', 'Ekspor Berhasil', 'Data pemantauan pengembalian berhasil diunduh sebagai CSV.');
    });
  }

  updateStats();
  applyFilters();
});
</script>