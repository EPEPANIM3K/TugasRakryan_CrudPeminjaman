<script>
document.addEventListener('DOMContentLoaded', function () {
  const jenisSelect = document.getElementById('jenis-laporan');
  const labSelect = document.getElementById('lab-laporan');
  const startInput = document.getElementById('tanggal-mulai');
  const endInput = document.getElementById('tanggal-akhir');
  const btnTerapkan = document.getElementById('btn-terapkan-laporan');
  const btnPrint = document.getElementById('btn-print-laporan');
  const btnExport = document.getElementById('btn-export-laporan');

  const headEl = document.getElementById('preview-head');
  const bodyEl = document.getElementById('preview-body');
  const footEl = document.getElementById('preview-foot');

  const toast = document.getElementById('laporan-toast');
  const toastInner = document.getElementById('laporan-toast-inner');
  const toastIconWrap = document.getElementById('laporan-toast-icon-wrap');
  const toastIcon = document.getElementById('laporan-toast-icon');
  const toastTitle = document.getElementById('laporan-toast-title');
  const toastMessage = document.getElementById('laporan-toast-message');
  const btnCloseToast = document.getElementById('btn-close-laporan-toast');

  const REPORTS = {
    peminjaman: {
      title: 'Laporan Peminjaman Alat',
      codePrefix: 'LAP/PMJ',
      columns: [
        { key: 'kode', label: 'Kode', align: 'left' },
        { key: 'peminjam', label: 'Peminjam', align: 'left' },
        { key: 'alat', label: 'Alat', align: 'left' },
        { key: 'lab', label: 'Laboratorium', align: 'left' },
        { key: 'tanggalPinjam', label: 'Tanggal Pinjam', align: 'left' },
        { key: 'tenggat', label: 'Tenggat Kembali', align: 'left' },
        { key: 'status', label: 'Status', align: 'left' }
      ],
      rows: [
        { kode: 'PJ-2025-0901', peminjam: 'Rina Ayu Lestari', alat: 'Mikroskop Binokuler CX23', lab: 'Lab Biologi', tanggalPinjam: '25 Feb 2025', tenggat: '28 Feb 2025', status: 'Disetujui' },
        { kode: 'PJ-2025-0902', peminjam: 'Fathur Rahman', alat: 'Oscilloscope Digital 100MHz', lab: 'Laboratorium Instrumentasi', tanggalPinjam: '25 Feb 2025', tenggat: '27 Feb 2025', status: 'Disetujui' },
        { kode: 'PJ-2025-0903', peminjam: 'Siti Nurhaliza, S.Si.', alat: 'Spektrofotometer UV-Vis 1800', lab: 'Lab Kimia', tanggalPinjam: '25 Feb 2025', tenggat: '2 Mar 2025', status: 'Disetujui' },
        { kode: 'PJ-2025-0904', peminjam: 'Bima Satria Wicaksono', alat: 'Solder Station Digital', lab: 'Laboratorium Instrumentasi', tanggalPinjam: '26 Feb 2025', tenggat: '2 Mar 2025', status: 'Disetujui' },
        { kode: 'PJ-2025-0905', peminjam: 'Allya Amanda Putri', alat: 'Autoclave Steam Sterilizer', lab: 'Lab Biologi', tanggalPinjam: '26 Feb 2025', tenggat: '27 Feb 2025', status: 'Ditolak' }
      ],
      note: 'Laporan peminjaman memuat seluruh permohonan yang diajukan pada periode terpilih beserta status keputusannya.'
    },
    pengembalian: {
      title: 'Laporan Pengembalian Alat',
      codePrefix: 'LAP/KMB',
      columns: [
        { key: 'kode', label: 'Kode', align: 'left' },
        { key: 'peminjam', label: 'Peminjam', align: 'left' },
        { key: 'alat', label: 'Alat', align: 'left' },
        { key: 'lab', label: 'Laboratorium', align: 'left' },
        { key: 'tenggat', label: 'Tenggat', align: 'left' },
        { key: 'terlambat', label: 'Keterlambatan', align: 'right' },
        { key: 'status', label: 'Status', align: 'left' }
      ],
      rows: [
        { kode: 'PJ-2025-0812', peminjam: 'Rina Ayu Lestari', alat: 'Mikroskop Binokuler CX23', lab: 'Lab Biologi', tenggat: '28 Feb 2025', terlambat: '0 hari', status: 'Dipinjam' },
        { kode: 'PJ-2025-0805', peminjam: 'Fathur Rahman', alat: 'Oscilloscope Digital 100MHz', lab: 'Laboratorium Instrumentasi', tenggat: '20 Feb 2025', terlambat: '+5 hari', status: 'Terlambat' },
        { kode: 'PJ-2025-0818', peminjam: 'Siti Nurhaliza, S.Si.', alat: 'Spektrofotometer UV-Vis 1800', lab: 'Lab Kimia', tenggat: '25 Feb 2025', terlambat: '0 hari', status: 'Selesai' },
        { kode: 'PJ-2025-0791', peminjam: 'Bima Satria Wicaksono', alat: 'Solder Station Digital', lab: 'Laboratorium Instrumentasi', tenggat: '18 Feb 2025', terlambat: '+7 hari', status: 'Terlambat' },
        { kode: 'PJ-2025-0760', peminjam: 'Nadia Puspita', alat: 'Neraca Analitik Digital', lab: 'Lab Kimia', tenggat: '15 Feb 2025', terlambat: '0 hari', status: 'Selesai' }
      ],
      note: 'Laporan pengembalian memuat status serah terima alat serta keterlambatan yang tercatat pada periode terpilih.'
    },
    inventaris: {
      title: 'Laporan Inventaris Alat',
      codePrefix: 'LAP/INV',
      columns: [
        { key: 'kode', label: 'Kode Alat', align: 'left' },
        { key: 'alat', label: 'Nama Alat', align: 'left' },
        { key: 'merk', label: 'Merk', align: 'left' },
        { key: 'lab', label: 'Laboratorium', align: 'left' },
        { key: 'total', label: 'Total Unit', align: 'right' },
        { key: 'dipinjam', label: 'Dipinjam', align: 'right' },
        { key: 'status', label: 'Kondisi', align: 'left' }
      ],
      rows: [
        { kode: 'ALT-0012', alat: 'Mikroskop Binokuler CX23', merk: 'Olympus', lab: 'Lab Biologi', total: '8', dipinjam: '2', status: 'Baik' },
        { kode: 'ALT-0034', alat: 'Oscilloscope Digital 100MHz', merk: 'Tektronix', lab: 'Laboratorium Instrumentasi', total: '6', dipinjam: '1', status: 'Baik' },
        { kode: 'ALT-0021', alat: 'Spektrofotometer UV-Vis 1800', merk: 'Shimadzu', lab: 'Lab Kimia', total: '3', dipinjam: '1', status: 'Baik' },
        { kode: 'ALT-0045', alat: 'Solder Station Digital', merk: 'Hakko', lab: 'Laboratorium Instrumentasi', total: '10', dipinjam: '3', status: 'Baik' },
        { kode: 'ALT-0008', alat: 'Centrifuge Mikro Kecepatan Tinggi', merk: 'Eppendorf', lab: 'Lab Biokimia', total: '2', dipinjam: '1', status: 'Perawatan' }
      ],
      note: 'Laporan inventaris memuat jumlah unit, unit yang sedang dipinjam, dan kondisi alat per laboratorium.'
    }
  };

  let toastTimer = null;

  function showToast(title, message) {
    if (!toast) return;
    toastInner.className = 'bg-white border border-emerald-200 rounded-xl shadow-lg shadow-slate-900/10 p-4 flex items-start gap-3';
    toastIconWrap.className = 'w-9 h-9 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0';
    toastIcon.textContent = 'check_circle';
    toastTitle.textContent = title;
    toastMessage.textContent = message;
    toast.classList.remove('hidden');
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { toast.classList.add('hidden'); }, 4200);
  }

  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];

  function formatDate(value) {
    if (!value) return '-';
    const parts = value.split('-');
    if (parts.length !== 3) return value;
    const day = String(parseInt(parts[2], 10)).padStart(2, '0');
    const month = MONTHS[parseInt(parts[1], 10) - 1] || parts[1];
    return day + ' ' + month + ' ' + parts[0];
  }

  function fullToday() {
    const now = new Date();
    return String(now.getDate()).padStart(2, '0') + ' ' + MONTHS[now.getMonth()] + ' ' + now.getFullYear();
  }

  function statusClass(status) {
    const value = (status || '').toLowerCase();
    if (['disetujui', 'selesai', 'baik'].indexOf(value) !== -1) return 'text-emerald-700 bg-emerald-50 border border-emerald-200';
    if (['ditolak', 'terlambat', 'perawatan'].indexOf(value) !== -1) return 'text-rose-700 bg-rose-50 border border-rose-200';
    return 'text-blue-700 bg-blue-50 border border-blue-200';
  }

  function currentReport() {
    return REPORTS[jenisSelect.value] || REPORTS.peminjaman;
  }

  function filteredRows(report) {
    const lab = labSelect.value;
    if (!lab || lab === 'Semua Laboratorium') return report.rows;
    return report.rows.filter(function (row) { return row.lab === lab; });
  }

  function render() {
    const report = currentReport();
    const rows = filteredRows(report);

    document.getElementById('print-title').textContent = report.title;
    document.getElementById('print-period').textContent = formatDate(startInput.value) + ' \u2013 ' + formatDate(endInput.value);
    document.getElementById('print-lab').textContent = labSelect.value || 'Semua Laboratorium';
    document.getElementById('print-date').textContent = fullToday();

    const period = (startInput.value || '').slice(0, 7).replace('-', '/');
    document.getElementById('print-doc-code').textContent = report.codePrefix + '/' + (period || '2025/02');
    document.getElementById('print-note').textContent = report.note;

    const successKeys = ['Disetujui', 'Selesai', 'Baik'];
    const failKeys = ['Ditolak', 'Terlambat', 'Perawatan'];
    const success = rows.filter(function (row) { return successKeys.indexOf(row.status) !== -1; }).length;
    const failed = rows.filter(function (row) { return failKeys.indexOf(row.status) !== -1; }).length;

    document.getElementById('print-total').textContent = String(rows.length);
    document.getElementById('print-approved').textContent = String(success);
    document.getElementById('print-rejected').textContent = String(failed);

    headEl.innerHTML = report.columns.map(function (column) {
      return '<th class="px-4 py-3 whitespace-nowrap ' + (column.align === 'right' ? 'text-right' : 'text-left') + '">' + column.label.toUpperCase() + '</th>';
    }).join('');

    if (rows.length === 0) {
      bodyEl.innerHTML = '<tr><td colspan="' + report.columns.length + '" class="px-4 py-10 text-center text-slate-500">' +
        'Tidak ada data pada laboratorium dan periode yang dipilih.</td></tr>';
    } else {
      bodyEl.innerHTML = rows.map(function (row, index) {
        return '<tr class="hover:bg-slate-50/70 transition-colors">' + report.columns.map(function (column) {
          const value = row[column.key] || '-';
          if (column.key === 'status') {
            return '<td class="px-4 py-3 whitespace-nowrap"><span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-semibold ' + statusClass(value) + '">' + value + '</span></td>';
          }
          if (column.key === 'kode') {
            return '<td class="px-4 py-3 whitespace-nowrap font-mono text-[11px] font-semibold text-brand-700">' + value + '</td>';
          }
          if (column.align === 'right') {
            return '<td class="px-4 py-3 whitespace-nowrap text-right font-mono">' + value + '</td>';
          }
          return '<td class="px-4 py-3 whitespace-nowrap">' + value + '</td>';
        }).join('') + '</tr>';
      }).join('');
    }

    footEl.innerHTML = '<tr class="border-t-2 border-slate-200 font-semibold text-slate-700">' +
      report.columns.map(function (column, index) {
        if (index === 0) return '<td class="px-4 py-3">Jumlah</td>';
        if (index === report.columns.length - 1) return '<td class="px-4 py-3">' + rows.length + ' data</td>';
        return '<td class="px-4 py-3"></td>';
      }).join('') + '</tr>';

    const peminjamanCount = REPORTS.peminjaman.rows.length;
    const pengembalianCount = REPORTS.pengembalian.rows.length;
    document.getElementById('summary-peminjaman').textContent = String(peminjamanCount * 4 + 4);
    document.getElementById('summary-pengembalian').textContent = String(pengembalianCount * 4 - 1);
    document.getElementById('summary-terlambat').textContent = String(REPORTS.pengembalian.rows.filter(function (row) { return row.status === 'Terlambat'; }).length);
  }

  if (btnTerapkan) {
    btnTerapkan.addEventListener('click', function () {
      if (startInput.value && endInput.value && startInput.value > endInput.value) {
        showToast('Periode Tidak Valid', 'Tanggal mulai tidak boleh melebihi tanggal akhir.');
        return;
      }
      render();
      showToast('Pratinjau Diperbarui', 'Laporan ' + currentReport().title.toLowerCase() + ' berhasil disusun.');
    });
  }

  [jenisSelect, labSelect, startInput, endInput].forEach(function (el) {
    if (!el) return;
    el.addEventListener('change', render);
  });

  if (btnPrint) {
    btnPrint.addEventListener('click', function () {
      render();
      window.print();
    });
  }

  if (btnExport) {
    btnExport.addEventListener('click', function () {
      const report = currentReport();
      const rows = filteredRows(report);
      const lines = [report.columns.map(function (column) { return '"' + column.label + '"'; }).join(',')];

      rows.forEach(function (row) {
        lines.push(report.columns.map(function (column) {
          return '"' + String(row[column.key] || '').replace(/"/g, '""') + '"';
        }).join(','));
      });

      const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      const url = URL.createObjectURL(blob);
      link.href = url;
      link.download = jenisSelect.value + '-laporan-petugas.csv';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
      showToast('Ekspor Berhasil', 'Laporan berhasil diunduh sebagai berkas CSV.');
    });
  }

  if (btnCloseToast) btnCloseToast.addEventListener('click', function () { toast.classList.add('hidden'); });

  render();
});
</script>
