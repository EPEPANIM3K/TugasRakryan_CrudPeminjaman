<!-- Toast -->
<div id="request-toast" class="fixed bottom-6 right-6 z-[110] hidden max-w-sm w-[calc(100%-3rem)] sm:w-auto">
  <div id="request-toast-inner" class="bg-white border border-emerald-200 rounded-xl shadow-lg shadow-slate-900/10 p-4 flex items-start gap-3">
    <div id="request-toast-icon-wrap" class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
      <span id="request-toast-icon" class="material-symbols-outlined text-[20px]">check_circle</span>
    </div>
    <div class="min-w-0">
      <p id="request-toast-title" class="text-sm font-bold text-slate-900">Berhasil</p>
      <p id="request-toast-message" class="text-xs text-slate-500 mt-0.5 leading-relaxed">Permohonan telah diproses.</p>
    </div>
    <button id="btn-close-request-toast" type="button" class="p-1 rounded-md text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors shrink-0" aria-label="Tutup notifikasi">
      <span class="material-symbols-outlined text-[16px]">close</span>
    </button>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const rows = Array.from(document.querySelectorAll('.request-row'));
  const searchInput = document.getElementById('search-peminjaman');
  const labFilter = document.getElementById('filter-lab-peminjaman');
  const statusFilter = document.getElementById('filter-status-peminjaman');
  const emptyRow = document.getElementById('request-empty-row');
  const summary = document.getElementById('request-summary');

  const statPending = document.getElementById('stat-pending');
  const statApproved = document.getElementById('stat-approved');
  const statRejected = document.getElementById('stat-rejected');

  const modal = document.getElementById('modal-request');
  const modalContent = document.getElementById('modal-request-content');
  const modalOverlay = document.getElementById('modal-request-overlay');
  const btnCloseModal = document.getElementById('btn-close-request');
  const btnCancelModal = document.getElementById('btn-modal-cancel');
  const btnModalApprove = document.getElementById('btn-modal-approve');
  const btnModalReject = document.getElementById('btn-modal-reject');
  const decisionResult = document.getElementById('request-decision-result');

  const toast = document.getElementById('request-toast');
  const toastInner = document.getElementById('request-toast-inner');
  const toastIconWrap = document.getElementById('request-toast-icon-wrap');
  const toastIcon = document.getElementById('request-toast-icon');
  const toastTitle = document.getElementById('request-toast-title');
  const toastMessage = document.getElementById('request-toast-message');
  const btnCloseToast = document.getElementById('btn-close-request-toast');

  let activeRow = null;
  let toastTimer = null;

  function statusBadge(status) {
    if (status === 'Disetujui') {
      return 'row-status inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200 text-[11px] font-semibold';
    }
    if (status === 'Ditolak') {
      return 'row-status inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-rose-50 text-rose-700 border border-rose-200 text-[11px] font-semibold';
    }
    return 'row-status inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-amber-50 text-amber-700 border border-amber-200 text-[11px] font-semibold';
  }

  function statusLabel(status) {
    if (status === 'Disetujui') return 'Disetujui';
    if (status === 'Ditolak') return 'Ditolak';
    return 'Menunggu';
  }

  function statusDot(status) {
    if (status === 'Disetujui') return 'bg-emerald-500';
    if (status === 'Ditolak') return 'bg-rose-500';
    return 'bg-amber-500';
  }

  function updateStats() {
    const pending = rows.filter(function (row) { return row.dataset.status === 'Menunggu Persetujuan'; }).length;
    const approvedNow = rows.filter(function (row) { return row.dataset.status === 'Disetujui'; }).length;
    const rejectedNow = rows.filter(function (row) { return row.dataset.status === 'Ditolak'; }).length;

    if (statPending) statPending.textContent = String(pending);
    if (statApproved) statApproved.textContent = String(12 + approvedNow);
    if (statRejected) statRejected.textContent = String(2 + rejectedNow);
  }

  function refreshSummary(visibleCount) {
    if (summary) {
      summary.textContent = visibleCount === 0 ? '0' : '1-' + visibleCount;
    }
  }

  function applyFilters() {
    const query = (searchInput && searchInput.value ? searchInput.value : '').trim().toLowerCase();
    const lab = labFilter ? labFilter.value : '';
    const status = statusFilter ? statusFilter.value : '';
    let visibleCount = 0;

    rows.forEach(function (row) {
      const matchesQuery = !query ||
        (row.dataset.nama || '').toLowerCase().indexOf(query) !== -1 ||
        (row.dataset.kode || '').toLowerCase().indexOf(query) !== -1 ||
        (row.dataset.alat || '').toLowerCase().indexOf(query) !== -1;
      const matchesLab = !lab || row.dataset.lab === lab;
      const matchesStatus = !status || row.dataset.status === status;
      const visible = matchesQuery && matchesLab && matchesStatus;

      row.classList.toggle('hidden', !visible);
      if (visible) visibleCount++;
    });

    if (emptyRow) emptyRow.classList.toggle('hidden', visibleCount !== 0);
    refreshSummary(visibleCount);
  }

  function openModal(row) {
    if (!modal || !modalContent || !row) return;
    activeRow = row;

    const name = row.dataset.nama || '-';
    const username = row.dataset.username || '-';
    const email = row.dataset.email || '-';
    const initials = name.split(' ').filter(Boolean).slice(0, 2).map(function (part) {
      return part.charAt(0);
    }).join('').toUpperCase();

    document.getElementById('modal-request-initials').textContent = initials || 'PM';
    document.getElementById('modal-request-name').textContent = name;
    document.getElementById('modal-request-contact').textContent = username + ' \u00b7 ' + email;
    document.getElementById('modal-request-icon').textContent = row.dataset.icon || 'science';
    document.getElementById('modal-request-item').textContent = row.dataset.alat || '-';
    document.getElementById('modal-request-item-meta').textContent = (row.dataset.kode || '-') + ' \u00b7 ' + (row.dataset.merk || '-');
    document.getElementById('modal-request-lab').textContent = row.dataset.lab || '-';
    document.getElementById('modal-request-date').textContent = row.dataset.jadwal || '-';
    document.getElementById('modal-request-time').textContent = row.dataset.jam || '-';
    document.getElementById('modal-request-duration').textContent = row.dataset.durasi || '-';
    document.getElementById('modal-request-qty').textContent = (row.dataset.jumlah || '1') + ' unit';
    document.getElementById('modal-request-purpose').textContent = row.dataset.tujuan || '-';

    const statusEl = document.getElementById('modal-request-status');
    statusEl.textContent = row.dataset.status === 'Menunggu Persetujuan' ? 'Menunggu' : row.dataset.status;
    statusEl.className = row.dataset.status === 'Disetujui'
      ? 'text-xs font-semibold text-emerald-600 mt-1'
      : row.dataset.status === 'Ditolak'
        ? 'text-xs font-semibold text-rose-600 mt-1'
        : 'text-xs font-semibold text-amber-600 mt-1';

    document.getElementById('request-note').value = '';
    decisionResult.classList.add('hidden');
    decisionResult.textContent = '';

    const isPending = row.dataset.status === 'Menunggu Persetujuan';
    btnModalApprove.disabled = !isPending;
    btnModalReject.disabled = !isPending;
    btnModalApprove.classList.toggle('opacity-50', !isPending);
    btnModalReject.classList.toggle('opacity-50', !isPending);
    btnModalApprove.classList.toggle('cursor-not-allowed', !isPending);
    btnModalReject.classList.toggle('cursor-not-allowed', !isPending);

    modal.classList.remove('hidden');
    void modalContent.offsetWidth;
    modalContent.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
    modalContent.classList.add('scale-100', 'opacity-100', 'translate-y-0');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal || !modalContent) return;
    modalContent.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
    modalContent.classList.add('scale-95', 'opacity-0', 'translate-y-4');
    setTimeout(function () {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  }

  function setRowStatus(row, status) {
    row.dataset.status = status;

    const badge = row.querySelector('.row-status');
    if (badge) {
      badge.className = statusBadge(status);
      badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full ' + statusDot(status) + '"></span> ' + statusLabel(status);
    }

    const actionCell = row.lastElementChild;
    if (actionCell) {
      actionCell.innerHTML =
        '<div class="inline-flex items-center justify-center gap-1">' +
          '<button type="button" class="btn-detail p-1.5 rounded-lg text-slate-400 hover:text-brand-700 hover:bg-blue-50 transition-colors" title="Lihat Detail">' +
            '<span class="material-symbols-outlined text-[18px]">visibility</span>' +
          '</button>' +
        '</div>';
      bindDetailButton(actionCell.querySelector('.btn-detail'));
    }

    updateStats();
    applyFilters();
  }

  function showToast(type, title, message) {
    if (!toast) return;
    const palette = type === 'reject'
      ? { border: 'border-rose-200', iconWrap: 'bg-rose-50 text-rose-600', icon: 'cancel' }
      : { border: 'border-emerald-200', iconWrap: 'bg-emerald-50 text-emerald-600', icon: 'check_circle' };

    toastInner.className = 'bg-white border ' + palette.border + ' rounded-xl shadow-lg shadow-slate-900/10 p-4 flex items-start gap-3';
    toastIconWrap.className = 'w-9 h-9 rounded-lg ' + palette.iconWrap + ' flex items-center justify-center shrink-0';
    toastIcon.textContent = palette.icon;
    toastTitle.textContent = title;
    toastMessage.textContent = message;

    toast.classList.remove('hidden');
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { toast.classList.add('hidden'); }, 4500);
  }

  function decide(row, status) {
    if (!row || row.dataset.status !== 'Menunggu Persetujuan') return;
    const name = row.dataset.nama || 'peminjam';
    const item = row.dataset.alat || 'alat';
    setRowStatus(row, status);
    closeModal();
    if (status === 'Disetujui') {
      showToast('approve', 'Permohonan Disetujui', 'Peminjaman ' + item + ' oleh ' + name + ' telah disetujui.');
    } else {
      showToast('reject', 'Permohonan Ditolak', 'Permohonan ' + name + ' ditolak dan notifikasi telah dikirim.');
    }
    activeRow = null;
  }

  function bindDetailButton(button) {
    if (!button) return;
    button.addEventListener('click', function () {
      openModal(button.closest('.request-row'));
    });
  }

  rows.forEach(function (row) {
    bindDetailButton(row.querySelector('.btn-detail'));

    const approveBtn = row.querySelector('.btn-approve');
    if (approveBtn) {
      approveBtn.addEventListener('click', function () {
        decide(row, 'Disetujui');
      });
    }

    const rejectBtn = row.querySelector('.btn-reject');
    if (rejectBtn) {
      rejectBtn.addEventListener('click', function () {
        decide(row, 'Ditolak');
      });
    }
  });

  if (btnModalApprove) {
    btnModalApprove.addEventListener('click', function () {
      decide(activeRow, 'Disetujui');
    });
  }
  if (btnModalReject) {
    btnModalReject.addEventListener('click', function () {
      decide(activeRow, 'Ditolak');
    });
  }

  if (btnCloseModal) btnCloseModal.addEventListener('click', closeModal);
  if (btnCancelModal) btnCancelModal.addEventListener('click', closeModal);
  if (modalOverlay) modalOverlay.addEventListener('click', closeModal);
  if (btnCloseToast) btnCloseToast.addEventListener('click', function () { toast.classList.add('hidden'); });

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal();
  });

  [searchInput, labFilter, statusFilter].forEach(function (el) {
    if (!el) return;
    el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', applyFilters);
  });

  const btnExport = document.getElementById('btn-export-peminjaman');
  if (btnExport) {
    btnExport.addEventListener('click', function () {
      const header = ['No', 'Kode Pinjam', 'Peminjam', 'Username', 'Email', 'Alat', 'Merk', 'Lab', 'Jadwal', 'Jam', 'n', 'Tujuan', 'Status'];
      const lines = [header.join(',')];

      rows.filter(function (row) { return !row.classList.contains('hidden'); }).forEach(function (row, index) {
        const values = [
          String(index + 1),
          row.dataset.kode || '',
          row.dataset.nama || '',
          row.dataset.username || '',
          row.dataset.email || '',
          row.dataset.alat || '',
          row.dataset.merk || '',
          row.dataset.lab || '',
          row.dataset.jadwal || '',
          row.dataset.jam || '',
          row.dataset.durasi || '',
          row.dataset.tujuan || '',
          statusLabel(row.dataset.status)
        ].map(function (value) { return '"' + String(value).replace(/"/g, '""') + '"'; });
        lines.push(values.join(','));
      });

      const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      const url = URL.createObjectURL(blob);
      link.href = url;
      link.download = 'permohonan-peminjaman-petugas.csv';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
      showToast('approve', 'Ekspor Berhasil', 'Daftar permohonan berhasil diunduh sebagai CSV.');
    });
  }

  updateStats();
  applyFilters();
});
</script>