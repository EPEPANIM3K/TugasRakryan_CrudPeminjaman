<!-- Main Content -->
<div class="flex flex-col w-full space-y-6">
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div class="flex flex-col gap-1">
      <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Pemantauan Pengembalian</h1>
      <p class="text-slate-500 text-sm mt-1">Pantau status pengembalian alat lab. Admin hanya memantau, verifikasi dilakukan oleh petugas.</p>
    </div>
  </div>

  <%
    const _items = Array.isArray(items) ? items : [];
    const _stats = stats || { total: 0, pending: 0, verified: 0, rejected: 0 };
    const fmtDate = (v) => {
      if (!v) return '-';
      const d = new Date(v);
      if (Number.isNaN(d.getTime())) return String(v);
      return d.toLocaleDateString('id-ID', { day:'2-digit', month:'short', year:'numeric' });
    };
    const lateInfo = (r) => {
      const due = r.tanggal_kembali_rencana ? new Date(r.tanggal_kembali_rencana) : null;
      const act = r.tanggal_kembali_aktual ? new Date(r.tanggal_kembali_aktual) : null;
      if (!due || !act) return { text: '-', cls: 'text-slate-500' };
      const d0 = new Date(due.getFullYear(), due.getMonth(), due.getDate());
      const a0 = new Date(act.getFullYear(), act.getMonth(), act.getDate());
      const diff = Math.round((a0 - d0) / 86400000);
      if (diff > 0) return { text: diff + ' Hari', cls: 'text-rose-600 font-semibold' };
      return { text: 'Tepat waktu', cls: 'text-slate-500' };
    };
  %>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
    <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Total</p>
      <div class="text-3xl font-extrabold text-slate-900 font-mono"><%= _stats.total || 0 %></div>
    </div>
    <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-amber-600 mb-1">Menunggu</p>
      <div class="text-3xl font-extrabold text-slate-900 font-mono"><%= _stats.pending || 0 %></div>
    </div>
    <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-emerald-600 mb-1">Terverifikasi</p>
      <div class="text-3xl font-extrabold text-slate-900 font-mono"><%= _stats.verified || 0 %></div>
    </div>
    <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-wider text-red-600 mb-1">Ditolak</p>
      <div class="text-3xl font-extrabold text-slate-900 font-mono"><%= _stats.rejected || 0 %></div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-slate-200 flex flex-col overflow-hidden">
    <div class="p-5 border-b border-slate-100 flex flex-col lg:flex-row gap-4 justify-between items-start lg:items-center bg-white">
      <div class="relative w-full lg:w-96 shrink-0">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]">search</span>
        <input id="admin-return-search" class="w-full pl-10 pr-4 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-900 focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 transition-all placeholder:text-slate-400" placeholder="Cari peminjam, alat, atau kode..." type="text"/>
      </div>
      <select id="admin-filter-status" class="w-full sm:w-52 pl-3 pr-10 py-2 bg-white border border-slate-200 rounded-lg text-sm text-slate-700 focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 transition-all cursor-pointer">
        <option value="">Semua Status</option>
        <option value="Menunggu Verifikasi">Menunggu Verifikasi</option>
        <option value="Terverifikasi">Terverifikasi</option>
        <option value="Ditolak">Ditolak</option>
      </select>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse min-w-[980px]">
        <thead class="bg-slate-50/80 border-b border-slate-200 text-xs font-semibold uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-4 py-3.5 w-14 text-center">No</th>
            <th class="px-4 py-3.5">Peminjam</th>
            <th class="px-4 py-3.5">Alat &amp; Lab</th>
            <th class="px-4 py-3.5">Tgl Aktual</th>
            <th class="px-4 py-3.5">Keterlambatan</th>
            <th class="px-4 py-3.5">Kondisi</th>
            <th class="px-4 py-3.5">Petugas Verifikator</th>
            <th class="px-4 py-3.5">Status</th>
          </tr>
        </thead>
        <tbody id="admin-return-tbody" class="divide-y divide-slate-100 text-sm bg-white">
          <% if (!_items.length) { %>
            <tr><td colspan="8" class="px-4 py-12 text-center text-slate-500">Belum ada data pengembalian.</td></tr>
          <% } %>
          <% _items.forEach((r, idx) => { 
               const late = lateInfo(r);
               const status = r.status_verifikasi || 'Menunggu Verifikasi';
               const badge = status === 'Terverifikasi'
                 ? 'bg-emerald-50 text-emerald-700 border-emerald-100'
                 : status === 'Ditolak'
                   ? 'bg-red-50 text-red-700 border-red-100'
                   : 'bg-amber-50 text-amber-700 border-amber-100';
               const dot = status === 'Terverifikasi' ? 'bg-emerald-500' : status === 'Ditolak' ? 'bg-red-500' : 'bg-amber-500';
          %>
            <tr class="admin-return-row hover:bg-slate-50/80 transition-colors"
                data-search="<%= [r.kode_peminjaman, r.nama_lengkap, r.username, r.nama_alat, r.nama_lab, r.kondisi_fisik, status, r.petugas_nama].filter(Boolean).join(' ').toLowerCase() %>"
                data-status="<%= status %>">
              <td class="px-4 py-3.5 text-center text-slate-500 font-mono text-xs"><%= idx + 1 %></td>
              <td class="px-4 py-3.5">
                <div class="font-semibold text-slate-900"><%= r.nama_lengkap || '-' %></div>
                <div class="text-xs text-slate-500 font-mono mt-0.5"><%= r.kode_peminjaman || '-' %></div>
              </td>
              <td class="px-4 py-3.5">
                <div class="font-medium text-slate-800"><%= r.nama_alat || '-' %></div>
                <div class="text-xs text-slate-500"><%= r.nama_lab || '-' %> · <%= r.jumlah_pinjam || 1 %> unit</div>
              </td>
              <td class="px-4 py-3.5 whitespace-nowrap">
                <div class="font-medium text-slate-800"><%= fmtDate(r.tanggal_kembali_aktual) %></div>
                <div class="text-xs text-slate-400">Jatuh tempo: <%= fmtDate(r.tanggal_kembali_rencana) %></div>
              </td>
              <td class="px-4 py-3.5 whitespace-nowrap <%= late.cls %> text-xs"><%= late.text %></td>
              <td class="px-4 py-3.5 text-slate-700"><%= r.kondisi_fisik || '-' %></td>
              <td class="px-4 py-3.5 text-slate-700"><%= r.petugas_nama || '-' %></td>
              <td class="px-4 py-3.5 whitespace-nowrap">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold border <%= badge %>">
                  <span class="w-1.5 h-1.5 rounded-full <%= dot %>"></span><%= status %>
                </span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="px-5 py-3.5 border-t border-slate-100 bg-slate-50/60 flex items-center justify-between text-xs text-slate-500">
      <span>Menampilkan <span id="admin-return-count" class="font-semibold text-slate-700"><%= _items.length %></span> data</span>
      <span>Mode pantau (read-only)</span>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const rows = Array.from(document.querySelectorAll('.admin-return-row'));
  const searchInput = document.getElementById('admin-return-search');
  const statusFilter = document.getElementById('admin-filter-status');
  const countEl = document.getElementById('admin-return-count');

  function applyFilters() {
    const q = (searchInput?.value || '').toLowerCase().trim();
    const st = statusFilter?.value || '';
    let visible = 0;
    rows.forEach(row => {
      const show = (!q || (row.dataset.search || '').includes(q)) && (!st || row.dataset.status === st);
      row.classList.toggle('hidden', !show);
      if (show) visible++;
    });
    if (countEl) countEl.textContent = String(visible);
  }

  if (searchInput) searchInput.addEventListener('input', applyFilters);
  if (statusFilter) statusFilter.addEventListener('change', applyFilters);
  applyFilters();
});
</script>
