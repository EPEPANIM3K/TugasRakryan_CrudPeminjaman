                </label>
                <label class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 cursor-pointer transition-colors">
                  <input class="export-row-check rounded border-slate-300 text-blue-600 focus:ring-blue-500 w-3.5 h-3.5" type="checkbox"/>
                  <div class="flex-1 min-w-0"><p class="text-xs font-medium text-slate-700 truncate">KB-2025-0425 • Fathur Rahman</p><p class="text-[11px] text-slate-400 font-mono mt-0.5 truncate">Solder Station Digital • Menunggu Cek Teknisi</p></div>
                </label>
                <label class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 cursor-pointer transition-colors">
                  <input class="export-row-check rounded border-slate-300 text-blue-600 focus:ring-blue-500 w-3.5 h-3.5" type="checkbox"/>
                  <div class="flex-1 min-w-0"><p class="text-xs font-medium text-slate-700 truncate">KB-2025-0426 • Dr. Ir. Hendra Wijaya, M.T.</p><p class="text-[11px] text-slate-400 font-mono mt-0.5 truncate">Centrifuge Mikro Kecepatan Tinggi • Selesai &amp; Sah</p></div>
                </label>
              </div>
              <div class="px-3 py-2 bg-slate-50 flex items-center justify-between text-[11px] text-slate-500"><span class="font-mono font-medium text-slate-400">Hal 1 dari 41</span></div>
            </div>
          </div>
        </div>
      </div>
      <div class="px-6 py-4 bg-slate-50/90 border-t border-slate-100 flex items-center justify-end gap-2.5 shrink-0">
        <button class="px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-900 font-semibold text-xs shadow-2xs transition-colors" id="btn-cancel-export" type="button">Batal</button>
        <button class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs shadow-sm shadow-blue-500/25 flex items-center gap-2 transition-all active:scale-[0.99]" type="button"><span class="material-symbols-outlined text-[16px]">file_download</span><span class="">Unduh &amp; Ekspor Sekarang</span></button>
      </div>
