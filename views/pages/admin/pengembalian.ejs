                <label class="flex items-center gap-3 px-3 py-2 rounded-lg bg-blue-50/50 hover:bg-blue-50 cursor-pointer transition-colors">
                  <input checked="" class="export-row-check rounded border-blue-600 text-blue-600 focus:ring-blue-500 w-3.5 h-3.5" type="checkbox"/>
                  <div class="flex-1 min-w-0"><p class="text-xs font-bold text-slate-900 truncate">KB-2025-0423 • Allya Amanda Putri</p><p class="text-[11px] text-slate-400 font-mono mt-0.5 truncate">Spektrofotometer UV-Vis 1800 • Denda Penggantian</p></div>
