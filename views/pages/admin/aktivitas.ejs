<script>
document.addEventListener('DOMContentLoaded', function () {
  const textOf = function (el) { return el ? (el.textContent || '').replace(/\s+/g, ' ').trim() : ''; };

  document.querySelectorAll('button[title="Lihat Detail Log"]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const row = btn.closest('tr');
      if (!row) return;
      const cells = row.children;
      const identityCell = cells[2];
      const dateCell = cells[5];
      const spans = identityCell ? identityCell.querySelectorAll('span') : [];
      const dateParts = dateCell ? dateCell.querySelectorAll('div') : [];
      const logId = btn.getAttribute('data-log-id') || textOf(cells[1]) || 'N/A';
      const waktu = textOf(dateParts[0]) + (textOf(dateParts[1]) ? ' • ' + textOf(dateParts[1]) : '');

      window.sipatModal.info({
        title: 'Detail Log Aktivitas',
        subtitle: 'Log #' + logId,
        tone: 'info',
        message: window.sipatModal.detailList([
          { label: 'ID Log', value: logId, mono: true },
          { label: 'Nama Pengguna', value: textOf(spans[0]) },
          { label: 'Username / Email', value: textOf(spans[1]), mono: true },
          { label: 'Role Akses', value: textOf(cells[3]) },
          { label: 'Aktivitas', value: textOf(cells[4]) },
          { label: 'Waktu', value: waktu }
        ])
      });
    });
  });
});
</script>

