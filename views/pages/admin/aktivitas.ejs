<script>
document.addEventListener('DOMContentLoaded', function() {
  const exportModal = document.getElementById('modal-export');
  const exportModalOverlay = document.getElementById('modal-export-overlay');
  const exportModalContent = document.getElementById('modal-export-content');
  const btnOpenExport = document.getElementById('btn-open-export');
  const btnCloseExport = document.getElementById('btn-close-export');
  const btnCancelExport = document.getElementById('btn-cancel-export');
  function openExportModal(){ if(!exportModal||!exportModalContent)return; exportModal.classList.remove('hidden'); void exportModalContent.offsetWidth; exportModalContent.classList.remove('scale-95','opacity-0','translate-y-4'); exportModalContent.classList.add('scale-100','opacity-100','translate-y-0'); document.body.style.overflow='hidden'; }
  function closeExportModal(){ if(!exportModal||!exportModalContent)return; exportModalContent.classList.remove('scale-100','opacity-100','translate-y-0'); exportModalContent.classList.add('scale-95','opacity-0','translate-y-4'); setTimeout(()=>{exportModal.classList.add('hidden');document.body.style.overflow='';},300); }
  if(btnOpenExport) btnOpenExport.addEventListener('click', function(e){e.preventDefault();openExportModal();});
  if(btnCloseExport) btnCloseExport.addEventListener('click', closeExportModal);
  if(btnCancelExport) btnCancelExport.addEventListener('click', closeExportModal);
  if(exportModalOverlay) exportModalOverlay.addEventListener('click', closeExportModal);
  document.addEventListener('keydown', function(e){ if(e.key==='Escape'&&exportModal&&!exportModal.classList.contains('hidden')) closeExportModal(); });
  document.querySelectorAll('.export-format-option').forEach(function(option){ const radio=option.querySelector('input[type="radio"]'); if(radio) radio.addEventListener('change', function(){ document.querySelectorAll('.export-format-option').forEach(function(opt){opt.classList.remove('border-2','border-blue-600','bg-blue-50/40','shadow-xs');opt.classList.add('border','border-slate-200','bg-white');}); option.classList.remove('border','border-slate-200','bg-white'); option.classList.add('border-2','border-blue-600','bg-blue-50/40','shadow-xs'); }); });
  const btnToggleExportScope=document.getElementById('btn-toggle-export-scope'); const exportScopeDropdown=document.getElementById('export-scope-dropdown'); const exportScopeArrow=document.getElementById('export-scope-arrow');
  if(btnToggleExportScope&&exportScopeDropdown) btnToggleExportScope.addEventListener('click', function(){ const isHidden=exportScopeDropdown.classList.toggle('hidden'); if(exportScopeArrow) exportScopeArrow.textContent=isHidden?'keyboard_arrow_down':'keyboard_arrow_up'; });
  const exportSelectAll=document.getElementById('export-select-all'); const exportRowChecks=document.querySelectorAll('.export-row-check'); const exportResetSelection=document.getElementById('export-reset-selection');
  if(exportSelectAll) exportSelectAll.addEventListener('change', function(){ exportRowChecks.forEach(function(cb){cb.checked=exportSelectAll.checked;}); });
  if(exportResetSelection) exportResetSelection.addEventListener('click', function(){ exportRowChecks.forEach(function(cb){cb.checked=false;}); if(exportSelectAll) exportSelectAll.checked=false; });
});
</script>
