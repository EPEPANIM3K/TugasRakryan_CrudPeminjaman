<!-- Main Content -->
<div class="flex flex-col w-full space-y-6">
  <!-- Page Header & Action Bar -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-semibold text-brand-700 tracking-wider uppercase">Audit Trail &amp; Log Sistem</span>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Log Aktivitas</h1>
      <p class="text-sm text-slate-500 mt-1">Catatan riwayat seluruh aktivitas pengguna, transaksi peminjaman, autentikasi sesi, dan manajemen inventaris laboratorium secara real-time.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2.5 shrink-0">
      <button class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 text-sm font-semibold transition-colors shadow-sm" id="btn-open-export" type="button">
        <span class="material-symbols-outlined text-[18px] text-slate-500">file_download</span>
        <span class="">Ekspor Log</span>
      </button>
    </div>
  </div>

  <!-- 3 Stat KPI Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <!-- Card 1 -->
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-blue-50 text-brand-700">Total Aktivitas</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight"><%= stats.total %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Tercatat dalam 30 hari terakhir</div>
      </div>
    </div>

    <!-- Card 2 -->
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-50 text-emerald-700">Aktivitas Hari Ini</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight"><%= stats.today %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Transaksi, Autentikasi &amp; Mutasi</div>
      </div>
    </div>

    <!-- Card 3 -->
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-purple-50 text-purple-700">Pengguna Aktif</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight"><%= stats.users %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Pengguna dengan aktivitas tercatat</div>
      </div>
    </div>
  </div>

  <!-- Filter & Search Toolbar Card -->
  <form method="GET" action="/admin/aktivitas" class="rounded-xl flex flex-col lg:flex-row items-center gap-3">
    <!-- Search input -->
    <div class="relative flex-1 w-full">
      <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none select-none">search</span>
      <input name="search" value="<%= filters.search %>" class="w-full pl-10 pr-4 h-10 border border-slate-200 text-slate-700 text-sm rounded-lg placeholder-slate-400 focus:outline-none focus:bg-white focus:border-brand-700 transition-colors bg-white" placeholder="Cari nama pengguna, username, aktivitas, atau detail..." type="text">
    </div>
    <!-- Dropdown Filter 1 -->
    <div class="relative w-full lg:w-60">
      <select name="role" onchange="this.form.submit()" class="w-full h-10 appearance-none pl-3.5 pr-9 bg-white border border-slate-200 text-slate-700 text-sm rounded-lg cursor-pointer focus:outline-none focus:border-brand-700 transition-colors">
        <option value="">Semua Role</option>
        <option value="admin" <%= filters.role === 'admin' ? 'selected' : '' %>>Admin</option>
        <option value="petugas" <%= filters.role === 'petugas' ? 'selected' : '' %>>Petugas</option>
        <option value="user" <%= filters.role === 'user' ? 'selected' : '' %>>User</option>
        <option value="system" <%= filters.role === 'system' ? 'selected' : '' %>>Sistem</option>
      </select>
      <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>
    </div>
    <!-- Dropdown Filter 2 -->
    <div class="relative w-full lg:w-60">
      <select name="modul" onchange="this.form.submit()" class="w-full h-10 appearance-none pl-3.5 pr-9 bg-white border border-slate-200 text-slate-700 text-sm rounded-lg cursor-pointer focus:outline-none focus:border-brand-700 transition-colors">
        <option value="">Semua Modul</option>
        <% (modules || []).forEach(function(modul) { %>
        <option value="<%= modul %>" <%= filters.modul === modul ? 'selected' : '' %>><%= modul %></option>
        <% }); %>
      </select>
      <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>
    </div>
    <% if (filters.search || filters.role || filters.modul) { %>
    <a href="/admin/aktivitas" class="inline-flex items-center gap-1.5 h-10 px-3.5 rounded-lg text-xs font-semibold text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 transition-colors whitespace-nowrap">
      <span class="material-symbols-outlined text-[16px]">filter_alt_off</span>
      Reset
    </a>
    <% } %>
  </form>

  <!-- Data Table Canvas -->
  <div class="bg-white rounded-xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col">
    <div class="w-full overflow-x-auto max-h-[460px] overflow-y-auto">
      <table class="w-full text-left border-collapse">
        <thead class="sticky top-0 z-10 bg-slate-50 border-b border-slate-200 text-slate-500 uppercase tracking-wider text-[11px] font-semibold">
          <tr>
            <th class="py-3.5 px-4 w-12 text-center pl-6 bg-slate-50 whitespace-nowrap">NO</th>
            <th class="py-3.5 px-4 min-w-[140px] bg-slate-50 whitespace-nowrap">KODE AKTIVITAS</th>
            <th class="py-3.5 px-4 min-w-[280px] w-[320px] bg-slate-50 whitespace-nowrap">PENGGUNA</th>
            <th class="py-3.5 px-4 min-w-[120px] bg-slate-50 whitespace-nowrap">ROLE</th>
            <th class="py-3.5 px-4 min-w-[240px] bg-slate-50 whitespace-nowrap">AKTIVITAS</th>
            <th class="py-3.5 px-4 min-w-[140px] bg-slate-50 whitespace-nowrap">WAKTU</th>
            <th class="py-3.5 px-4 text-center min-w-[90px] w-24 pr-6 bg-slate-50 whitespace-nowrap">AKSI</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm text-slate-700 bg-white">
          <% if (!logs.length) { %>
          <tr>
            <td colspan="7" class="px-4 py-12 text-center text-sm text-slate-400">
              <span class="material-symbols-outlined text-[40px] mb-2 block">history</span>
              Belum ada log aktivitas yang cocok.
            </td>
          </tr>
          <% } %>
          <% logs.forEach(function(log, idx) { var waktu = formatTanggal(log.created_at); var identitas = log.username ? '@' + log.username + ' \u2022 ' + (log.email || '-') : 'Sistem'; %>
          <tr class="log-row hover:bg-slate-50/80 transition-colors group"
              data-kode="LOG-<%= String(log.id).padStart(6, '0') %>"
              data-nama="<%= (log.nama_lengkap || 'Sistem').replace(/"/g,'&quot;') %>"
              data-identity="<%= identitas.replace(/"/g,'&quot;') %>"
              data-role="<%= roleLabel(log.role) %>"
              data-aksi="<%= (log.aksi || '-').replace(/"/g,'&quot;') %>"
              data-modul="<%= (log.modul || '-').replace(/"/g,'&quot;') %>"
              data-deskripsi="<%= (log.deskripsi || '-').replace(/"/g,'&quot;') %>"
              data-referensi="<%= ((log.referensi_tipe || '-') + (log.referensi_id ? ' #' + log.referensi_id : '')).replace(/"/g,'&quot;') %>"
              data-ip="<%= (log.ip_address || '-').replace(/"/g,'&quot;') %>"
              data-waktu="<%= (waktu.tanggal + (waktu.jam ? ' \u2022 ' + waktu.jam : '')).replace(/"/g,'&quot;') %>">
            <td class="py-3.5 px-4 text-center text-slate-400 font-mono text-xs pl-6"><%= String(idx + 1).padStart(2, '0') %></td>
            <td class="py-3.5 px-4 font-mono font-semibold text-brand-700 text-xs whitespace-nowrap min-w-[140px]">LOG-<%= String(log.id).padStart(6, '0') %></td>
            <td class="py-3.5 px-4 whitespace-nowrap min-w-[280px] w-[320px]">
              <div class="flex flex-col whitespace-nowrap">
                <span class="font-bold text-slate-900 leading-tight whitespace-nowrap"><%= log.nama_lengkap || 'Sistem' %></span>
                <span class="text-[11px] text-slate-400 mt-0.5 whitespace-nowrap"><%= identitas %></span>
              </div>
            </td>
            <td class="py-3.5 px-4 whitespace-nowrap min-w-[120px]">
              <div class="text-xs font-semibold text-slate-700"><%= roleLabel(log.role) %></div>
            </td>
            <td class="py-3.5 px-4 min-w-[240px]">
              <div class="inline-flex items-center gap-2 flex-wrap">
                <span class="text-xs font-semibold text-slate-700"><%= log.aksi %></span>
                <% if (log.modul) { %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-semibold bg-slate-100 text-slate-500"><%= log.modul %></span>
                <% } %>
              </div>
              <% if (log.deskripsi) { %>
              <div class="text-[11px] text-slate-400 mt-0.5 max-w-[360px] truncate" title="<%= log.deskripsi %>"><%= log.deskripsi %></div>
              <% } %>
            </td>
            <td class="py-3.5 px-4 text-xs font-mono text-slate-700 whitespace-nowrap min-w-[140px]">
              <div class="font-medium"><%= waktu.tanggal %></div>
              <div class="text-slate-400"><%= waktu.jam || '-' %></div>
            </td>
            <td class="py-3.5 px-4 text-center pr-6 whitespace-nowrap min-w-[90px] w-24">
              <div class="inline-flex items-center justify-center gap-1">
                <button class="p-1.5 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-brand-700 transition-colors btn-detail-log" title="Lihat Detail Log" type="button">
                  <span class="material-symbols-outlined text-[18px]">visibility</span>
                </button>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <!-- Pagination & Summary Footer Outside Scroll Area -->
    <div class="px-6 py-4 bg-white border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4 shrink-0">
      <div class="text-xs text-slate-500">
        Menampilkan <span class="font-semibold text-slate-800 font-mono"><%= logs.length ? '1-' + logs.length : '0' %></span> dari <span class="font-semibold text-slate-800 font-mono"><%= logs.length %></span> log aktivitas
      </div>
      <div class="text-xs text-slate-400">Menampilkan maksimal 300 log terbaru.</div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var modalApi = window.sipatModal;

  // Detail log
  document.querySelectorAll('.btn-detail-log').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var row = btn.closest('.log-row');
      if (!row || !modalApi || typeof modalApi.info !== 'function') return;
      var d = row.dataset;

      var fields = [
        { label: 'ID Log', value: d.kode, mono: true },
        { label: 'Nama Pengguna', value: d.nama },
        { label: 'Username / Email', value: d.identity, mono: true },
        { label: 'Role Akses', value: d.role },
        { label: 'Aktivitas', value: d.aksi },
        { label: 'Modul', value: d.modul },
        { label: 'Deskripsi', value: d.deskripsi },
        { label: 'Referensi', value: d.referensi, mono: true },
        { label: 'Alamat IP', value: d.ip, mono: true },
        { label: 'Waktu', value: d.waktu }
      ];

      modalApi.info({
        title: 'Detail Log Aktivitas',
        subtitle: 'Log #' + d.kode,
        tone: 'info',
        message: typeof modalApi.detailList === 'function'
          ? modalApi.detailList(fields)
          : fields.map(function (f) { return '<div><strong>' + f.label + ':</strong> ' + f.value + '</div>'; }).join('')
      });
    });
  });

  // Export visible logs to CSV
  var btnExport = document.getElementById('btn-open-export');
  if (btnExport) {
    btnExport.addEventListener('click', function () {
      var rows = Array.prototype.slice.call(document.querySelectorAll('.log-row'));
      if (!rows.length) {
        if (modalApi && modalApi.toast) modalApi.toast('Tidak ada log untuk diekspor.', 'danger');
        return;
      }

      var header = ['Kode', 'Pengguna', 'Username / Email', 'Role', 'Aktivitas', 'Modul', 'Deskripsi', 'Referensi', 'IP', 'Waktu'];
      var csv = [header.join(';')];

      rows.forEach(function (row) {
        var d = row.dataset;
        var values = [d.kode, d.nama, d.identity, d.role, d.aksi, d.modul, d.deskripsi, d.referensi, d.ip, d.waktu];
        csv.push(values.map(function (value) {
          return '"' + String(value == null ? '' : value).replace(/"/g, '""') + '"';
        }).join(';'));
      });

      var blob = new Blob(['\uFEFF' + csv.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
      var link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = 'log-aktivitas-' + new Date().toISOString().slice(0, 10) + '.csv';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(link.href);

      if (modalApi && modalApi.toast) modalApi.toast('Log aktivitas berhasil diekspor.', 'success');
    });
  }
});
</script>