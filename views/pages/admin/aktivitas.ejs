        </button>
      </div>
      <div class="p-6 space-y-5 max-h-[72vh] overflow-y-auto">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2.5">Format Berkas Ekspor</label>
          <div class="grid grid-cols-3 gap-2.5" id="export-format-group">
