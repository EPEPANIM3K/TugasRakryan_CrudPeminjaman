<div id="modal-export" class="fixed inset-0 z-[100] hidden">
  <div id="modal-export-overlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity duration-300"></div>
  <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
    <div id="modal-export-content" class="bg-white rounded-2xl shadow-2xl max-w-lg w-full border border-slate-100 overflow-hidden flex flex-col transition-all pointer-events-auto transform duration-300 scale-95 opacity-0 translate-y-4">
      <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between bg-white shrink-0">
        <div class="flex items-center gap-3.5">
          <div>
            <h3 class="text-base font-bold text-slate-900 leading-tight">Ekspor Log Aktivitas</h3>
            <p class="text-xs text-slate-500 mt-0.5 leading-normal">Pilih format berkas dan parameter log aktivitas yang ingin diunduh.</p>
          </div>
        </div>
        <button aria-label="Tutup Modal" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors ml-2" id="btn-close-export" type="button">
