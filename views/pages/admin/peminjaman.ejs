<!-- Script Interaksi Peminjaman -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  const wait = function (ms) { return new Promise(function (resolve) { setTimeout(resolve, ms); }); };
  const textOf = function (el) { return el ? (el.textContent || '').replace(/\s+/g, ' ').trim() : ''; };
  const modalApi = window.sipatModal;

  function showModal(modal, content) {
    if (!modal || !content) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    void content.offsetWidth;
    content.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
    content.classList.add('scale-100', 'opacity-100', 'translate-y-0');
    document.body.style.overflow = 'hidden';
  }

  function hideModal(modal, content) {
    if (!modal || !content) return;
    content.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
    content.classList.add('scale-95', 'opacity-0', 'translate-y-4');
    setTimeout(function () {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      if (!document.querySelector('[data-sipat-modal]:not(.hidden)')) document.body.style.overflow = '';
    }, 220);
  }

  // Export modal
  const exportModal = document.getElementById('export-modal');
  const exportContent = exportModal ? exportModal.querySelector('.relative') : null;
  const btnOpenExport = document.getElementById('btn-open-export');
  const btnCloseExport = document.getElementById('btn-close-export-modal');
  const btnCancelExport = exportModal ? exportModal.querySelector('.bg-white.text-slate-600') : null;

  if (btnOpenExport) btnOpenExport.addEventListener('click', function (e) {
    e.preventDefault();
    showModal(exportModal, exportContent);
  });
  if (btnCloseExport) btnCloseExport.addEventListener('click', function () { hideModal(exportModal, exportContent); });
  if (btnCancelExport) btnCancelExport.addEventListener('click', function () { hideModal(exportModal, exportContent); });
  if (exportModal) exportModal.addEventListener('click', function (e) {
    if (e.target === exportModal) hideModal(exportModal, exportContent);
  });

  // Add / edit peminjaman modal
  const pmModal = document.getElementById('modal-peminjaman');
  const pmContent = document.getElementById('modal-peminjaman-content');
  const btnClosePm = document.getElementById('btn-close-modal-peminjaman');
  const btnCancelPm = document.getElementById('btn-cancel-modal-peminjaman');
  const formPm = document.getElementById('form-peminjaman');

  function closePeminjamanModal() { hideModal(pmModal, pmContent); }

  if (btnClosePm) btnClosePm.addEventListener('click', closePeminjamanModal);
  if (btnCancelPm) btnCancelPm.addEventListener('click', closePeminjamanModal);
  if (pmModal) pmModal.addEventListener('click', function (e) {
    if (e.target === pmModal) closePeminjamanModal();
  });

  // Detail modal
  const detailModal = document.getElementById('modal-detail-peminjaman');
  const detailContent = document.getElementById('modal-detail-peminjaman-content');

  function closeDetailModal() { hideModal(detailModal, detailContent); }

  function openDetailModal(data) {
    if (!detailModal || !detailContent) return;
    const set = function (id, value) {
      const el = document.getElementById(id);
      if (el) el.textContent = value || '-';
    };
    set('detail-pm-kode', data.kode);
    set('detail-pm-nama', data.nama);
    set('detail-pm-identity', data.identity);
    set('detail-pm-alat', data.alat);
    set('detail-pm-tglpinjam', data.tglpinjam);
    set('detail-pm-tglkembali', data.tglkembali);
    set('detail-pm-status', data.status);
    showModal(detailModal, detailContent);
  }

  const btnCloseDetail = document.getElementById('btn-close-detail-peminjaman');
  const btnTutupDetail = document.getElementById('btn-tutup-detail-peminjaman');
  if (btnCloseDetail) btnCloseDetail.addEventListener('click', closeDetailModal);
  if (btnTutupDetail) btnTutupDetail.addEventListener('click', closeDetailModal);
  if (detailModal) detailModal.addEventListener('click', function (e) {
    if (e.target === detailModal) closeDetailModal();
  });

  function readRow(row) {
    const cells = row ? row.children : [];
    const identityCell = cells[2];
    const alatCell = cells[3];
    const nameSpans = identityCell ? identityCell.querySelectorAll('span') : [];
    const alatSpans = alatCell ? alatCell.querySelectorAll('span') : [];
    return {
      kode: textOf(cells[1]),
      nama: textOf(nameSpans[0]),
      identity: textOf(nameSpans[1]),
      alat: textOf(alatSpans[0]),
      merek: textOf(alatSpans[1]),
      tglpinjam: textOf(cells[4]),
      tglkembali: textOf(cells[5]),
      status: textOf(cells[6])
    };
  }

  document.querySelectorAll('button[title="Lihat Detail"]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const row = btn.closest('tr');
      const data = readRow(row);
      data.alat = data.alat + (data.merek ? ' (' + data.merek + ')' : '');
      openDetailModal(data);
    });
  });

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    if (exportModal && !exportModal.classList.contains('hidden')) hideModal(exportModal, exportContent);
    if (pmModal && !pmModal.classList.contains('hidden')) closePeminjamanModal();
    if (detailModal && !detailModal.classList.contains('hidden')) closeDetailModal();
  });

  if (formPm) {
    formPm.addEventListener('submit', async function (e) {
      e.preventDefault();
      const submit = document.getElementById('btn-submit-peminjaman');
      const original = submit ? submit.innerHTML : '';
      if (submit) {
        submit.disabled = true;
        submit.innerHTML = '<span class="material-symbols-outlined text-[16px] animate-spin">progress_activity</span><span>Menyimpan...</span>';
      }
      try {
        await wait(600);
        if (modalApi) modalApi.toast('Data peminjaman berhasil disimpan.', 'success');
        closePeminjamanModal();
      } catch (error) {
        if (modalApi) modalApi.toast('Gagal menyimpan data peminjaman. Silakan coba lagi.', 'danger');
      } finally {
        if (submit) { submit.disabled = false; submit.innerHTML = original || 'Simpan'; }
      }
    });
  }

  function renumberRows() {
    const tbody = document.querySelector('table tbody');
    if (!tbody) return;
    Array.prototype.forEach.call(tbody.querySelectorAll('tr'), function (row, index) {
      const first = row.children[0];
      if (first) first.textContent = String(index + 1).padStart(2, '0');
    });
  }

  document.querySelectorAll('button[title="Hapus"]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const row = btn.closest('tr');
      const data = readRow(row);
      window.sipatModal.confirm({
        title: 'Hapus Data Peminjaman?',
        subtitle: 'Tindakan ini tidak dapat dibatalkan.',
        tone: 'danger',
        message: '<div class="text-sm text-slate-700 space-y-2">' +
          '<p>Apakah Anda yakin ingin menghapus transaksi peminjaman berikut?</p>' +
          '<div class="rounded-xl border border-rose-100 bg-rose-50/70 px-4 py-3 space-y-1">' +
          '<p class="text-xs text-slate-500">Kode Peminjaman</p>' +
          '<p class="font-mono font-bold text-rose-700">' + window.sipatModal.escape(data.kode || 'N/A') + '</p>' +
          '<p class="font-semibold text-slate-800 mt-1">' + window.sipatModal.escape(data.nama || 'Peminjam') + '</p>' +
          '<p class="text-xs text-slate-500">' + window.sipatModal.escape(data.alat || 'Alat') + '</p>' +
          '</div></div>',
        confirmText: 'Ya, Hapus',
        confirmClass: 'px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 transition shadow-sm inline-flex items-center justify-center gap-2',
        loadingText: 'Menghapus...',
        onConfirm: async function () {
          await wait(550);
          if (!row || !row.parentNode) throw new Error('Data peminjaman tidak ditemukan atau sudah dihapus.');
          row.style.transition = 'opacity 0.18s ease, transform 0.18s ease';
          row.style.opacity = '0';
          row.style.transform = 'translateY(-4px)';
          await wait(180);
          row.remove();
          renumberRows();
          window.sipatModal.toast('Transaksi ' + (data.kode || '') + ' berhasil dihapus.', 'success');
        }
      });
    });
  });
});
</script>

<!-- Search & Filter Script for Admin Peminjaman -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  var searchInput = document.getElementById('search-peminjaman-admin');
  var filterStatus = document.getElementById('filter-status-admin');

  function normalizeStatus(s) {
    return (s || '').toLowerCase().replace(/\s+/g, ' ').trim();
  }

  function applyFilters() {
    var rows = document.querySelectorAll('#peminjaman-table tbody tr');
    var searchTerm = (searchInput ? searchInput.value : '').toLowerCase().trim();
    var statusValue = normalizeStatus(filterStatus ? filterStatus.value : '');

    rows.forEach(function (row) {
      // Skip empty-state row
      if (row.querySelector('td[colspan]')) { row.style.display = ''; return; }

      var cells = row.querySelectorAll('td');
      var kode = cells[1] ? cells[1].textContent.toLowerCase() : '';
      var nameSpans = cells[2] ? cells[2].querySelectorAll('span') : [];
      var nama = nameSpans[0] ? nameSpans[0].textContent.toLowerCase() : '';
      var identity = nameSpans[1] ? nameSpans[1].textContent.toLowerCase() : '';
      var alatSpans = cells[3] ? cells[3].querySelectorAll('span') : [];
      var alat = alatSpans[0] ? alatSpans[0].textContent.toLowerCase() : '';
      var merk = alatSpans[1] ? alatSpans[1].textContent.toLowerCase() : '';
      var statusText = normalizeStatus(cells[6] ? cells[6].textContent : '');

      var matchesSearch = !searchTerm ||
        kode.indexOf(searchTerm) !== -1 ||
        nama.indexOf(searchTerm) !== -1 ||
        identity.indexOf(searchTerm) !== -1 ||
        alat.indexOf(searchTerm) !== -1 ||
        merk.indexOf(searchTerm) !== -1;

      var matchesStatus = !statusValue || statusText.indexOf(statusValue) !== -1;

      row.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
    });
  }

  if (searchInput) searchInput.addEventListener('input', applyFilters);
  if (filterStatus) filterStatus.addEventListener('change', applyFilters);
  applyFilters();
});
</script>
