  <!-- Modal Tambah/Edit Peminjaman -->
  <div id="modal-peminjaman" class="hidden fixed inset-0 z-50 items-center justify-center px-6 py-8">
    <div id="modal-peminjaman-overlay" class="fixed inset-0 bg-black/40 backdrop-blur-sm"></div>
    <div id="modal-peminjaman-content" class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg transform transition-all duration-300 scale-95 opacity-0 translate-y-4 z-10 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
        <h2 class="text-xl font-bold text-slate-900" id="modal-peminjaman-title">Tambah Peminjaman</h2>
        <button id="btn-close-modal-peminjaman" class="p-2 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors" type="button" aria-label="Tutup">
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
      </div>
      <form id="form-peminjaman" class="p-6 space-y-4">
        <input type="hidden" id="pm-id" value="">
        <div>
          <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="pm-kode">Kode Peminjaman <span class="text-rose-500">*</span></label>
          <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs" id="pm-kode" placeholder="Contoh: PJ-2025-1001" type="text" required>
        </div>
        <div>
          <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="pm-nama">Nama Pelapor <span class="text-rose-500">*</span></label>
          <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs" id="pm-nama" placeholder="Nama lengkap peminjam" type="text" required>
        </div>
        <div>
          <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="pm-username-email">Username & Email <span class="text-slate-400 font-normal">(opsional)</span></label>
          <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs" id="pm-username-email" placeholder="Contoh: bima@mhs.univ.ac.id" type="text">
        </div>
        <div>
          <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="pm-alat">Nama Alat <span class="text-rose-500">*</span></label>
          <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs" id="pm-alat" placeholder="Nama alat" type="text" required>
        </div>
        <div>
          <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="pm-merk">Merk / Keterangan <span class="text-slate-400 font-normal">(opsional)</span></label>
          <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs" id="pm-merk" placeholder="Contoh: Tektronix" type="text">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="pm-tgl-pinjam">Tanggal Pinjam <span class="text-rose-500">*</span></label>
            <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs" id="pm-tgl-pinjam" type="date" required>
