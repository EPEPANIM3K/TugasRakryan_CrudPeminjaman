        <div class="flex justify-between gap-4"><span class="text-slate-500">Kode</span><span class="font-mono font-semibold text-brand-700" id="detail-pm-kode">-</span></div>
        <div class="flex justify-between gap-4"><span class="text-slate-500">Nama Pelapor</span><span class="text-slate-900 text-right" id="detail-pm-nama">-</span></div>
        <div class="flex justify-between gap-4"><span class="text-slate-500">Username / Email</span><span class="text-slate-700 text-right text-xs font-mono" id="detail-pm-identity">-</span></div>
        <div class="flex justify-between gap-4"><span class="text-slate-500">Alat</span><span class="text-slate-900 text-right" id="detail-pm-alat">-</span></div>
        <div class="flex justify-between gap-4"><span class="text-slate-500">Tanggal Pinjam</span><span class="text-slate-700" id="detail-pm-tglpinjam">-</span></div>
        <div class="flex justify-between gap-4"><span class="text-slate-500">Tanggal Kembali</span><span class="text-slate-700" id="detail-pm-tglkembali">-</span></div>
        <div class="flex justify-between gap-4"><span class="text-slate-500">Status</span><span class="text-slate-900 text-right font-semibold" id="detail-pm-status">-</span></div>
