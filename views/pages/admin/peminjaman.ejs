            <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs" id="pm-tgl-kembali" type="date" required>
          </div>
        </div>
        <div>
          <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="pm-status">Status <span class="text-rose-500">*</span></label>
          <select class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs cursor-pointer" id="pm-status" required>
