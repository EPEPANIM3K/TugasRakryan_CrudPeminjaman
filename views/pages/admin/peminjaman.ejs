<!-- Main Content -->
<div class="flex flex-col w-full space-y-6">
  <!-- Header Section -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-semibold text-brand-700 tracking-wider uppercase">Manajemen Transaksi Laboratorium</span>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Kelola Peminjaman</h1>
      <p class="text-sm text-slate-500 mt-1">Daftar seluruh permohonan dan transaksi peminjaman alat laboratorium,<br>verifikasi status, dan pengelolaan peminjaman aktif.</p>
    </div>
    <!-- Action Buttons Right-Aligned -->
    <div class="flex flex-wrap items-center gap-2.5 shrink-0">
      <button class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 text-sm font-semibold transition-colors shadow-sm" id="btn-open-export" type="button">
        <span class="material-symbols-outlined text-[18px] text-slate-500">file_download</span>
        <span class="">Ekspor Excel</span>
      </button>
    </div>
  </div>

  <!-- 3 Stat KPI Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <!-- Card 1: Total Pengajuan -->
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-blue-50 text-brand-700">Total Pengajuan</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-total-pengajuan"><%= stats.totalPengajuan || 0 %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Semua permohonan peminjaman</div>
      </div>
    </div>
    <!-- Card 2: Menunggu Persetujuan -->
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-amber-50 text-amber-700">Menunggu Persetujuan</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-menunggu"><%= stats.menungguPersetujuan || 0 %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Permohonan menunggu verifikasi</div>
      </div>
    </div>
    <!-- Card 3: Disetujui -->
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-50 text-emerald-700">Disetujui</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-disetujui"><%= stats.disetujui || 0 %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Permohonan telah disetujui</div>
      </div>
    </div>
  </div>

  <!-- Filter & Search Toolbar -->
  <div class="rounded-xl flex flex-col lg:flex-row items-center gap-3 mb-5">
    <!-- Search input -->
    <div class="relative flex-1">
      <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none select-none">search</span>
      <input class="w-full pl-10 pr-4 h-10 border border-slate-200 text-slate-700 text-sm rounded-lg placeholder-slate-400 focus:outline-none focus:bg-white focus:border-brand-700 transition-colors bg-white" placeholder="Cari kode pinjam, nama peminjam, atau nama alat..." type="text" id="search-peminjaman-admin">
    </div>
    <div class="flex flex-col lg:flex-row items-center gap-3">
      <div class="relative w-full lg:w-auto min-w-[200px]">
        <select class="w-full h-10 appearance-none pl-3.5 pr-9 bg-white border border-slate-200 text-slate-700 text-sm rounded-lg cursor-pointer focus:outline-none focus:border-brand-700 transition-colors" id="filter-status-admin">
          <option value="">Semua Status</option>
          <% (distinctStatuses || []).forEach(function(status) { %>
            <option value="<%= status %>"><%= status %></option>
          <% }); %>
        </select>
        <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>
      </div>
      <div class="relative w-full lg:w-auto min-w-[180px]">
        <select class="w-full h-10 appearance-none pl-3.5 pr-9 bg-white border border-slate-200 text-slate-700 text-sm rounded-lg cursor-pointer focus:outline-none focus:border-brand-700 transition-colors" id="filter-lab-admin">
          <option value="">Semua Laboratorium</option>
          <% (labs || []).forEach(function(lab) { %>
            <option value="<%= lab %>"><%= lab %></option>
          <% }); %>
        </select>
        <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>
      </div>
    </div>
  </div>

  <!-- Data Table -->
  <div class="bg-white rounded-xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col">
    <div class="w-full overflow-x-auto max-h-[460px] overflow-y-auto">
      <table id="peminjaman-table" class="w-full text-left border-collapse">
        <thead class="sticky top-0 z-10 bg-slate-50 border-b border-slate-200 text-slate-500 uppercase tracking-wider text-[11px] font-semibold">
          <tr>
            <th class="py-3.5 px-4 w-12 text-center pl-6 bg-slate-50 whitespace-nowrap" scope="col">NO</th>
            <th class="py-3.5 px-4 min-w-[140px] bg-slate-50 whitespace-nowrap" scope="col">KODE PEMINJAMAN</th>
            <th class="py-3.5 px-4 min-w-[280px] w-[320px] bg-slate-50 whitespace-nowrap" scope="col">NAMA PELAPOR</th>
            <th class="py-3.5 px-4 min-w-[280px] w-[320px] bg-slate-50 whitespace-nowrap" scope="col">ALAT</th>
            <th class="py-3.5 px-4 min-w-[140px] bg-slate-50 whitespace-nowrap" scope="col">TANGGAL PINJAM</th>
            <th class="py-3.5 px-4 min-w-[140px] bg-slate-50 whitespace-nowrap" scope="col">TANGGAL KEMBALI</th>
            <th class="py-3.5 px-4 min-w-[150px] bg-slate-50 whitespace-nowrap" scope="col">STATUS</th>
            <th class="py-3.5 px-4 text-center min-w-[90px] w-24 pr-6 bg-slate-50 whitespace-nowrap" scope="col">AKSI</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm text-slate-700 bg-white">
          <% if (!tableData.length) { %>
          <tr>
            <td colspan="8" class="px-4 py-12 text-center text-sm text-slate-400">
              <span class="material-symbols-outlined text-[40px] mb-2 block">inbox</span>
              Belum ada data peminjaman.
            </td>
          </tr>
          <% } %>
          <% tableData.forEach(function(item, idx) { var meta = statusMeta(item.status); var deletable = ['Menunggu Persetujuan','Ditolak','Dibatalkan','Selesai'].indexOf(item.status) !== -1; %>
          <tr class="peminjaman-admin-row hover:bg-slate-50/80 transition-colors group"
              data-id="<%= item.id %>"
              data-kode="<%= item.kode_peminjaman || '-' %>"
              data-nama="<%= item.nama_lengkap || '-' %>"
              data-username="@<%= item.username || '-' %>"
              data-email="<%= item.email || '-' %>"
              data-alat="<%= item.alat_nama || '-' %>"
              data-merk="<%= item.alat_merk || '-' %>"
              data-kode-alat="<%= item.alat_kode || '-' %>"
              data-lab="<%= item.nama_lab || '-' %>"
              data-tanggal-pinjam="<%= formatTanggal(item.tanggal_pinjam) %>"
              data-tanggal-kembali="<%= formatTanggal(item.tanggal_kembali_rencana) %>"
              data-status="<%= item.status %>"
              data-tujuan="<%= (item.tujuan_peminjaman || '-').replace(/"/g,'&quot;') %>"
              data-catatan="<%= ((item.catatan_petugas || item.alasan_penolakan || '') + '').replace(/"/g,'&quot;') %>"
              data-jumlah="<%= item.total_jumlah || 0 %>"
              data-deletable="<%= deletable ? '1' : '0' %>">
            <td class="py-3.5 px-4 text-center text-slate-400 font-mono text-xs pl-6"><%= String(idx + 1).padStart(2, '0') %></td>
            <td class="py-3.5 px-4 font-mono font-semibold text-brand-700 text-xs whitespace-nowrap"><%= item.kode_peminjaman || '-' %></td>
            <td class="py-3.5 px-4 whitespace-nowrap min-w-[280px] w-[320px]">
              <div class="font-bold text-slate-900 leading-tight whitespace-nowrap"><%= item.nama_lengkap || '-' %></div>
              <div class="text-[11px] text-slate-400 mt-0.5 whitespace-nowrap">@<%= item.username || '-' %> &bull; <%= item.email || '-' %></div>
            </td>
            <td class="py-3.5 px-4 whitespace-nowrap min-w-[280px] w-[320px]">
              <div class="font-bold text-slate-900 leading-tight whitespace-nowrap"><%= item.alat_nama || '-' %></div>
              <div class="text-xs text-slate-400 mt-0.5 whitespace-nowrap"><%= item.alat_merk || '-' %> &bull; <%= item.nama_lab || '-' %></div>
            </td>
            <td class="py-3.5 px-4 text-xs font-mono text-slate-700 whitespace-nowrap min-w-[140px]"><%= formatTanggal(item.tanggal_pinjam) %></td>
            <td class="py-3.5 px-4 text-xs font-mono text-slate-700 whitespace-nowrap min-w-[140px]"><%= formatTanggal(item.tanggal_kembali_rencana) %></td>
            <td class="py-3.5 px-4 whitespace-nowrap min-w-[150px]">
              <div class="inline-flex items-center gap-1.5 text-xs font-semibold <%= meta.textClass %>">
                <span class="w-2 h-2 rounded-full <%= meta.dotClass %> shrink-0"></span>
                <span><%= meta.label %></span>
              </div>
              <% if (item.status === 'Ditolak' && item.alasan_penolakan) { %>
              <div class="text-[10px] text-rose-400 mt-0.5 max-w-[150px] truncate" title="<%= item.alasan_penolakan %>"><%= item.alasan_penolakan %></div>
              <% } %>
            </td>
            <td class="py-3.5 px-4 text-center pr-6 whitespace-nowrap min-w-[90px] w-24">
              <div class="inline-flex items-center justify-center gap-1.5">
                <button class="p-1.5 rounded-lg text-slate-400 hover:text-brand-700 hover:bg-blue-50 transition-colors" title="Lihat Detail" type="button">
                  <span class="material-symbols-outlined text-[18px]">visibility</span>
                </button>
                <% if (deletable) { %>
                <button class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors btn-hapus-peminjaman" title="Hapus" type="button">
                  <span class="material-symbols-outlined text-[18px]">delete</span>
                </button>
                <% } %>
              </div>
            </td>
          </tr>
          <% }); %>
          <tr id="admin-filter-empty" class="hidden">
            <td colspan="8" class="px-4 py-12 text-center text-sm text-slate-400">
              <span class="material-symbols-outlined text-[40px] mb-2 block">search_off</span>
              Tidak ada data yang cocok dengan filter.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal Detail Peminjaman -->
  <div id="modal-detail-peminjaman" class="hidden fixed inset-0 z-50 items-center justify-center px-6 py-8">
    <div id="modal-detail-peminjaman-overlay" class="fixed inset-0 bg-black/40 backdrop-blur-sm"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg transform transition-all duration-300 scale-95 opacity-0 translate-y-4 z-10 max-h-[90vh] overflow-y-auto" id="modal-detail-peminjaman-content">
      <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
        <h2 class="text-xl font-bold text-slate-900">Detail Peminjaman</h2>
        <button id="btn-close-detail-peminjaman" class="p-2 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors" type="button" aria-label="Tutup">
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
      </div>
      <div class="p-6 space-y-3 text-sm">
        <div class="flex justify-between gap-4"><span class="text-slate-500">Kode</span><span class="font-mono font-semibold text-brand-700" id="detail-pm-kode">-</span></div>
        <div class="flex justify-between gap-4"><span class="text-slate-500">Nama Pelapor</span><span class="text-slate-900 text-right" id="detail-pm-nama">-</span></div>
        <div class="flex justify-between gap-4"><span class="text-slate-500">Username / Email</span><span class="text-slate-700 text-right text-xs font-mono" id="detail-pm-identity">-</span></div>
        <div class="flex justify-between gap-4"><span class="text-slate-500">Alat</span><span class="text-slate-900 text-right" id="detail-pm-alat">-</span></div>
        <div class="flex justify-between gap-4"><span class="text-slate-500">Laboratorium</span><span class="text-slate-700 text-right" id="detail-pm-lab">-</span></div>
        <div class="flex justify-between gap-4"><span class="text-slate-500">Jumlah</span><span class="text-slate-700 text-right" id="detail-pm-jumlah">-</span></div>
        <div class="flex justify-between gap-4"><span class="text-slate-500">Tanggal Pinjam</span><span class="text-slate-700" id="detail-pm-tglpinjam">-</span></div>
        <div class="flex justify-between gap-4"><span class="text-slate-500">Tanggal Kembali</span><span class="text-slate-700" id="detail-pm-tglkembali">-</span></div>
        <div class="flex justify-between gap-4"><span class="text-slate-500">Tujuan</span><span class="text-slate-900 text-right" id="detail-pm-tujuan">-</span></div>
        <div class="flex justify-between gap-4"><span class="text-slate-500">Status</span><span class="text-slate-900 text-right font-semibold" id="detail-pm-status">-</span></div>
        <div id="detail-pm-catatan-wrap" class="hidden">
          <div class="flex justify-between gap-4"><span class="text-slate-500">Catatan</span><span class="text-slate-700 text-right" id="detail-pm-catatan">-</span></div>
        </div>
      </div>
      <div class="px-6 py-4 border-t border-slate-100 bg-slate-50/60 flex flex-col sm:flex-row sm:justify-between gap-3 rounded-b-2xl">
        <div class="flex flex-wrap gap-2" id="detail-pm-actions">
          <button type="button" data-action="dipinjam" class="hidden px-4 py-2 rounded-lg text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 transition shadow-sm">Tandai Dipinjam</button>
          <button type="button" data-action="selesai" class="hidden px-4 py-2 rounded-lg text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 transition shadow-sm">Tandai Selesai</button>
          <button type="button" data-action="batal" class="hidden px-4 py-2 rounded-lg text-xs font-semibold text-rose-600 border border-rose-200 bg-white hover:bg-rose-50 transition">Batalkan</button>
        </div>
        <button class="px-5 py-2.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-800 hover:bg-slate-200/60 border border-slate-200 bg-white transition shadow-2xs" id="btn-tutup-detail-peminjaman" type="button">Tutup</button>
      </div>
    </div>
  </div>

  <!-- Export Modal -->
  <div id="export-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/50 backdrop-blur-sm">
    <div class="relative bg-white rounded-2xl w-full max-w-2xl m-6 shadow-2xl transform transition-all duration-300 scale-95 opacity-0">
      <div class="flex items-center justify-between p-5 border-b border-slate-200">
        <h2 class="text-xl font-bold text-slate-900">Export Data</h2>
        <button class="p-2 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors" type="button" id="btn-close-export-modal" aria-label="Tutup">
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
      </div>
      <div class="p-6 space-y-5">
        <div>
          <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="export-format">Format</label>
          <select class="w-full px-4 py-2.5 bg-white border border-slate-200 text-xs placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs" id="export-format">
            <option value="csv">CSV (.csv)</option>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-slate-800 text-xs mb-1.5">Jangkauan</label>
          <p class="text-xs text-slate-500">Data yang diekspor mengikuti hasil filter yang sedang aktif.</p>
        </div>
        <div class="space-y-3">
          <button class="px-4 py-2.5 rounded-lg bg-brand-700 hover:bg-brand-800 text-xs font-semibold text-white transition shadow-sm w-full" id="btn-export-excel">Unduh &amp; Ekspor Sekarang</button>
          <button class="px-4 py-2.5 rounded-lg bg-white text-slate-600 hover:text-slate-800 hover:bg-slate-200/60 border border-slate-200 text-xs font-semibold transition shadow-sm w-full" id="btn-cancel-export">Batal</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Script Interaksi Peminjaman -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  var modalApi = window.sipatModal;
  var detailModal = document.getElementById('modal-detail-peminjaman');
  var detailContent = document.getElementById('modal-detail-peminjaman-content');
  var detailOverlay = document.getElementById('modal-detail-peminjaman-overlay');
  var exportModal = document.getElementById('export-modal');
  var exportContent = exportModal ? exportModal.querySelector('.relative') : null;
  var activeRow = null;

  function showModal(modal, content) {
    if (!modal || !content) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    void content.offsetWidth;
    content.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
    content.classList.add('scale-100', 'opacity-100', 'translate-y-0');
    document.body.style.overflow = 'hidden';
  }

  function hideModal(modal, content) {
    if (!modal || !content) return;
    content.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
    content.classList.add('scale-95', 'opacity-0', 'translate-y-4');
    setTimeout(function () {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      if (!document.querySelector('[data-sipat-modal]:not(.hidden)')) document.body.style.overflow = '';
    }, 220);
  }

  function toast(message, tone) {
    if (modalApi && typeof modalApi.toast === 'function') {
      modalApi.toast(message, tone || 'success');
    } else {
      window.alert(message);
    }
  }

  function esc(value) {
    return modalApi && typeof modalApi.escape === 'function'
      ? modalApi.escape(value == null ? '' : String(value))
      : String(value == null ? '' : value);
  }

  async function postForm(url, data) {
    var response = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(data || {})
    });
    var result = await response.json().catch(function () { return {}; });
    if (!response.ok) throw new Error(result.message || 'Terjadi kesalahan pada server.');
    return result;
  }

  // ---------- Detail modal ----------
  function openDetail(row) {
    if (!row) return;
    activeRow = row;
    var d = row.dataset;
    var set = function (id, value) {
      var el = document.getElementById(id);
      if (el) el.textContent = value || '-';
    };

    set('detail-pm-kode', d.kode);
    set('detail-pm-nama', d.nama);
    set('detail-pm-identity', (d.username || '-') + ' \u00b7 ' + (d.email || '-'));
    set('detail-pm-alat', (d.alat || '-') + (d.merk && d.merk !== '-' ? ' (' + d.merk + ')' : ''));
    set('detail-pm-lab', d.lab);
    set('detail-pm-jumlah', (d.jumlah || '0') + ' unit');
    set('detail-pm-tglpinjam', d.tanggalPinjam);
    set('detail-pm-tglkembali', d.tanggalKembali);
    set('detail-pm-tujuan', d.tujuan);
    set('detail-pm-status', d.status);

    var catatanWrap = document.getElementById('detail-pm-catatan-wrap');
    if (catatanWrap) {
      catatanWrap.classList.toggle('hidden', !d.catatan);
      set('detail-pm-catatan', d.catatan);
    }

    var actions = document.querySelectorAll('#detail-pm-actions [data-action]');
    actions.forEach(function (button) {
      var action = button.dataset.action;
      var visible =
        (action === 'dipinjam' && d.status === 'Disetujui') ||
        (action === 'selesai' && (d.status === 'Dipinjam' || d.status === 'Terlambat')) ||
        (action === 'batal' && (d.status === 'Menunggu Persetujuan' || d.status === 'Disetujui'));
      button.classList.toggle('hidden', !visible);
    });

    showModal(detailModal, detailContent);
  }

  function closeDetail() { hideModal(detailModal, detailContent); }

  document.querySelectorAll('.peminjaman-admin-row').forEach(function (row) {
    var detailBtn = row.querySelector('button[title="Lihat Detail"]');
    if (detailBtn) detailBtn.addEventListener('click', function () { openDetail(row); });
  });

  var btnCloseDetail = document.getElementById('btn-close-detail-peminjaman');
  var btnTutupDetail = document.getElementById('btn-tutup-detail-peminjaman');
  if (btnCloseDetail) btnCloseDetail.addEventListener('click', closeDetail);
  if (btnTutupDetail) btnTutupDetail.addEventListener('click', closeDetail);
  if (detailOverlay) detailOverlay.addEventListener('click', closeDetail);

  var ACTION_LABEL = {
    dipinjam: 'Tandai Dipinjam',
    selesai: 'Tandai Selesai',
    batal: 'Batalkan Peminjaman'
  };

  document.querySelectorAll('#detail-pm-actions [data-action]').forEach(function (button) {
    button.addEventListener('click', function () {
      if (!activeRow) return;
      var action = button.dataset.action;
      var row = activeRow;
      var d = row.dataset;

      if (!modalApi || typeof modalApi.confirm !== 'function') {
        if (!window.confirm(ACTION_LABEL[action] + ' untuk ' + d.kode + '?')) return;
        runAction(row, action).catch(function (error) { window.alert(error.message); });
        return;
      }

      modalApi.confirm({
        title: ACTION_LABEL[action] + '?',
        subtitle: 'Status peminjaman akan diperbarui.',
        tone: action === 'batal' ? 'danger' : 'primary',
        message: '<div class="text-sm text-slate-700 space-y-2">' +
          '<p>Apakah Anda yakin ingin memproses transaksi berikut?</p>' +
          '<div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 space-y-1">' +
          '<p class="text-xs text-slate-500">Kode Peminjaman</p>' +
          '<p class="font-mono font-bold text-slate-800">' + esc(d.kode) + '</p>' +
          '<p class="font-semibold text-slate-800 mt-1">' + esc(d.nama) + '</p>' +
          '<p class="text-xs text-slate-500">' + esc(d.alat) + '</p>' +
          '</div></div>',
        confirmText: 'Ya, Lanjutkan',
        confirmClass: 'px-5 py-2.5 rounded-xl text-xs font-semibold text-white ' +
          (action === 'batal' ? 'bg-rose-600 hover:bg-rose-700' : 'bg-blue-600 hover:bg-blue-700') +
          ' transition shadow-sm inline-flex items-center justify-center gap-2',
        loadingText: 'Memproses...',
        onConfirm: function () { return runAction(row, action); }
      });
    });
  });

  async function runAction(row, action) {
    await postForm('/admin/peminjaman/' + row.dataset.id + '/status', { action: action });
    toast(ACTION_LABEL[action] + ' berhasil.', action === 'batal' ? 'danger' : 'success');
    closeDetail();
    setTimeout(function () { window.location.reload(); }, 700);
  }

  // ---------- Delete ----------
  document.querySelectorAll('.btn-hapus-peminjaman').forEach(function (button) {
    button.addEventListener('click', function () {
      var row = button.closest('.peminjaman-admin-row');
      if (!row) return;
      var d = row.dataset;

      if (!modalApi || typeof modalApi.confirm !== 'function') {
        if (!window.confirm('Hapus data peminjaman ' + d.kode + '?')) return;
        deleteRow(row).catch(function (error) { window.alert(error.message); });
        return;
      }

      modalApi.confirm({
        title: 'Hapus Data Peminjaman?',
        subtitle: 'Tindakan ini tidak dapat dibatalkan.',
        tone: 'danger',
        message: '<div class="text-sm text-slate-700 space-y-2">' +
          '<p>Apakah Anda yakin ingin menghapus transaksi peminjaman berikut?</p>' +
          '<div class="rounded-xl border border-rose-100 bg-rose-50/70 px-4 py-3 space-y-1">' +
          '<p class="text-xs text-slate-500">Kode Peminjaman</p>' +
          '<p class="font-mono font-bold text-rose-700">' + esc(d.kode) + '</p>' +
          '<p class="font-semibold text-slate-800 mt-1">' + esc(d.nama) + '</p>' +
          '<p class="text-xs text-slate-500">' + esc(d.alat) + '</p>' +
          '</div></div>',
        confirmText: 'Ya, Hapus',
        confirmClass: 'px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 transition shadow-sm inline-flex items-center justify-center gap-2',
        loadingText: 'Menghapus...',
        onConfirm: function () { return deleteRow(row); }
      });
    });
  });

  async function deleteRow(row) {
    await postForm('/admin/peminjaman/' + row.dataset.id + '/delete');
    toast('Transaksi ' + (row.dataset.kode || '') + ' berhasil dihapus.', 'success');
    row.style.transition = 'opacity 0.18s ease, transform 0.18s ease';
    row.style.opacity = '0';
    row.style.transform = 'translateY(-4px)';
    setTimeout(function () {
      row.remove();
      renumberRows();
      applyFilters();
    }, 180);
  }

  function renumberRows() {
    var rows = document.querySelectorAll('.peminjaman-admin-row');
    rows.forEach(function (row, index) {
      var first = row.children[0];
      if (first) first.textContent = String(index + 1).padStart(2, '0');
    });
  }

  // ---------- Filters ----------
  var searchInput = document.getElementById('search-peminjaman-admin');
  var filterStatus = document.getElementById('filter-status-admin');
  var filterLab = document.getElementById('filter-lab-admin');
  var emptyRow = document.getElementById('admin-filter-empty');

  function applyFilters() {
    var rows = Array.prototype.slice.call(document.querySelectorAll('.peminjaman-admin-row'));
    var term = (searchInput ? searchInput.value : '').trim().toLowerCase();
    var status = filterStatus ? filterStatus.value : '';
    var lab = filterLab ? filterLab.value : '';
    var visible = 0;

    rows.forEach(function (row) {
      var d = row.dataset;
      var matchesSearch = !term ||
        (d.kode || '').toLowerCase().indexOf(term) !== -1 ||
        (d.nama || '').toLowerCase().indexOf(term) !== -1 ||
        (d.email || '').toLowerCase().indexOf(term) !== -1 ||
        (d.alat || '').toLowerCase().indexOf(term) !== -1 ||
        (d.merk || '').toLowerCase().indexOf(term) !== -1;
      var matchesStatus = !status || d.status === status;
      var matchesLab = !lab || d.lab === lab;
      var show = matchesSearch && matchesStatus && matchesLab;
      row.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    if (emptyRow) emptyRow.classList.toggle('hidden', visible !== 0 || rows.length === 0);
  }

  if (searchInput) searchInput.addEventListener('input', applyFilters);
  if (filterStatus) filterStatus.addEventListener('change', applyFilters);
  if (filterLab) filterLab.addEventListener('change', applyFilters);
  applyFilters();

  // ---------- Export ----------
  var btnOpenExport = document.getElementById('btn-open-export');
  var btnCloseExport = document.getElementById('btn-close-export-modal');
  var btnCancelExport = document.getElementById('btn-cancel-export');
  var btnExport = document.getElementById('btn-export-excel');

  if (btnOpenExport) btnOpenExport.addEventListener('click', function () { showModal(exportModal, exportContent); });
  if (btnCloseExport) btnCloseExport.addEventListener('click', function () { hideModal(exportModal, exportContent); });
  if (btnCancelExport) btnCancelExport.addEventListener('click', function () { hideModal(exportModal, exportContent); });
  if (exportModal) exportModal.addEventListener('click', function (e) {
    if (e.target === exportModal) hideModal(exportModal, exportContent);
  });

  if (btnExport) {
    btnExport.addEventListener('click', function () {
      var rows = Array.prototype.slice.call(document.querySelectorAll('.peminjaman-admin-row')).filter(function (row) {
        return !row.classList.contains('hidden');
      });

      if (!rows.length) {
        toast('Tidak ada data untuk diekspor.', 'danger');
        return;
      }

      var header = ['No', 'Kode Peminjaman', 'Nama Peminjam', 'Username', 'Email', 'Alat', 'Merk', 'Laboratorium', 'Tanggal Pinjam', 'Tanggal Kembali', 'Jumlah', 'Status', 'Tujuan'];
      var csv = [header.join(';')];

      rows.forEach(function (row, index) {
        var d = row.dataset;
        var values = [
          index + 1, d.kode, d.nama, d.username, d.email, d.alat, d.merk, d.lab,
          d.tanggalPinjam, d.tanggalKembali, d.jumlah, d.status, d.tujuan
        ];
        csv.push(values.map(function (value) {
          return '"' + String(value == null ? '' : value).replace(/"/g, '""') + '"';
        }).join(';'));
      });

      var blob = new Blob(['\uFEFF' + csv.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
      var link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = 'peminjaman-' + new Date().toISOString().slice(0, 10) + '.csv';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(link.href);
      hideModal(exportModal, exportContent);
      toast('Data peminjaman berhasil diekspor.', 'success');
    });
  }

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    if (exportModal && !exportModal.classList.contains('hidden')) hideModal(exportModal, exportContent);
    if (detailModal && !detailModal.classList.contains('hidden')) closeDetail();
  });
});
</script>