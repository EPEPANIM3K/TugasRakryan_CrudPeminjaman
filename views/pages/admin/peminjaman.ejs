<!-- Main Content -->
<div class="flex flex-col w-full space-y-6">
  <!-- Header Section -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-semibold text-brand-700 tracking-wider uppercase">Manajemen Transaksi Laboratorium</span>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Kelola Peminjaman</h1>
      <p class="text-sm text-slate-500 mt-1">Daftar seluruh permohonan dan transaksi peminjaman alat laboratorium,<br>verifikasi status, dan pengelolaan peminjaman aktif.</p>
    </div>
    <!-- Action Buttons Right-Aligned -->
    <div class="flex flex-wrap items-center gap-2.5 shrink-0">
      <button class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 text-sm font-semibold transition-colors shadow-sm" id="btn-open-export" type="button">
        <span class="material-symbols-outlined text-[18px] text-slate-500">file_download</span>
        <span class="">Ekspor Excel</span>
      </button>
    </div>
  </div>

  <!-- 3 Stat KPI Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <!-- Card 1: Total Pengajuan -->
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-blue-50 text-brand-700">Total Pengajuan</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-total-pengajuan"><%= stats.totalPengajuan || 0 %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Semua permohonan peminjaman</div>
      </div>
    </div>
    <!-- Card 2: Menunggu Persetujuan -->
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-50 text-emerald-700">Menunggu Persetujuan</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-menunggu"><%= stats.menungguPersetujuan || 0 %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Permohonan menunggu verifikasi</div>
      </div>
    </div>
    <!-- Card 3: Disetujui -->
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-50 text-emerald-700">Disetujui</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-disetujui"><%= stats.disetujui || 0 %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Permohonan telah disetujui</div>
      </div>
    </div>
  </div>

  <!-- Filter & Search Toolbar -->
  <div class="rounded-xl flex flex-col lg:flex-row items-center gap-3 mb-5">
    <!-- Search input -->
    <div class="relative flex-1">
      <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none select-none">search</span>
      <input class="w-full pl-10 pr-4 h-10 border border-slate-200 text-slate-700 text-sm rounded-lg placeholder-slate-400 focus:outline-none focus:bg-white focus:border-brand-700 transition-colors bg-white" placeholder="Cari kode pinjam, nama peminjam, atau nama alat..." type="text" id="search-peminjaman-admin">
    </div>
    <div class="flex flex-col lg:flex-row items-center gap-3">
      <div class="relative w-full lg:w-auto min-w-[200px]">
        <select class="w-full h-10 appearance-none pl-3.5 pr-9 bg-white border border-slate-200 text-slate-700 text-sm rounded-lg cursor-pointer focus:outline-none focus:border-brand-700 transition-colors" id="filter-status-admin">
          <option value="">Semua Status</option>
          <% if (distinctStatuses) { %>
            <% distinctStatuses.forEach(function(status) { %>
              <option value="<%= status %>"><%= status %></option>
            <% }); %>
          <% } %>
          <option value="terlambat">Terlambat</option>
          <option value="dipinjam">Sedang Dipinjam</option>
          <option value="dikembalikan">Dikembalikan Tepat Waktu</option>
        </select>
        <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>
      </div>
      <div class="relative w-full lg:w-auto min-w-[180px]">
        <select class="w-full h-10 appearance-none pl-3.5 pr-9 bg-white border border-slate-200 text-slate-700 text-sm rounded-lg cursor-pointer focus:outline-none focus:border-brand-700 transition-colors">
          <option value="">Semua Laboratorium</option>
          <option value="Semua">Semua</option>
        </select>
        <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>
      </div>
    </div>
  </div>

