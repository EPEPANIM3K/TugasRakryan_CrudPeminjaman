<!-- Script Interactivity Modal Tambah User -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const modal = document.getElementById('modal-tambah-user');
  const modalOverlay = document.getElementById('modal-overlay');
  const modalContent = document.getElementById('modal-content');
  const btnOpenModal = document.getElementById('btn-open-form-user');
  const btnCloseModal = document.getElementById('btn-close-modal');
  const btnCancelModal = document.getElementById('btn-cancel-modal');

  function openModal() {
    modal.classList.remove('hidden');
    void modalContent.offsetWidth;
    modalContent.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
    modalContent.classList.add('scale-100', 'opacity-100', 'translate-y-0');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modalContent.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
    modalContent.classList.add('scale-95', 'opacity-0', 'translate-y-4');
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  }

  if (btnOpenModal) {
    btnOpenModal.addEventListener('click', function(e) {
      e.preventDefault();
      openModal();
    });
  }

  if (btnCloseModal) btnCloseModal.addEventListener('click', closeModal);
  if (btnCancelModal) btnCancelModal.addEventListener('click', closeModal);
  if (modalOverlay) modalOverlay.addEventListener('click', closeModal);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  // Foto upload preview interactivity
  const fotoInput = document.getElementById('foto-input');
  const uploadPlaceholder = document.getElementById('upload-placeholder');
  const uploadPreviewWrapper = document.getElementById('upload-preview-wrapper');
  const fotoPreviewImg = document.getElementById('foto-preview-img');
  const previewFilename = document.getElementById('preview-filename');
  const previewFilesize = document.getElementById('preview-filesize');
  const btnRemoveFoto = document.getElementById('btn-remove-foto');

  if (fotoInput) {
    fotoInput.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          fotoPreviewImg.src = e.target.result;
          previewFilename.textContent = file.name;
          previewFilesize.textContent = (file.size / (1024 * 1024)).toFixed(1) + ' MB';
          uploadPlaceholder.classList.add('hidden');
          uploadPreviewWrapper.classList.remove('hidden');
        }
        reader.readAsDataURL(file);
      }
    });
  }

  if (btnRemoveFoto) {
    btnRemoveFoto.addEventListener('click', function() {
      fotoInput.value = '';
      fotoPreviewImg.src = '';
      uploadPreviewWrapper.classList.add('hidden');
      uploadPlaceholder.classList.remove('hidden');
    });
  }

  // =============================================
  // Modal Ekspor Data
  // =============================================
  const exportModal = document.getElementById('modal-export');
  const exportModalOverlay = document.getElementById('modal-export-overlay');
  const exportModalContent = document.getElementById('modal-export-content');
  const btnOpenExport = document.getElementById('btn-open-export');
  const btnCloseExport = document.getElementById('btn-close-export');
  const btnCancelExport = document.getElementById('btn-cancel-export');

  function openExportModal() {
    exportModal.classList.remove('hidden');
    void exportModalContent.offsetWidth;
    exportModalContent.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
    exportModalContent.classList.add('scale-100', 'opacity-100', 'translate-y-0');
    document.body.style.overflow = 'hidden';
  }

  function closeExportModal() {
    exportModalContent.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
    exportModalContent.classList.add('scale-95', 'opacity-0', 'translate-y-4');
    setTimeout(() => {
      exportModal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  }

  if (btnOpenExport) {
    btnOpenExport.addEventListener('click', function(e) {
      e.preventDefault();
      openExportModal();
    });
  }

  if (btnCloseExport) btnCloseExport.addEventListener('click', closeExportModal);
  if (btnCancelExport) btnCancelExport.addEventListener('click', closeExportModal);
  if (exportModalOverlay) exportModalOverlay.addEventListener('click', closeExportModal);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && exportModal && !exportModal.classList.contains('hidden')) {
      closeExportModal();
    }
  });

  // Format pilihan ekspor (highlight kartu terpilih)
  const formatOptions = document.querySelectorAll('.export-format-option');
  formatOptions.forEach(function(option) {
    const radio = option.querySelector('input[type="radio"]');
    if (radio) {
      radio.addEventListener('change', function() {
        formatOptions.forEach(function(opt) {
          opt.classList.remove('border-2', 'border-blue-600', 'bg-blue-50/40', 'shadow-xs');
          opt.classList.add('border', 'border-slate-200', 'bg-white');
        });
        option.classList.remove('border', 'border-slate-200', 'bg-white');
        option.classList.add('border-2', 'border-blue-600', 'bg-blue-50/40', 'shadow-xs');
      });
    }
  });

  // Toggle dropdown cakupan data
  const btnToggleExportScope = document.getElementById('btn-toggle-export-scope');
  const exportScopeDropdown = document.getElementById('export-scope-dropdown');
  const exportScopeArrow = document.getElementById('export-scope-arrow');

  if (btnToggleExportScope && exportScopeDropdown) {
    btnToggleExportScope.addEventListener('click', function() {
      const isHidden = exportScopeDropdown.classList.toggle('hidden');
      if (exportScopeArrow) {
        exportScopeArrow.textContent = isHidden ? 'keyboard_arrow_down' : 'keyboard_arrow_up';
      }
    });
  }

  // Pilih semua / reset pilihan baris
  const exportSelectAll = document.getElementById('export-select-all');
  const exportRowChecks = document.querySelectorAll('.export-row-check');
  const exportResetSelection = document.getElementById('export-reset-selection');

  if (exportSelectAll) {
    exportSelectAll.addEventListener('change', function() {
      exportRowChecks.forEach(function(cb) { cb.checked = exportSelectAll.checked; });
    });
  }

  if (exportResetSelection) {
    exportResetSelection.addEventListener('click', function() {
      exportRowChecks.forEach(function(cb) { cb.checked = false; });
      if (exportSelectAll) exportSelectAll.checked = false;
    });
  }
});

// Action handlers for the user table
(function () {
  const wait = function (ms) { return new Promise(function (resolve) { setTimeout(resolve, ms); }); };
  const textOf = function (el) { return el ? (el.textContent || '').replace(/\s+/g, ' ').trim() : ''; };


  function readUserRow(row) {
    const cells = row ? row.children : [];
    const nameCell = cells[2];
    const spans = nameCell ? nameCell.querySelectorAll('span') : [];
    const identity = textOf(spans[1]);
    const parts = identity.split('•');
    const username = textOf({ textContent: parts[0] || '' }).replace(/^@/, '');
    const email = textOf({ textContent: parts[1] || '' });
    return {
      nip: textOf(cells[1]),
      nama: textOf(spans[0]),
      username: username,
      email: email,
      role: textOf(cells[3]),
      fakultas: textOf(cells[4]),
      status: textOf(cells[6])
    };
  }

  function statusTone(status) {
    if (status === 'Aktif') return { text: 'text-emerald-600', dot: 'bg-emerald-500' };
    if (status === 'Suspend') return { text: 'text-rose-600', dot: 'bg-rose-500' };
    if (status === 'Pending') return { text: 'text-amber-600', dot: 'bg-amber-500' };
    return { text: 'text-slate-500', dot: 'bg-slate-400' };
  }

  function setStatusCell(cell, status) {
    if (!cell) return;
    const wrap = cell.querySelector('div');
    if (!wrap) return;
    const tone = statusTone(status);
    wrap.className = 'inline-flex items-center gap-2 text-xs font-semibold ' + tone.text;
    const dot = wrap.children[0];
    if (dot) dot.className = 'w-2 h-2 rounded-full shrink-0 ' + tone.dot;
    const label = wrap.children[1];
    if (label) label.textContent = status;
  }

  function updateActionAttributes(row, data) {
    const usernameAt = '@' + String(data.username || '').replace(/^@/, '');
    row.querySelectorAll('button[title="Ubah Akun"]').forEach(function (button) {
      button.dataset.nama = data.nama;
      button.dataset.username = usernameAt;
      button.dataset.role = data.role;
    });
    row.querySelectorAll('button[title="Hapus Akun"], button[title="Hapus"]').forEach(function (button) {
      button.dataset.nama = data.nama;
      button.dataset.username = usernameAt;
    });
  }

  document.querySelectorAll('button[title="Ubah Akun"]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const row = btn.closest('tr');
      if (!row) return;
      const data = readUserRow(row);
      const roleOptions = ['Admin', 'Petugas Lab', 'Dosen Peneliti', 'Dosen', 'Mahasiswa', 'Peminjam'];
      const statusOptions = ['Aktif', 'Pending', 'Non-Aktif', 'Suspend'];
      if (data.role && roleOptions.indexOf(data.role) === -1) roleOptions.push(data.role);
      if (data.status && statusOptions.indexOf(data.status) === -1) statusOptions.push(data.status);

      const formHtml =
        '<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">' +
        window.sipatModal.inputField({ label: 'NIP / NIM', name: 'nip', value: data.nip, readonly: true }) +
        window.sipatModal.inputField({ label: 'Nama Lengkap', name: 'nama', value: data.nama, required: true, placeholder: 'Nama lengkap pengguna' }) +
        '</div>' +
        '<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">' +
        window.sipatModal.inputField({ label: 'Username', name: 'username', value: data.username, required: true, placeholder: 'Tanpa tanda @' }) +
        window.sipatModal.inputField({ label: 'Email', name: 'email', value: data.email, type: 'email', required: true, placeholder: 'nama@univ.ac.id' }) +
        '</div>' +
        '<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">' +
        window.sipatModal.selectField({ label: 'Role / Peran', name: 'role', value: data.role, required: true, options: roleOptions.map(function (value) { return { value: value, label: value }; }) }) +
        window.sipatModal.selectField({ label: 'Status Akun', name: 'status', value: data.status, required: true, options: statusOptions.map(function (value) { return { value: value, label: value }; }) }) +
        '</div>' +
        window.sipatModal.inputField({ label: 'Fakultas / Unit', name: 'fakultas', value: data.fakultas, required: true, placeholder: 'Fakultas / unit kerja' });

      window.sipatModal.form({
        title: 'Ubah Akun Pengguna',
        subtitle: data.nama || data.nip,
        tone: 'info',
        formHtml: formHtml,
        saveText: 'Simpan Perubahan',
        loadingText: 'Menyimpan...',
        onSubmit: async function (values) {
          await wait(550);
          if (!row || !row.parentNode) throw new Error('Data pengguna tidak ditemukan atau sudah dihapus.');

          const username = String(values.username || '').replace(/^@/, '').trim();
          const nameCell = row.children[2];
          const spans = nameCell ? nameCell.querySelectorAll('span') : [];
          if (spans[0]) spans[0].textContent = String(values.nama || '').trim();
          if (spans[1]) spans[1].textContent = '@' + username + (values.email ? ' • ' + String(values.email).trim() : '');
          if (row.children[3]) row.children[3].textContent = values.role;
          if (row.children[4]) row.children[4].textContent = values.fakultas;
          setStatusCell(row.children[6], values.status);

          updateActionAttributes(row, {
            nama: String(values.nama || '').trim(),
            username: username,
            role: values.role
          });

          window.sipatModal.toast('Data akun ' + (values.nama || username) + ' berhasil diperbarui.', 'success');
        }
      });
    });
  });

  function renumberRows() {
    const tbody = document.querySelector('table tbody');
    if (!tbody) return;
    Array.prototype.forEach.call(tbody.querySelectorAll('tr'), function (row, index) {
      const first = row.children[0];
      if (first) first.textContent = String(index + 1).padStart(2, '0');
    });
  }

  document.querySelectorAll('button[title="Hapus Akun"], button[title="Hapus"]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const row = btn.closest('tr');
      const data = readUserRow(row);
      const identity = '@' + String(data.username || '').replace(/^@/, '') + (data.email ? ' • ' + data.email : '');

      window.sipatModal.confirm({
        title: 'Hapus Akun Pengguna?',
        subtitle: 'Tindakan ini tidak dapat dibatalkan.',
        tone: 'danger',
        message: '<div class="text-sm text-slate-700 space-y-2">' +
          '<p>Apakah Anda yakin ingin menghapus akun berikut?</p>' +
          '<div class="rounded-xl border border-rose-100 bg-rose-50/70 px-4 py-3 space-y-1">' +
          '<p class="text-xs text-slate-500">Nama Pengguna</p>' +
          '<p class="font-semibold text-rose-700">' + window.sipatModal.escape(data.nama || data.nip || 'N/A') + '</p>' +
          '<p class="font-mono text-xs text-slate-500">' + window.sipatModal.escape(identity) + '</p>' +
          '<p class="text-xs text-slate-500">' + window.sipatModal.escape(data.role || '-') + ' • ' + window.sipatModal.escape(data.fakultas || '-') + '</p>' +
          '</div></div>',
        confirmText: 'Ya, Hapus',
        confirmClass: 'px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 transition shadow-sm inline-flex items-center justify-center gap-2',
        loadingText: 'Menghapus...',
        onConfirm: async function () {
          await wait(550);
          if (!row || !row.parentNode) throw new Error('Akun tidak ditemukan atau sudah dihapus.');
          row.style.transition = 'opacity 0.18s ease, transform 0.18s ease';
          row.style.opacity = '0';
          row.style.transform = 'translateY(-4px)';
          await wait(180);
          row.remove();
          renumberRows();
          window.sipatModal.toast('Akun ' + (data.nama || identity) + ' berhasil dihapus.', 'success');
        }
      });
    });
  });
})();
</script>
