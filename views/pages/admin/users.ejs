<!-- Main Content -->
<div class="flex flex-col w-full space-y-6">
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-semibold text-brand-700 tracking-wider uppercase">Manajemen Pengguna Sistem</span>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Kelola Akun Pengguna</h1>
      <p class="text-sm text-slate-500 mt-1">Daftar seluruh pengguna sistem, perizinan akses akun, dan status validitas civitas laboratorium.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2.5 shrink-0">
      <button class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold text-sm shadow-sm hover:bg-blue-700 transition-all active:scale-[0.99]" id="btn-open-modal" type="button">
        <span class="material-symbols-outlined text-[18px]">add</span>
        <span>Tambah User</span>
      </button>
      <button class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 text-sm font-semibold transition-colors shadow-sm" id="btn-open-export" type="button">
        <span class="material-symbols-outlined text-[18px] text-slate-500">file_download</span>
        <span>Ekspor Excel</span>
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-blue-50 text-brand-700">Total User</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-total"><%= (stats.total || 0).toLocaleString('id-ID') %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Seluruh akun terdaftar</div>
      </div>
    </div>
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-50 text-emerald-700">Akun Aktif</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-aktif"><%= (stats.aktif || 0).toLocaleString('id-ID') %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Akses sistem terverifikasi</div>
      </div>
    </div>
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-amber-50 text-amber-700">Pending</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-pending"><%= (stats.pending || 0).toLocaleString('id-ID') %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Menunggu aktivasi/validasi</div>
      </div>
    </div>
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-purple-50 text-purple-700">Sedang Meminjam</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight" id="stat-pinjam"><%= (stats.sedangMeminjam || 0).toLocaleString('id-ID') %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Peminjam aktif saat ini</div>
      </div>
    </div>
  </div>

  <form method="GET" action="/admin/users" id="filter-form" class="rounded-xl flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">
    <div class="relative flex-1">
      <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none select-none">search</span>
      <input name="search" value="<%= filters.search || '' %>" class="w-full pl-10 pr-4 h-10 border border-slate-200 text-slate-700 text-sm rounded-lg placeholder-slate-400 focus:outline-none focus:bg-white focus:border-brand-700 transition-colors bg-white" placeholder="Cari nama pengguna, NIP/NIM, email, atau username..." type="text">
    </div>
    <div class="flex flex-col sm:flex-row items-center gap-3">
      <div class="relative w-full sm:w-auto min-w-[180px]">
        <select name="role" onchange="this.form.submit()" class="w-full h-10 appearance-none pl-3.5 pr-9 bg-white border border-slate-200 text-slate-700 text-sm rounded-lg cursor-pointer focus:outline-none focus:border-brand-700 transition-colors">
          <option value="">Semua Role</option>
          <option value="admin" <%= filters.role === 'admin' ? 'selected' : '' %>>Admin</option>
          <option value="petugas" <%= filters.role === 'petugas' ? 'selected' : '' %>>Petugas</option>
          <option value="user" <%= filters.role === 'user' ? 'selected' : '' %>>User</option>
        </select>
        <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>
      </div>
      <div class="relative w-full sm:w-auto min-w-[170px]">
        <select name="status" onchange="this.form.submit()" class="w-full h-10 appearance-none pl-3.5 pr-9 bg-white border border-slate-200 text-slate-700 text-sm rounded-lg cursor-pointer focus:outline-none focus:border-brand-700 transition-colors">
          <option value="">Semua Status</option>
          <option value="Aktif" <%= filters.status === 'Aktif' ? 'selected' : '' %>>Aktif</option>
          <option value="Pending" <%= filters.status === 'Pending' ? 'selected' : '' %>>Pending</option>
          <option value="Suspend" <%= filters.status === 'Suspend' ? 'selected' : '' %>>Suspend</option>
        </select>
        <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>
      </div>
      <% if (filters.search || filters.role || filters.status) { %>
      <a href="/admin/users" class="inline-flex items-center gap-1.5 h-10 px-3.5 rounded-lg text-xs font-semibold text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 transition-colors whitespace-nowrap">
        <span class="material-symbols-outlined text-[16px]">filter_alt_off</span>Reset
      </a>
      <% } %>
    </div>
  </form>

  <div class="bg-white rounded-xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col">
    <div class="w-full overflow-x-auto overflow-y-auto max-h-[440px]">
      <table class="w-full text-left border-collapse">
        <thead class="sticky top-0 z-10 bg-slate-50 border-b border-slate-200 text-slate-500 uppercase tracking-wider text-[11px] font-semibold">
          <tr>
            <th class="w-12 px-3 py-3.5 text-center bg-slate-50 whitespace-nowrap">NO</th>
            <th class="w-36 px-4 py-3.5 bg-slate-50 whitespace-nowrap">NIP / NIM</th>
            <th class="min-w-[280px] w-[320px] px-4 py-3.5 bg-slate-50 whitespace-nowrap">NAMA LENGKAP &amp; USERNAME</th>
            <th class="min-w-[120px] px-4 py-3.5 bg-slate-50 whitespace-nowrap">ROLE</th>
            <th class="min-w-[160px] px-4 py-3.5 bg-slate-50 whitespace-nowrap">FAKULTAS / UNIT</th>
            <th class="min-w-[140px] px-4 py-3.5 bg-slate-50 whitespace-nowrap">TGL DIBUAT</th>
            <th class="min-w-[120px] pl-6 pr-3 py-3.5 bg-slate-50 whitespace-nowrap">STATUS</th>
            <th class="min-w-[90px] w-24 px-4 py-3.5 text-center bg-slate-50 whitespace-nowrap">AKSI</th>
          </tr>
        </thead>
        <tbody id="users-tbody" class="divide-y divide-slate-100 text-sm bg-white">
          <% if (!items.length) { %>
          <tr>
            <td colspan="8" class="px-4 py-12 text-center text-sm text-slate-400">
              <span class="material-symbols-outlined text-[40px] mb-2 block">group_off</span>
              Tidak ada pengguna yang cocok dengan filter.
            </td>
          </tr>
          <% } %>
          <% items.forEach(function(u, idx) { 
               var tgl = formatTanggal(u.created_at);
               var roleLabel = u.role === 'admin' ? 'Admin' : (u.role === 'petugas' ? 'Petugas' : 'User');
               var statusCls = u.status_akun === 'Aktif' ? 'text-emerald-600' : (u.status_akun === 'Pending' ? 'text-amber-600' : 'text-rose-600');
               var dotCls = u.status_akun === 'Aktif' ? 'bg-emerald-500' : (u.status_akun === 'Pending' ? 'bg-amber-500' : 'bg-rose-500');
          %>
          <tr class="hover:bg-slate-50/80 transition-colors duration-150 group user-row"
              data-id="<%= u.id %>"
              data-nama="<%= (u.nama_lengkap||'').replace(/"/g,'&quot;') %>"
              data-username="<%= (u.username||'').replace(/"/g,'&quot;') %>"
              data-email="<%= (u.email||'').replace(/"/g,'&quot;') %>"
              data-nip="<%= (u.nip_nim||'').replace(/"/g,'&quot;') %>"
              data-role="<%= u.role %>"
              data-tipe="<%= (u.tipe_pengguna||'').replace(/"/g,'&quot;') %>"
              data-fakultas="<%= (u.fakultas_unit||'').replace(/"/g,'&quot;') %>"
              data-status="<%= u.status_akun %>">
            <td class="w-12 px-3 py-3.5 text-center font-mono text-xs text-slate-400 row-no"><%= String(idx + 1).padStart(2, '0') %></td>
            <td class="w-36 px-4 py-3.5 font-mono text-xs font-semibold text-slate-700 whitespace-nowrap"><%= u.nip_nim || '-' %></td>
            <td class="min-w-[280px] w-[320px] px-4 py-3.5 whitespace-nowrap">
              <div class="flex flex-col whitespace-nowrap">
                <span class="font-bold text-slate-900 leading-tight whitespace-nowrap"><%= u.nama_lengkap %></span>
                <span class="text-[11px] text-slate-400 mt-0.5 whitespace-nowrap">@<%= u.username %> • <%= u.email %></span>
              </div>
            </td>
            <td class="min-w-[120px] px-4 py-3.5 text-slate-600 font-medium text-xs whitespace-nowrap"><%= roleLabel %></td>
            <td class="min-w-[160px] px-4 py-3.5 text-slate-600 text-xs whitespace-nowrap"><%= u.fakultas_unit || '-' %></td>
            <td class="py-3.5 px-4 text-xs font-mono text-slate-700 whitespace-nowrap min-w-[140px]">
              <div class="font-medium"><%= tgl.tanggal %></div>
              <div class="text-slate-400"><%= tgl.jam %></div>
            </td>
            <td class="min-w-[120px] pl-6 pr-3 py-3.5 whitespace-nowrap">
              <div class="inline-flex items-center gap-2 text-xs font-semibold <%= statusCls %>">
                <span class="w-2 h-2 rounded-full <%= dotCls %> shrink-0"></span>
                <span><%= u.status_akun %></span>
              </div>
            </td>
            <td class="min-w-[90px] w-24 px-4 py-3.5 text-center">
              <div class="inline-flex items-center justify-center gap-1.5">
                <button class="p-1.5 rounded-lg text-slate-400 hover:text-brand-700 hover:bg-blue-50 transition-colors btn-edit-user" title="Ubah Akun" type="button">
                  <span class="material-symbols-outlined text-[18px]">edit</span>
                </button>
                <button class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors btn-delete-user" title="Hapus Akun" type="button">
                  <span class="material-symbols-outlined text-[18px]">delete</span>
                </button>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="px-6 py-4 bg-white border-t border-slate-100 flex items-center justify-between gap-4 shrink-0">
      <div class="text-xs text-slate-500">
        Menampilkan <span class="font-semibold text-slate-800" id="count-shown"><%= items.length %></span> dari <span class="font-semibold text-slate-800" id="count-total"><%= stats.total || 0 %></span> akun pengguna
      </div>
    </div>
  </div>
</div>

<!-- Modal Tambah/Edit Akun -->
<div id="modal-tambah-user" class="fixed inset-0 z-[100] hidden">
  <div id="modal-overlay" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity duration-300"></div>
  <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
    <div id="modal-content" class="bg-white w-full max-w-2xl rounded-2xl shadow-2xl flex flex-col max-h-[calc(100vh-2rem)] overflow-hidden pointer-events-auto transform transition-all duration-300 scale-95 opacity-0 translate-y-4">
      <div class="px-6 py-5 border-b border-slate-100 flex items-start justify-between bg-white shrink-0">
        <div>
          <h2 id="modal-user-title" class="text-lg font-bold text-slate-900 tracking-tight">Tambah Akun Pengguna</h2>
          <p id="modal-user-subtitle" class="text-xs text-slate-500 mt-0.5">Lengkapi informasi kredensial dan hak akses civitas laboratorium</p>
        </div>
        <button id="btn-close-modal" class="p-2 -mr-2 -mt-1 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-full transition-colors shrink-0" type="button" aria-label="Tutup">
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>

      <form id="form-tambah-user" class="p-6 overflow-y-auto space-y-4">
        <input type="hidden" id="input-user-id" value="">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <div>
            <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="input-nama-lengkap">Nama Lengkap <span class="text-rose-500">*</span></label>
            <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition" id="input-nama-lengkap" placeholder="Contoh: Dr. Ir. Hendra Wijaya, M.T." required type="text">
          </div>
          <div>
            <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="input-nip-nim">NIP / NIM <span class="text-rose-500">*</span></label>
            <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition font-mono" id="input-nip-nim" placeholder="198405122010011005" required type="text">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <div>
            <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="input-username">Username <span class="text-rose-500">*</span></label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs font-medium">@</span>
              <input class="w-full pl-8 pr-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition" id="input-username" placeholder="hendrawijaya" required type="text">
            </div>
          </div>
          <div>
            <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="input-email">Email Institusi <span class="text-rose-500">*</span></label>
            <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition" id="input-email" placeholder="nama@institusi.ac.id" required type="email">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
          <div>
            <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="select-role">Role / Peran <span class="text-rose-500">*</span></label>
            <div class="relative">
              <select class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs text-slate-700 appearance-none focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition cursor-pointer pr-8" id="select-role" required>
                <option value="" disabled selected>Pilih Role</option>
                <option value="user">User</option>
                <option value="petugas">Petugas</option>
                <option value="admin">Admin</option>
              </select>
              <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>
            </div>
          </div>
          <div>
            <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="select-status">Status Akun <span class="text-rose-500">*</span></label>
            <div class="relative">
              <select class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs text-slate-700 appearance-none focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition cursor-pointer pr-8" id="select-status" required>
                <option value="Aktif">Aktif</option>
                <option value="Pending">Pending</option>
                <option value="Suspend">Suspend</option>
              </select>
              <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">expand_more</span>
            </div>
          </div>
          <div>
            <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="input-tipe-pengguna">Tipe Pengguna</label>
            <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition" id="input-tipe-pengguna" placeholder="Mahasiswa/Dosen/Staf" type="text">
          </div>
        </div>

        <div>
          <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="input-fakultas-unit">Fakultas / Unit <span class="text-rose-500">*</span></label>
          <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition" id="input-fakultas-unit" placeholder="Contoh: Fakultas Teknik / Lab Komputasi" required type="text">
        </div>

        <div id="field-password-wrap">
          <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="input-password">Kata Sandi <span class="text-rose-500" id="password-required-mark">*</span></label>
          <div class="relative">
            <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition pr-10" id="input-password" placeholder="Minimal 8 karakter" type="password">
            <button class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-600 transition" id="toggle-password" type="button" aria-label="Tampilkan kata sandi">
              <span class="material-symbols-outlined text-[18px]">visibility</span>
            </button>
          </div>
          <p id="password-hint" class="text-[11px] text-slate-400 mt-1.5">Wajib diisi untuk akun baru.</p>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2 border-t border-slate-100">
          <button type="button" id="btn-cancel-modal" class="px-5 py-2.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-800 hover:bg-slate-200/60 border border-slate-200 transition-colors">Batal</button>
          <button type="submit" id="btn-submit-user" class="px-5 py-2.5 rounded-xl text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition-all active:scale-[0.98]">Simpan Akun</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal Ekspor -->
<div id="modal-export" class="fixed inset-0 z-[100] hidden">
  <div id="modal-export-overlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity duration-300"></div>
  <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
    <div id="modal-export-content" class="bg-white rounded-2xl shadow-2xl max-w-md w-full border border-slate-100 overflow-hidden flex flex-col transition-all pointer-events-auto transform duration-300 scale-95 opacity-0 translate-y-4">
      <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
        <div>
          <h3 class="text-base font-bold text-slate-900 leading-tight">Ekspor Data Pengguna</h3>
          <p class="text-xs text-slate-500 mt-0.5">Ekspor daftar pengguna yang sedang ditampilkan.</p>
        </div>
        <button class="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors" id="btn-close-export" type="button"><span class="material-symbols-outlined text-[20px]">close</span></button>
      </div>
      <div class="p-6 space-y-4">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2.5">Format Berkas</label>
          <div class="grid grid-cols-2 gap-2.5" id="export-format-group">
            <label class="export-format-option relative flex flex-col p-3 rounded-xl border-2 border-blue-600 bg-blue-50/40 cursor-pointer transition-all" data-format="csv">
              <input checked class="sr-only" name="export_format" type="radio" value="csv"/>
              <span class="text-xs font-bold text-slate-900">CSV</span>
              <span class="text-[10px] text-slate-500 mt-0.5">Kompatibel Excel</span>
            </label>
            <label class="export-format-option relative flex flex-col p-3 rounded-xl border border-slate-200 bg-white cursor-pointer transition-all" data-format="xlsx">
              <input class="sr-only" name="export_format" type="radio" value="xlsx"/>
              <span class="text-xs font-bold text-slate-800">Excel (.xlsx)</span>
              <span class="text-[10px] text-slate-400 mt-0.5">Via CSV kompatibel</span>
            </label>
          </div>
        </div>
        <p class="text-[11px] text-slate-500">Ekspor mengikuti filter pencarian/role/status yang aktif saat ini.</p>
      </div>
      <div class="px-6 py-4 bg-slate-50/90 border-t border-slate-100 flex items-center justify-end gap-2.5">
        <button class="px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 font-semibold text-xs" id="btn-cancel-export" type="button">Batal</button>
        <button class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs shadow-sm flex items-center gap-2" id="btn-do-export" type="button">
          <span class="material-symbols-outlined text-[16px]">file_download</span><span>Unduh</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var modal = document.getElementById('modal-tambah-user');
  var modalOverlay = document.getElementById('modal-overlay');
  var modalContent = document.getElementById('modal-content');
  var form = document.getElementById('form-tambah-user');
  var btnOpen = document.getElementById('btn-open-modal');
  var btnClose = document.getElementById('btn-close-modal');
  var btnCancel = document.getElementById('btn-cancel-modal');
  var submitBtn = document.getElementById('btn-submit-user');
  var modalTitle = document.getElementById('modal-user-title');
  var modalSubtitle = document.getElementById('modal-user-subtitle');
  var passwordInput = document.getElementById('input-password');
  var passwordHint = document.getElementById('password-hint');
  var passwordRequiredMark = document.getElementById('password-required-mark');
  var editingId = null;

  function $(id) { return document.getElementById(id); }
  function val(id, v) { var el = $(id); if (!el) return; if (arguments.length > 1) el.value = v == null ? '' : v; return el.value; }
  function esc(s) { return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  function setMode(mode) {
    var isEdit = mode === 'edit';
    modalTitle.textContent = isEdit ? 'Ubah Akun Pengguna' : 'Tambah Akun Pengguna';
    modalSubtitle.textContent = isEdit ? 'Perbarui informasi kredensial dan hak akses civitas laboratorium' : 'Lengkapi informasi kredensial dan hak akses civitas laboratorium';
    submitBtn.textContent = isEdit ? 'Simpan Perubahan' : 'Simpan Akun';
    submitBtn.dataset.mode = isEdit ? 'edit' : 'tambah';
    passwordInput.required = !isEdit;
    passwordInput.placeholder = isEdit ? 'Kosongkan jika tidak diubah' : 'Minimal 8 karakter';
    passwordInput.value = '';
    passwordRequiredMark.classList.toggle('hidden', isEdit);
    passwordHint.textContent = isEdit ? 'Kosongkan jika tidak ingin mengubah kata sandi.' : 'Wajib diisi untuk akun baru (min. 8 karakter).';
  }

  function openModal(mode) {
    setMode(mode || 'tambah');
    modal.classList.remove('hidden');
    void modal.offsetWidth;
    modalContent.classList.remove('scale-95','opacity-0','translate-y-4');
    modalContent.classList.add('scale-100','opacity-100','translate-y-0');
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    modalContent.classList.remove('scale-100','opacity-100','translate-y-0');
    modalContent.classList.add('scale-95','opacity-0','translate-y-4');
    setTimeout(function () {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      form.reset();
      editingId = null;
      setMode('tambah');
    }, 250);
  }

  btnOpen.addEventListener('click', function () { editingId = null; form.reset(); val('select-status','Aktif'); openModal('tambah'); });
  btnClose.addEventListener('click', closeModal);
  btnCancel.addEventListener('click', closeModal);
  modalOverlay.addEventListener('click', closeModal);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal(); });

  $('toggle-password').addEventListener('click', function () {
    var hidden = passwordInput.type === 'password';
    passwordInput.type = hidden ? 'text' : 'password';
    this.querySelector('.material-symbols-outlined').textContent = hidden ? 'visibility_off' : 'visibility';
  });

  function rowData(row) {
    return {
      id: row.dataset.id,
      nama_lengkap: row.dataset.nama || '',
      username: row.dataset.username || '',
      email: row.dataset.email || '',
      nip_nim: row.dataset.nip || '',
      role: row.dataset.role || 'user',
      tipe_pengguna: row.dataset.tipe || '',
      fakultas_unit: row.dataset.fakultas || '',
      status_akun: row.dataset.status || 'Aktif'
    };
  }

  function fillForm(d) {
    val('input-user-id', d.id || '');
    val('input-nama-lengkap', d.nama_lengkap);
    val('input-nip-nim', d.nip_nim);
    val('input-username', d.username);
    val('input-email', d.email);
    val('select-role', d.role);
    val('select-status', d.status_akun);
    val('input-tipe-pengguna', d.tipe_pengguna);
    val('input-fakultas-unit', d.fakultas_unit);
  }

  function collectPayload() {
    return {
      nama_lengkap: val('input-nama-lengkap').trim(),
      nip_nim: val('input-nip-nim').trim(),
      username: val('input-username').trim().replace(/^@+/, ''),
      email: val('input-email').trim(),
      role: val('select-role'),
      status_akun: val('select-status'),
      tipe_pengguna: val('input-tipe-pengguna').trim(),
      fakultas_unit: val('input-fakultas-unit').trim(),
      password: val('input-password')
    };
  }

  async function api(url, options) {
    var res = await fetch(url, Object.assign({ headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' } }, options || {}));
    var data = await res.json().catch(function () { return {}; });
    if (!res.ok || data.ok === false) throw new Error(data.message || 'Permintaan gagal.');
    return data;
  }

  function roleLabel(role) { return role === 'admin' ? 'Admin' : (role === 'petugas' ? 'Petugas' : 'User'); }
  function statusMeta(status) {
    if (status === 'Aktif') return { text: 'text-emerald-600', dot: 'bg-emerald-500' };
    if (status === 'Pending') return { text: 'text-amber-600', dot: 'bg-amber-500' };
    return { text: 'text-rose-600', dot: 'bg-rose-500' };
  }
  function fmtTanggal(iso) {
    var d = iso ? new Date(iso) : null;
    if (!d || isNaN(d.getTime())) return { tanggal: '-', jam: '' };
    return {
      tanggal: d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }),
      jam: d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WIB'
    };
  }

  function renderRow(u, idx) {
    var tgl = fmtTanggal(u.created_at);
    var sm = statusMeta(u.status_akun);
    return '<tr class="hover:bg-slate-50/80 transition-colors duration-150 group user-row"' +
      ' data-id="'+esc(u.id)+'" data-nama="'+esc(u.nama_lengkap)+'" data-username="'+esc(u.username)+'" data-email="'+esc(u.email)+'"' +
      ' data-nip="'+esc(u.nip_nim)+'" data-role="'+esc(u.role)+'" data-tipe="'+esc(u.tipe_pengguna||'')+'"' +
      ' data-fakultas="'+esc(u.fakultas_unit||'')+'" data-status="'+esc(u.status_akun)+'">' +
      '<td class="w-12 px-3 py-3.5 text-center font-mono text-xs text-slate-400 row-no">'+String(idx+1).padStart(2,'0')+'</td>' +
      '<td class="w-36 px-4 py-3.5 font-mono text-xs font-semibold text-slate-700 whitespace-nowrap">'+esc(u.nip_nim||'-')+'</td>' +
      '<td class="min-w-[280px] w-[320px] px-4 py-3.5 whitespace-nowrap"><div class="flex flex-col whitespace-nowrap">' +
        '<span class="font-bold text-slate-900 leading-tight whitespace-nowrap">'+esc(u.nama_lengkap)+'</span>' +
        '<span class="text-[11px] text-slate-400 mt-0.5 whitespace-nowrap">@'+esc(u.username)+' • '+esc(u.email)+'</span></div></td>' +
      '<td class="min-w-[120px] px-4 py-3.5 text-slate-600 font-medium text-xs whitespace-nowrap">'+esc(roleLabel(u.role))+'</td>' +
      '<td class="min-w-[160px] px-4 py-3.5 text-slate-600 text-xs whitespace-nowrap">'+esc(u.fakultas_unit||'-')+'</td>' +
      '<td class="py-3.5 px-4 text-xs font-mono text-slate-700 whitespace-nowrap min-w-[140px]"><div class="font-medium">'+esc(tgl.tanggal)+'</div><div class="text-slate-400">'+esc(tgl.jam)+'</div></td>' +
      '<td class="min-w-[120px] pl-6 pr-3 py-3.5 whitespace-nowrap"><div class="inline-flex items-center gap-2 text-xs font-semibold '+sm.text+'"><span class="w-2 h-2 rounded-full '+sm.dot+' shrink-0"></span><span>'+esc(u.status_akun)+'</span></div></td>' +
      '<td class="min-w-[90px] w-24 px-4 py-3.5 text-center"><div class="inline-flex items-center justify-center gap-1.5">' +
        '<button class="p-1.5 rounded-lg text-slate-400 hover:text-brand-700 hover:bg-blue-50 transition-colors btn-edit-user" title="Ubah Akun" type="button"><span class="material-symbols-outlined text-[18px]">edit</span></button>' +
        '<button class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors btn-delete-user" title="Hapus Akun" type="button"><span class="material-symbols-outlined text-[18px]">delete</span></button>' +
      '</div></td></tr>';
  }

  function renumber() {
    document.querySelectorAll('#users-tbody tr.user-row').forEach(function (tr, i) {
      var no = tr.querySelector('.row-no'); if (no) no.textContent = String(i + 1).padStart(2, '0');
    });
  }

  function bindRowActions(scope) {
    (scope || document).querySelectorAll('.btn-edit-user').forEach(function (btn) {
      btn.onclick = function () {
        var row = btn.closest('tr');
        var d = rowData(row);
        editingId = d.id;
        fillForm(d);
        openModal('edit');
      };
    });
    (scope || document).querySelectorAll('.btn-delete-user').forEach(function (btn) {
      btn.onclick = function () {
        var row = btn.closest('tr');
        var d = rowData(row);
        window.sipatModal.confirm({
          title: 'Hapus Akun Pengguna?',
          subtitle: 'Tindakan ini tidak dapat dibatalkan.',
          tone: 'danger',
          message: '<div class="text-sm text-slate-700 space-y-2">' +
            '<p>Apakah Anda yakin ingin menghapus akun pengguna ini?</p>' +
            '<div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">' +
            '<p class="font-semibold text-slate-900">' + esc(d.nama_lengkap) + '</p>' +
            '<p class="font-mono text-xs text-slate-500">@' + esc(d.username) + ' • ' + esc(d.email) + '</p>' +
            '<p class="text-xs text-slate-500">' + esc(roleLabel(d.role)) + ' • ' + esc(d.fakultas_unit || '-') + '</p>' +
            '</div></div>',
          confirmText: 'Hapus Akun',
          cancelText: 'Batal',
          loadingText: 'Menghapus...',
          onConfirm: async function () {
            await api('/admin/users/' + encodeURIComponent(d.id) + '/delete', { method: 'POST', body: '{}' });
            row.remove();
            renumber();
            var shown = document.querySelectorAll('#users-tbody tr.user-row').length;
            var countShown = $('count-shown'); if (countShown) countShown.textContent = shown;
            var countTotal = $('count-total'); if (countTotal) countTotal.textContent = Math.max(0, (parseInt(countTotal.textContent.replace(/\./g,''),10)||1) - 1).toLocaleString('id-ID');
            var statTotal = $('stat-total'); if (statTotal) statTotal.textContent = countTotal.textContent;
            window.sipatModal.toast('Akun ' + d.nama_lengkap + ' berhasil dihapus.', 'success');
            if (!shown) location.reload();
          }
        });
      };
    });
  }

  bindRowActions(document);

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    var payload = collectPayload();
    if (!payload.nama_lengkap || !payload.nip_nim || !payload.username || !payload.email || !payload.role || !payload.fakultas_unit) {
      window.sipatModal.alert({ title: 'Data belum lengkap', message: 'Nama, NIP/NIM, username, email, role, dan fakultas/unit wajib diisi.', tone: 'warning' });
      return;
    }
    var isEdit = !!editingId;
    if (!isEdit && payload.password.length < 8) {
      window.sipatModal.alert({ title: 'Kata sandi tidak valid', message: 'Kata sandi minimal 8 karakter untuk akun baru.', tone: 'warning' });
      return;
    }
    if (isEdit && payload.password && payload.password.length < 8) {
      window.sipatModal.alert({ title: 'Kata sandi tidak valid', message: 'Jika diisi, kata sandi minimal 8 karakter.', tone: 'warning' });
      return;
    }
    var original = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Menyimpan...';
    try {
      var url = isEdit ? '/admin/users/' + encodeURIComponent(editingId) : '/admin/users';
      var data = await api(url, { method: 'POST', body: JSON.stringify(payload) });
      var u = data.data || data.item || payload;
      if (isEdit) {
        var row = document.querySelector('tr.user-row[data-id="' + CSS.escape(String(editingId)) + '"]');
        if (row) { row.outerHTML = renderRow(u, 0); renumber(); bindRowActions(document.getElementById('users-tbody')); }
        window.sipatModal.toast('Akun ' + (u.nama_lengkap || payload.nama_lengkap) + ' berhasil diperbarui.', 'success');
      } else {
        window.sipatModal.toast('Akun ' + (u.nama_lengkap || payload.nama_lengkap) + ' berhasil ditambahkan.', 'success');
        closeModal();
        location.reload();
        return;
      }
      closeModal();
    } catch (err) {
      window.sipatModal.alert({ title: 'Gagal menyimpan akun', message: err.message || 'Terjadi kesalahan.', tone: 'danger' });
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = original;
    }
  });

  // Export modal
  var exportModal = $('modal-export');
  var exportOverlay = $('modal-export-overlay');
  var exportContent = $('modal-export-content');
  function openExport() { exportModal.classList.remove('hidden'); void exportContent.offsetWidth; exportContent.classList.remove('scale-95','opacity-0','translate-y-4'); exportContent.classList.add('scale-100','opacity-100','translate-y-0'); document.body.style.overflow='hidden'; }
  function closeExport() { exportContent.classList.remove('scale-100','opacity-100','translate-y-0'); exportContent.classList.add('scale-95','opacity-0','translate-y-4'); setTimeout(function(){ exportModal.classList.add('hidden'); document.body.style.overflow=''; }, 250); }
  $('btn-open-export').addEventListener('click', openExport);
  $('btn-close-export').addEventListener('click', closeExport);
  $('btn-cancel-export').addEventListener('click', closeExport);
  exportOverlay.addEventListener('click', closeExport);

  document.querySelectorAll('.export-format-option').forEach(function (opt) {
    opt.querySelector('input').addEventListener('change', function () {
      document.querySelectorAll('.export-format-option').forEach(function (o) { o.classList.remove('border-2','border-blue-600','bg-blue-50/40'); o.classList.add('border','border-slate-200','bg-white'); });
      opt.classList.remove('border','border-slate-200','bg-white'); opt.classList.add('border-2','border-blue-600','bg-blue-50/40');
    });
  });

  $('btn-do-export').addEventListener('click', function () {
    var rows = Array.prototype.slice.call(document.querySelectorAll('#users-tbody tr.user-row'));
    var csv = ['NIP/NIM,Nama Lengkap,Username,Email,Role,Tipe Pengguna,Fakultas/Unit,Status,Tanggal Dibuat'];
    rows.forEach(function (r) {
      var d = rowData(r);
      var tds = r.querySelectorAll('td');
      var tgl = tds[5] ? tds[5].innerText.replace(/\n/g,' ').trim() : '';
      csv.push([d.nip_nim,d.nama_lengkap,d.username,d.email,roleLabel(d.role),d.tipe_pengguna,d.fakultas_unit,d.status_akun,tgl].map(function(v){
        v = String(v==null?'':v).replace(/"/g,'""'); return /[",\n]/.test(v) ? '"'+v+'"' : v;
      }).join(','));
    });
    var blob = new Blob(['\uFEFF' + csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'users-export-' + new Date().toISOString().slice(0,10) + '.csv';
    document.body.appendChild(a); a.click(); a.remove();
    window.sipatModal.toast('Data pengguna berhasil diekspor.', 'success');
    closeExport();
  });
});
</script>
