<!-- Script Interactivity Modal Tambah User -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const modal = document.getElementById('modal-tambah-user');
  const modalOverlay = document.getElementById('modal-overlay');
  const modalContent = document.getElementById('modal-content');
  const btnOpenModal = document.getElementById('btn-open-modal');
  const btnCloseModal = document.getElementById('btn-close-modal');
  const btnCancelModal = document.getElementById('btn-cancel-modal');
  const formTambahUser = document.getElementById('form-tambah-user');
  const submitBtn = document.getElementById('btn-submit-user');
  const modalTitle = document.getElementById('modal-user-title');
  const modalSubtitle = document.getElementById('modal-user-subtitle');
  const modalIcon = document.getElementById('modal-user-icon');
  const passwordInput = document.getElementById('input-password');
  const passwordHint = document.getElementById('password-hint');
  const passwordRequiredMark = document.getElementById('password-required-mark');
  let editingRow = null;

  const wait = function (ms) { return new Promise(function (resolve) { setTimeout(resolve, ms); }); };

  function setMode(mode) {
    const isEdit = mode === 'edit';
    if (submitBtn) submitBtn.dataset.mode = isEdit ? 'edit' : 'tambah';
    if (modalTitle) modalTitle.textContent = isEdit ? 'Ubah Akun Pengguna' : 'Tambah Akun Pengguna';
    if (modalSubtitle) modalSubtitle.textContent = isEdit
      ? 'Perbarui informasi kredensial dan hak akses civitas laboratorium'
      : 'Lengkapi informasi kredensial dan hak akses civitas laboratorium';
    if (modalIcon) modalIcon.textContent = isEdit ? 'manage_accounts' : 'person_add';
    if (submitBtn) submitBtn.textContent = isEdit ? 'Simpan Perubahan' : 'Simpan Akun';
    if (passwordInput) {
      passwordInput.required = !isEdit;
      passwordInput.value = '';
      passwordInput.placeholder = isEdit ? 'Kosongkan jika tidak diubah' : 'Minimal 8 karakter';
    }
    if (passwordRequiredMark) passwordRequiredMark.classList.toggle('hidden', isEdit);
    if (passwordHint) passwordHint.textContent = isEdit ? 'Kosongkan jika tidak ingin mengubah kata sandi.' : 'Wajib diisi untuk akun baru.';
  }

  function openModal(mode) {
    setMode(mode || 'tambah');
    modal.classList.remove('hidden');
    void modal.offsetWidth;
    modalContent.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
    modalContent.classList.add('scale-100', 'opacity-100', 'translate-y-0');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modalContent.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
    modalContent.classList.add('scale-95', 'opacity-0', 'translate-y-4');
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      if (formTambahUser) formTambahUser.reset();
      editingRow = null;
      setMode('tambah');
    }, 300);
  }

  function openAddModal() {
    editingRow = null;
    if (formTambahUser) formTambahUser.reset();
    const status = document.getElementById('select-status');
    if (status) status.value = 'Aktif';
    openModal('tambah');
  }

  if (btnOpenModal) btnOpenModal.addEventListener('click', openAddModal);
  if (btnCloseModal) btnCloseModal.addEventListener('click', closeModal);
  if (btnCancelModal) btnCancelModal.addEventListener('click', closeModal);
  if (modalOverlay) modalOverlay.addEventListener('click', closeModal);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  const togglePassword = document.getElementById('toggle-password');
  if (togglePassword && passwordInput) {
    togglePassword.addEventListener('click', function () {
      const isHidden = passwordInput.type === 'password';
      passwordInput.type = isHidden ? 'text' : 'password';
      const icon = togglePassword.querySelector('.material-symbols-outlined');
      if (icon) icon.textContent = isHidden ? 'visibility_off' : 'visibility';
    });
  }

  // =============================================
  // Modal Ekspor Data
  // =============================================
  const exportModal = document.getElementById('modal-export');
  const exportModalOverlay = document.getElementById('modal-export-overlay');
  const exportModalContent = document.getElementById('modal-export-content');
  const btnOpenExport = document.getElementById('btn-open-export');
  const btnCloseExport = document.getElementById('btn-close-export');
  const btnCancelExport = document.getElementById('btn-cancel-export');

  function openExportModal() {
    exportModal.classList.remove('hidden');
    void exportModalContent.offsetWidth;
    exportModalContent.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
    exportModalContent.classList.add('scale-100', 'opacity-100', 'translate-y-0');
    document.body.style.overflow = 'hidden';
  }

  function closeExportModal() {
    exportModalContent.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
    exportModalContent.classList.add('scale-95', 'opacity-0', 'translate-y-4');
    setTimeout(() => {
      exportModal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  }

  if (btnOpenExport) {
    btnOpenExport.addEventListener('click', function(e) {
      e.preventDefault();
      openExportModal();
    });
  }

  if (btnCloseExport) btnCloseExport.addEventListener('click', closeExportModal);
  if (btnCancelExport) btnCancelExport.addEventListener('click', closeExportModal);
  if (exportModalOverlay) exportModalOverlay.addEventListener('click', closeExportModal);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && exportModal && !exportModal.classList.contains('hidden')) {
      closeExportModal();
    }
  });

  // Format pilihan ekspor (highlight kartu terpilih)
  const formatOptions = document.querySelectorAll('.export-format-option');
  formatOptions.forEach(function(option) {
    const radio = option.querySelector('input[type="radio"]');
    if (radio) {
      radio.addEventListener('change', function() {
        formatOptions.forEach(function(opt) {
          opt.classList.remove('border-2', 'border-blue-600', 'bg-blue-50/40', 'shadow-xs');
          opt.classList.add('border', 'border-slate-200', 'bg-white');
        });
        option.classList.remove('border', 'border-slate-200', 'bg-white');
        option.classList.add('border-2', 'border-blue-600', 'bg-blue-50/40', 'shadow-xs');
      });
    }
  });

  // Toggle dropdown cakupan data
  const btnToggleExportScope = document.getElementById('btn-toggle-export-scope');
  const exportScopeDropdown = document.getElementById('export-scope-dropdown');
  const exportScopeArrow = document.getElementById('export-scope-arrow');

  if (btnToggleExportScope && exportScopeDropdown) {
    btnToggleExportScope.addEventListener('click', function() {
      const isHidden = exportScopeDropdown.classList.toggle('hidden');
      if (exportScopeArrow) {
        exportScopeArrow.textContent = isHidden ? 'keyboard_arrow_down' : 'keyboard_arrow_up';
      }
    });
  }

  // Pilih semua / reset pilihan baris
  const exportSelectAll = document.getElementById('export-select-all');
  const exportRowChecks = document.querySelectorAll('.export-row-check');
  const exportResetSelection = document.getElementById('export-reset-selection');

  if (exportSelectAll) {
    exportSelectAll.addEventListener('change', function() {
      exportRowChecks.forEach(function(cb) { cb.checked = exportSelectAll.checked; });
    });
  }

  if (exportResetSelection) {
    exportResetSelection.addEventListener('click', function() {
      exportRowChecks.forEach(function(cb) { cb.checked = false; });
      if (exportSelectAll) exportSelectAll.checked = false;
    });
  }

  // =============================================
  // Tabel: edit / hapus
  // =============================================
  const textOf = function (el) { return el ? (el.textContent || '').replace(/\s+/g, ' ').trim() : ''; };

  function readUserRow(row) {
    const cells = row ? row.querySelectorAll('td') : [];
    const nameCell = cells[2];
    const spans = nameCell ? nameCell.querySelectorAll('span') : [];
    const identity = textOf(spans[1]);
    const parts = identity.split('•').map(function (s) { return s.trim(); });
    const username = (parts[0] || '').replace(/^@/, '');
    const email = parts[1] || '';
    return {
      nip: textOf(cells[1]),
      nama: textOf(spans[0]),
      username: username,
      email: email,
      role: textOf(cells[3]),
      fakultas: textOf(cells[4]),
      status: textOf(cells[6])
    };
  }

  function statusTone(status) {
    if (status === 'Aktif') return { text: 'text-emerald-600', dot: 'bg-emerald-500' };
    if (status === 'Suspend') return { text: 'text-rose-600', dot: 'bg-rose-500' };
    if (status === 'Pending') return { text: 'text-amber-600', dot: 'bg-amber-500' };
    return { text: 'text-slate-500', dot: 'bg-slate-400' };
  }

  function setStatusCell(cell, status) {
    if (!cell) return;
    const wrap = cell.querySelector('div');
    if (!wrap) return;
    const tone = statusTone(status);
    wrap.className = 'inline-flex items-center gap-2 text-xs font-semibold whitespace-nowrap ' + tone.text;
    const dot = wrap.querySelector('span:first-child');
    const label = wrap.querySelector('span:last-child');
    if (dot) dot.className = 'w-1.5 h-1.5 rounded-full ' + tone.dot;
    if (label) label.textContent = status || '-';
  }

  function setRowData(row, data) {
    const cells = row.querySelectorAll('td');
    const nama = String(data.nama || '').trim();
    const username = String(data.username || '').replace(/^@/, '').trim();
    const usernameAt = username ? '@' + username : '';
    const email = String(data.email || '').trim();
    const identity = usernameAt + (email ? ' • ' + email : '');

    if (cells[1]) cells[1].textContent = data.nip || '-';
    if (cells[2]) {
      const spans = cells[2].querySelectorAll('span');
      if (spans[0]) spans[0].textContent = nama || '-';
      if (spans[1]) spans[1].textContent = identity || '-';
    }
    if (cells[3]) cells[3].textContent = data.role || '-';
    if (cells[4]) cells[4].textContent = data.fakultas || '-';
    setStatusCell(cells[6], data.status || 'Aktif');

    row.querySelectorAll('button[title="Ubah Akun"], button[title="Edit"]').forEach(function (button) {
      button.dataset.nama = nama;
      button.dataset.username = usernameAt;
      button.dataset.role = data.role || '';
    });
    row.querySelectorAll('button[title="Hapus Akun"], button[title="Hapus"]').forEach(function (button) {
      button.dataset.nama = nama;
      button.dataset.username = usernameAt;
    });
  }

  function setField(id, value) {
    const el = document.getElementById(id);
    if (el) el.value = value == null ? '' : value;
  }

  function openEditModal(row) {
    if (!row) return;
    editingRow = row;
    const data = readUserRow(row);
    setField('input-user-id', row.dataset.userId || '');
    setField('input-nama-lengkap', data.nama);
    setField('input-nip-nim', data.nip);
    setField('input-username', data.username);
    setField('input-email', data.email);
    setField('select-role', data.role);
    setField('select-status', data.status || 'Aktif');
    setField('input-fakultas-unit', data.fakultas);
    openModal('edit');
  }

  document.querySelectorAll('button[title="Edit"], button[title="Ubah Akun"]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      openEditModal(btn.closest('tr'));
    });
  });

  if (formTambahUser) {
    formTambahUser.addEventListener('submit', async function (e) {
      e.preventDefault();
      const mode = submitBtn ? (submitBtn.dataset.mode || 'tambah') : 'tambah';
      const nama = (document.getElementById('input-nama-lengkap') || {}).value || '';
      const nip = (document.getElementById('input-nip-nim') || {}).value || '';
      const username = ((document.getElementById('input-username') || {}).value || '').replace(/^@/, '').trim();
      const email = (document.getElementById('input-email') || {}).value || '';
      const role = (document.getElementById('select-role') || {}).value || '';
      const status = (document.getElementById('select-status') || {}).value || 'Aktif';
      const fakultas = (document.getElementById('input-fakultas-unit') || {}).value || '';
      const password = (document.getElementById('input-password') || {}).value || '';

      if (!nama.trim() || !nip.trim() || !username || !email.trim() || !role || !fakultas.trim()) {
        window.sipatModal.alert({
          title: 'Data belum lengkap',
          subtitle: 'Periksa kembali isian formulir.',
          message: 'Nama, NIP/NIM, username, email, role, dan fakultas/unit wajib diisi.',
          tone: 'warning'
        });
        return;
      }
      if (mode === 'tambah' && !password.trim()) {
        window.sipatModal.alert({
          title: 'Kata sandi wajib diisi',
          subtitle: 'Akun baru memerlukan kata sandi.',
          message: 'Isi kata sandi minimal 8 karakter untuk akun baru.',
          tone: 'warning'
        });
        return;
      }

      const originalText = submitBtn ? submitBtn.textContent : '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = mode === 'edit' ? 'Menyimpan...' : 'Menyimpan...';
      }

      try {
        await wait(550);
        if (mode === 'edit') {
          if (!editingRow || !editingRow.parentNode) throw new Error('Data pengguna tidak ditemukan atau sudah dihapus.');
          setRowData(editingRow, { nip: nip, nama: nama, username: username, email: email, role: role, fakultas: fakultas, status: status });
          window.sipatModal.toast('Data akun ' + nama + ' berhasil diperbarui.', 'success');
        } else {
          window.sipatModal.toast('Akun ' + nama + ' berhasil ditambahkan.', 'success');
          // Optional: prepend row; for now keep simple and close modal.
        }
        closeModal();
      } catch (err) {
        window.sipatModal.alert({
          title: 'Gagal menyimpan akun',
          subtitle: 'Periksa data lalu coba lagi.',
          message: (err && err.message) ? err.message : 'Terjadi kesalahan saat menyimpan data akun.',
          tone: 'danger'
        });
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText || (mode === 'edit' ? 'Simpan Perubahan' : 'Simpan Akun');
        }
      }
    });
  }

  function renumberRows() {
    const tbody = document.querySelector('table tbody');
    if (!tbody) return;
    Array.prototype.forEach.call(tbody.querySelectorAll('tr'), function (row, index) {
      const first = row.querySelector('td');
      if (first) first.textContent = String(index + 1).padStart(2, '0');
    });
  }

  document.querySelectorAll('button[title="Hapus Akun"], button[title="Hapus"]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const row = btn.closest('tr');
      const data = readUserRow(row);
      const identity = '@' + String(data.username || '').replace(/^@/, '') + (data.email ? ' • ' + data.email : '');

      window.sipatModal.confirm({
        title: 'Hapus Akun Pengguna?',
        subtitle: 'Tindakan ini tidak dapat dibatalkan.',
        tone: 'danger',
        message: '<div class="text-sm text-slate-700 space-y-2">' +
          '<p>Apakah Anda yakin ingin menghapus akun pengguna ini dari sistem?</p>' +
          '<div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">' +
          '<p class="font-semibold text-slate-900">' + window.sipatModal.escape(data.nama || '-') + '</p>' +
          '<p class="font-mono text-xs text-slate-500">' + window.sipatModal.escape(identity) + '</p>' +
          '<p class="text-xs text-slate-500">' + window.sipatModal.escape(data.role || '-') + ' • ' + window.sipatModal.escape(data.fakultas || '-') + '</p>' +
          '</div></div>',
        confirmText: 'Hapus Akun',
        cancelText: 'Batal',
        loadingText: 'Menghapus...',
        onConfirm: async function () {
          await wait(550);
          if (!row || !row.parentNode) throw new Error('Data pengguna tidak ditemukan atau sudah dihapus.');
          row.style.transition = 'opacity 0.18s ease, transform 0.18s ease';
          row.style.opacity = '0';
          row.style.transform = 'translateY(-4px)';
          await wait(180);
          row.remove();
          renumberRows();
          window.sipatModal.toast('Akun ' + (data.nama || identity) + ' berhasil dihapus.', 'success');
        }
      });
    });
  });
});
</script>
