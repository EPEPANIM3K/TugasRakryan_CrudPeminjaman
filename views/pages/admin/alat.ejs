<!-- Main Content -->
<div class="flex flex-col w-full space-y-6">
  <!-- Header Section -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-semibold text-brand-700 tracking-wider uppercase">Manajemen Inventaris Laboratorium</span>
      </div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Kelola Alat & Barang</h1>
      <p class="text-sm text-slate-500 mt-1">Daftar seluruh instrumen, peralatan laboratorium, dan ketersediaan stok fisik.</p>
    </div>
    <!-- Action Buttons Right-Aligned -->
    <div class="flex flex-wrap items-center gap-2.5 shrink-0">
      <button class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold text-sm shadow-sm hover:bg-blue-700 transition-all active:scale-[0.99]" id="btn-open-form-alat" type="button">
        <span class="material-symbols-outlined text-[18px]">add</span>
        <span>Tambah Alat</span>
      </button>
      <button class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 text-sm font-semibold transition-colors shadow-sm" id="btn-open-export" type="button">
        <span class="material-symbols-outlined text-[18px] text-slate-500">file_download</span>
        <span class="">Ekspor Excel</span>
      </button>

    </div>
  </div>

  <!-- Statistic Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <!-- Card 1: Total Alat -->
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-blue-50 text-brand-700">Statistik Alat</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight"><%= stats.total.toLocaleString('id-ID') %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Tersebar di <%= stats.lab %> Laboratorium Aktif</div>
      </div>
    </div>
    <!-- Card 2: Kondisi Baik -->
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-50 text-emerald-700">Kondisi Baik</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight"><%= stats.baik.toLocaleString('id-ID') %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Unit Siap Pakai & Terkalibrasi</div>
      </div>
    </div>
    <!-- Card 3: Sedang Dipinjam -->
    <div class="bg-white rounded-xl p-5 border border-slate-100 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-violet-50 text-violet-700">Sedang Dipinjam</span>
      </div>
      <div class="my-2">
        <div class="text-3xl font-extrabold text-slate-900 tracking-tight"><%= stats.dipinjam.toLocaleString('id-ID') %></div>
        <div class="text-xs font-medium text-slate-400 mt-1">Oleh Mahasiswa & Riset Dosen</div>
      </div>
    </div>
  </div>

  <!-- Search & Filter Toolbar -->
  <div class="rounded-xl flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">
    <div class="relative flex-1">
      <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none select-none">search</span>
      <input class="w-full pl-10 pr-4 h-10 border border-slate-200 text-slate-700 text-sm rounded-lg placeholder-slate-400 focus:outline-none focus:bg-white focus:border-brand-700 transition-colors bg-white" placeholder="Cari nama alat, kode inventaris, atau merk..." type="text">
    </div>
    <div class="flex flex-col sm:flex-row items-center gap-3">
      <div class="relative w-full sm:w-auto min-w-[200px]">
        <select class="w-full h-10 appearance-none pl-3.5 pr-9 bg-white border border-slate-200 text-slate-700 text-sm rounded-lg cursor-pointer focus:outline-none focus:border-brand-700 transition-colors">
          <option>Semua Kategori</option>
          <option>Elektronika</option>
          <option>Mekanikal</option>
          <option>Optik</option>
          <option>Kimia</option>
          <option>Biologi</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Alat Tabel -->
  <div class="bg-white rounded-xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col">
    <div class="w-full overflow-x-auto max-h-[460px] overflow-y-auto">
      <table class="w-full text-left border-collapse">
        <thead class="sticky top-0 z-10 bg-slate-50 border-b border-slate-200 text-slate-500 uppercase tracking-wider text-[11px] font-semibold">
          <tr>
            <th class="py-3.5 px-4 w-12 text-center pl-6 bg-slate-50 whitespace-nowrap" scope="col">NO</th>
            <th class="py-3.5 px-4 min-w-[120px] bg-slate-50 whitespace-nowrap" scope="col">KODE INVENTARIS</th>
            <th class="py-3.5 px-4 min-w-[280px] w-[320px] bg-slate-50 whitespace-nowrap" scope="col">NAMA ALAT</th>
            <th class="py-3.5 px-4 min-w-[140px] bg-slate-50 whitespace-nowrap" scope="col">KATEGORI</th>
            <th class="py-3.5 px-4 min-w-[160px] bg-slate-50 whitespace-nowrap" scope="col">TEMPAT</th>
            <th class="py-3.5 px-4 min-w-[130px] bg-slate-50 whitespace-nowrap" scope="col">LOKASI RAK</th>
            <th class="py-3.5 px-4 min-w-[140px] bg-slate-50 whitespace-nowrap" scope="col">TANGGAL MASUK</th>
            <th class="py-3.5 px-4 w-28 bg-slate-50 whitespace-nowrap text-center" scope="col">STOK</th>
            <th class="py-3.5 px-4 text-center min-w-[90px] w-24 pr-6 bg-slate-50 whitespace-nowrap" scope="col">AKSI</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm text-slate-700 bg-white">
        <% items.forEach(function (item, index) { var tgl = formatTanggal(item.created_at); %>
        <tr class="hover:bg-slate-50/80 transition-colors group">
          <td class="py-3.5 px-4 text-center text-slate-400 font-mono text-xs pl-6"><%= String(index + 1).padStart(2, '0') %></td>
          <td class="py-3.5 px-4 font-mono font-semibold text-brand-700 text-xs whitespace-nowrap"><%= item.kode_alat %></td>
          <td class="py-3.5 px-4 whitespace-nowrap min-w-[280px] w-[320px]">
              <div class="font-bold text-slate-900 leading-tight whitespace-nowrap"><%= item.nama_alat %></div>
              <div class="text-[11px] text-slate-400 mt-0.5 whitespace-nowrap"><%= item.merk || '-' %></div>
          </td>
          <td class="py-3.5 px-4 text-slate-600 font-medium text-xs whitespace-nowrap min-w-[140px]"><%= item.kategori_nama || '-' %></td>
          <td class="py-3.5 px-4 text-slate-800 font-semibold text-xs whitespace-nowrap min-w-[160px]"><%= item.nama_lab || '-' %></td>
          <td class="py-3.5 px-4 text-slate-600 text-xs whitespace-nowrap min-w-[130px]"><%= item.lokasi_rak || '-' %></td>
          <td class="py-3.5 px-4 text-xs font-mono text-slate-700 whitespace-nowrap min-w-[140px]">
              <div class="font-medium"><%= tgl.tanggal %></div>
              <div class="text-slate-400"><%= tgl.jam %></div>
            </td>
          <td class="py-3.5 px-4 text-center font-bold <%= item.stok_total > 0 ? 'text-emerald-600' : 'text-amber-600' %> text-xs whitespace-nowrap w-28"><%= item.stok_total %> Unit</td>
          <td class="py-3.5 px-4 text-center pr-6 whitespace-nowrap min-w-[90px] w-24">
            <div class="inline-flex items-center justify-center gap-1.5">
              <button class="p-1.5 rounded-lg text-slate-400 hover:text-brand-700 hover:bg-blue-50 transition-colors" title="Edit" type="button"
                data-id="<%= item.id %>" data-kode="<%= item.kode_alat %>" data-nama="<%= item.nama_alat %>"
                data-merek="<%= item.merk || '' %>" data-kategori="<%= item.kategori_nama || '' %>"
                data-ruang="<%= item.nama_lab || '' %>" data-lokasi="<%= item.lokasi_rak || '' %>"
                data-stok="<%= item.stok_total %>" data-foto="<%= item.foto_url || '' %>">
                <span class="material-symbols-outlined text-[18px]">edit</span>
              </button>
              <button class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors" title="Hapus" type="button" data-id="<%= item.id %>" data-kode="<%= item.kode_alat %>" data-nama="<%= item.nama_alat %>">
                <span class="material-symbols-outlined text-[18px]">delete</span>
              </button>
            </div>
          </td>
        </tr>
        <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Form Tambah/Edit Alat -->
<div id="modal-tambah-alat" class="fixed inset-0 z-[100] hidden">
  <!-- Overlay with blur effect -->
  <div id="modal-overlay" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity duration-300"></div>

  <!-- Modal Container -->
  <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
    <div id="modal-content" class="w-full max-w-xl bg-white rounded-2xl shadow-2xl border border-slate-100 flex flex-col overflow-visible pointer-events-auto transform transition-all duration-300 scale-95 opacity-0 translate-y-4">
      <!-- Header Form -->
      <div class="px-6 py-5 border-b border-slate-100 flex items-start justify-between bg-white shrink-0 rounded-t-2xl">
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-lg font-bold text-slate-900 tracking-tight">Tambah Alat Baru</h2>
          </div>
          <p id="modal-subtitle" class="text-xs text-slate-500 mt-1">Lengkapi informasi alat, stok, dan lokasi penyimpanan laboratorium</p>
        </div>
        <button class="p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-full transition-colors" id="btn-close-modal" title="Tutup" type="button">
          <svg fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20" xmlns="http://www.w3.org/2000/svg"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
        </button>
      </div>

      <!-- Body Form -->
      <form class="p-6 space-y-4 text-xs text-slate-700 max-h-[70vh] overflow-y-auto" id="form-tambah-alat" enctype="multipart/form-data">
        <div>
          <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="input-nama-alat">Nama Alat <span class="text-rose-500">*</span></label>
          <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs" id="input-nama-alat" placeholder="Contoh: Oscilloscope Digital 100MHz" required type="text">
        </div>

        <div>
          <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="input-foto-alat">Foto Alat</label>
          <div class="flex items-start gap-4">
            <div class="w-24 h-24 rounded-xl border border-slate-200 bg-slate-50 overflow-hidden shrink-0 flex items-center justify-center">
              <img id="preview-foto-alat" src="/images/alat/placeholder.svg" alt="Preview foto alat" class="w-full h-full object-cover hidden">
              <div id="placeholder-foto-alat" class="flex flex-col items-center justify-center text-slate-400 gap-1">
                <span class="material-symbols-outlined text-[28px]">image</span>
                <span class="text-[10px] font-medium">Preview</span>
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <input class="w-full text-xs text-slate-600 file:mr-3 file:py-2 file:px-3.5 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-brand-700 hover:file:bg-blue-100 cursor-pointer" id="input-foto-alat" name="foto" type="file" accept="image/png,image/jpeg,image/jpg,image/webp">
              <p class="text-[11px] text-slate-400 mt-1.5">Format JPG, PNG, atau WebP. Maks. 2MB. Kosongkan saat edit jika tidak ingin mengubah foto.</p>
              <button type="button" id="btn-remove-foto-alat" class="hidden mt-2 text-[11px] font-semibold text-rose-600 hover:text-rose-700">Hapus foto</button>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <div>
            <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="input-kode-inventaris">Kode Inventaris <span class="text-rose-500">*</span></label>
            <input class="w-full px-4 py-2.5 bg-slate-100 border border-slate-200 rounded-xl text-xs text-slate-500 cursor-not-allowed focus:outline-none" id="input-kode-inventaris" placeholder="Kode otomatis" value="<%= nextKode %>" readonly required type="text" aria-readonly="true" title="Kode inventaris dibuat otomatis">
          </div>
          <div>
            <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="input-merek">Merek</label>
            <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs" id="input-merek" placeholder="Contoh: Tektronix" type="text">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <div>
            <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="category-trigger">Kategori</label>
            <div class="relative" id="category-field">
              <input type="hidden" id="select-category" value="">
              <button type="button" id="category-trigger" class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs text-slate-700 flex items-center justify-between gap-2 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs">
                <span id="category-trigger-label" class="text-slate-400 truncate">Pilih Kategori</span>
                <span class="material-symbols-outlined text-slate-400 text-[18px] shrink-0">expand_more</span>
              </button>
              <div id="category-dropdown" class="hidden absolute z-30 mt-2 w-full bg-white border border-slate-200 rounded-xl shadow-xl overflow-hidden">
                <div id="category-options" class="max-h-56 overflow-y-auto p-1.5 space-y-1"></div>
                <div class="border-t border-slate-100 p-2 bg-slate-50/60">
                  <button type="button" id="category-add-other" class="w-full px-3 py-2 rounded-lg text-xs font-semibold text-brand-700 hover:bg-brand-50 text-left transition-colors inline-flex items-center gap-2">
                    <span class="material-symbols-outlined text-[16px]">add</span>
                    <span>Lain-lain / Tambah kategori</span>
                  </button>
                </div>
              </div>
            </div>
            <div id="category-custom-wrap" class="hidden mt-2">
              <input id="input-category-custom" type="text" placeholder="Tulis kategori baru..." class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs">
              <p class="text-[11px] text-slate-400 mt-1.5">Isi kategori kustom, lalu simpan alat untuk menambahkannya.</p>
            </div>
          </div>
          <div>
            <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="input-stok">Stok <span class="text-rose-500">*</span></label>
            <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs" id="input-stok" placeholder="Contoh: 18" type="number" min="0" required>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <div>
            <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="input-ruang">Tempat / Ruang</label>
            <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs" id="input-ruang" placeholder="Contoh: Ruang RPL / IoT" type="text">
          </div>
          <div>
            <label class="block font-semibold text-slate-800 text-xs mb-1.5" for="input-lokasi-rak">Lokasi Rak / Lemari</label>
            <input class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition shadow-2xs" id="input-lokasi-rak" placeholder="Contoh: Rak A-02" type="text">
          </div>
        </div>
      </form>

      <!-- Footer Form -->
      <div class="px-6 py-4 border-t border-slate-100 bg-slate-50/60 flex items-center justify-end gap-3 shrink-0 rounded-b-2xl">
        <button class="px-5 py-2.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-800 hover:bg-slate-200/60 border border-slate-200 bg-white transition shadow-2xs" id="btn-cancel-modal" type="button">
          Batal
        </button>
        <button class="px-6 py-2.5 rounded-xl text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 transition shadow-sm inline-flex items-center gap-2" form="form-tambah-alat" id="btn-submit-alat" type="submit">
          <span>Simpan Alat</span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Script Interactivity Modal Tambah/Edit Alat & Aksi Tabel -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  const modal = document.getElementById('modal-tambah-alat');
  const modalOverlay = document.getElementById('modal-overlay');
  const modalContent = document.getElementById('modal-content');
  const formTambahAlat = document.getElementById('form-tambah-alat');
  const submitBtn = document.getElementById('btn-submit-alat');
  const modalTitle = document.querySelector('#modal-tambah-alat h2');
  const modalSubtitle = document.getElementById('modal-subtitle');
  const btnOpenModal = document.getElementById('btn-open-form-alat');
  const btnCloseModal = document.getElementById('btn-close-modal');
  const btnCancelModal = document.getElementById('btn-cancel-modal');
  const fotoInput = document.getElementById('input-foto-alat');
  const fotoPreview = document.getElementById('preview-foto-alat');
  const fotoPlaceholder = document.getElementById('placeholder-foto-alat');
  const btnRemoveFoto = document.getElementById('btn-remove-foto-alat');
  let editingRow = null;
  let removeFoto = false;

  const textOf = function (el) { return el ? (el.textContent || '').replace(/\s+/g, ' ').trim() : ''; };

  function setFotoPreview(src) {
    if (!fotoPreview || !fotoPlaceholder) return;
    if (src) {
      fotoPreview.src = src;
      fotoPreview.classList.remove('hidden');
      fotoPlaceholder.classList.add('hidden');
      if (btnRemoveFoto) btnRemoveFoto.classList.remove('hidden');
    } else {
      fotoPreview.removeAttribute('src');
      fotoPreview.classList.add('hidden');
      fotoPlaceholder.classList.remove('hidden');
      if (btnRemoveFoto) btnRemoveFoto.classList.add('hidden');
    }
  }

  function resetFotoUI() {
    if (fotoInput) fotoInput.value = '';
    removeFoto = false;
    setFotoPreview('');
  }

  function openModal(isEdit) {
    if (!modal || !modalContent) return;
    modal.classList.remove('hidden');
    void modalContent.offsetWidth;
    modalContent.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
    modalContent.classList.add('scale-100', 'opacity-100', 'translate-y-0');
    document.body.style.overflow = 'hidden';
    if (!isEdit && formTambahAlat) {
      formTambahAlat.reset();
      resetFotoUI();
    }
  }

  function closeModal() {
    if (!modal || !modalContent) return;
    modalContent.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
    modalContent.classList.add('scale-95', 'opacity-0', 'translate-y-4');
    setTimeout(function () {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      if (formTambahAlat) formTambahAlat.reset();
      resetCategoryUI();
      resetFotoUI();
      editingRow = null;
    }, 300);
  }

  const categoryField = document.getElementById('category-field');
  const categoryTrigger = document.getElementById('category-trigger');
  const categoryTriggerLabel = document.getElementById('category-trigger-label');
  const categoryDropdown = document.getElementById('category-dropdown');
  const categoryOptions = document.getElementById('category-options');
  const categoryAddOther = document.getElementById('category-add-other');
  const categoryHidden = document.getElementById('select-category');
  const categoryCustomWrap = document.getElementById('category-custom-wrap');
  const categoryCustomInput = document.getElementById('input-category-custom');
  const defaultCategories = ['Elektronik', 'Biologi', 'Kimia', 'Mekanikal', 'Optik'];
  let categories = defaultCategories.slice();

  function normalizeCategory(value) {
    return String(value || '').replace(/\s+/g, ' ').trim();
  }

  function categoryKey(value) {
    return normalizeCategory(value).toLowerCase();
  }

  function collectCategoriesFromTable() {
    const set = new Set(defaultCategories.map(categoryKey));
    document.querySelectorAll('#table-body-alat tr td:nth-child(4)').forEach(function (cell) {
      const val = normalizeCategory(textOf(cell));
      if (!val || val === '-' || set.has(categoryKey(val))) return;
      set.add(categoryKey(val));
      categories.push(val);
    });
  }

  function renderCategoryOptions() {
    if (!categoryOptions) return;
    const selected = categoryKey(categoryHidden ? categoryHidden.value : '');
    categoryOptions.innerHTML = '';
    categories.forEach(function (cat) {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-1 rounded-lg ' + (selected === categoryKey(cat) ? 'bg-brand-50' : 'hover:bg-slate-50');

      const selectBtn = document.createElement('button');
      selectBtn.type = 'button';
      selectBtn.className = 'flex-1 text-left px-3 py-2 text-xs font-medium ' + (selected === categoryKey(cat) ? 'text-brand-700' : 'text-slate-700');
      selectBtn.textContent = cat;
      selectBtn.addEventListener('click', function () {
        setCategory(cat, false);
        closeCategoryDropdown();
      });

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'mr-1 p-1.5 rounded-md text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors shrink-0';
      removeBtn.title = 'Hapus kategori';
      removeBtn.setAttribute('aria-label', 'Hapus kategori ' + cat);
      removeBtn.innerHTML = '<span class="material-symbols-outlined text-[16px]">close</span>';
      removeBtn.addEventListener('click', async function (e) {
        e.stopPropagation();
        const ok = await window.sipatModal.confirm({
          title: 'Hapus kategori?',
          subtitle: 'Kategori akan dihapus dari pilihan form.',
          message: 'Kategori "' + cat + '" akan dihapus dari daftar pilihan. Data alat yang sudah ada tidak diubah.',
          confirmText: 'Hapus',
          cancelText: 'Batal',
          tone: 'danger'
        });
        if (!ok) return;
        categories = categories.filter(function (item) { return categoryKey(item) !== categoryKey(cat); });
        if (selected === categoryKey(cat)) clearCategorySelection();
        renderCategoryOptions();
      });

      row.appendChild(selectBtn);
      row.appendChild(removeBtn);
      categoryOptions.appendChild(row);
    });
  }

  function closeCategoryDropdown() {
    if (categoryDropdown) categoryDropdown.classList.add('hidden');
  }

  function openCategoryDropdown() {
    renderCategoryOptions();
    if (categoryDropdown) categoryDropdown.classList.remove('hidden');
  }

  function updateCategoryTrigger(label, muted) {
    if (!categoryTriggerLabel) return;
    categoryTriggerLabel.textContent = label;
    categoryTriggerLabel.className = (muted ? 'text-slate-400 truncate' : 'text-slate-700 truncate');
  }

  function clearCategorySelection() {
    if (categoryHidden) categoryHidden.value = '';
    if (categoryCustomInput) categoryCustomInput.value = '';
    if (categoryCustomWrap) categoryCustomWrap.classList.add('hidden');
    updateCategoryTrigger('Pilih Kategori', true);
  }

  function resetCategoryUI() {
    clearCategorySelection();
    closeCategoryDropdown();
    renderCategoryOptions();
  }

  function setCategory(value, useCustom) {
    const val = normalizeCategory(value);
    if (!val) { resetCategoryUI(); return false; }
    const existing = categories.find(function (cat) { return categoryKey(cat) === categoryKey(val); });
    if (existing && !useCustom) {
      if (categoryHidden) categoryHidden.value = existing;
      if (categoryCustomWrap) categoryCustomWrap.classList.add('hidden');
      if (categoryCustomInput) categoryCustomInput.value = '';
      updateCategoryTrigger(existing, false);
      renderCategoryOptions();
      return true;
    }
    if (categoryHidden) categoryHidden.value = val;
    if (categoryCustomWrap) categoryCustomWrap.classList.remove('hidden');
    if (categoryCustomInput) categoryCustomInput.value = val;
    updateCategoryTrigger(val, false);
    renderCategoryOptions();
    return true;
  }

  function getSelectedCategory() {
    const customVisible = categoryCustomWrap && !categoryCustomWrap.classList.contains('hidden');
    const customVal = normalizeCategory(categoryCustomInput ? categoryCustomInput.value : '');
    if (customVisible) return customVal;
    return normalizeCategory(categoryHidden ? categoryHidden.value : '');
  }

  if (categoryTrigger) {
    categoryTrigger.addEventListener('click', function () {
      if (!categoryDropdown) return;
      const hidden = categoryDropdown.classList.contains('hidden');
      if (hidden) openCategoryDropdown(); else closeCategoryDropdown();
    });
  }

  if (categoryAddOther) {
    categoryAddOther.addEventListener('click', function () {
      if (categoryCustomWrap) categoryCustomWrap.classList.remove('hidden');
      if (categoryCustomInput) {
        categoryCustomInput.value = '';
        categoryCustomInput.focus();
      }
      if (categoryHidden) categoryHidden.value = '';
      updateCategoryTrigger('Lain-lain', false);
      closeCategoryDropdown();
    });
  }

  if (categoryCustomInput) {
    categoryCustomInput.addEventListener('input', function () {
      const val = normalizeCategory(categoryCustomInput.value);
      if (categoryHidden) categoryHidden.value = val;
      updateCategoryTrigger(val || 'Lain-lain', !val);
    });
  }

  document.addEventListener('click', function (e) {
    if (categoryField && !categoryField.contains(e.target)) closeCategoryDropdown();
  });

  collectCategoriesFromTable();
  renderCategoryOptions();

  if (fotoInput) fotoInput.addEventListener('change', function () {
    const file = fotoInput.files && fotoInput.files[0];
    if (!file) { if (!removeFoto) setFotoPreview(editingRow ? (editingRow.dataset.foto || '') : ''); return; }
    if (file.size > 2 * 1024 * 1024) {
      window.sipatModal.toast('Ukuran foto maksimal 2MB.', 'danger');
      fotoInput.value = '';
      return;
    }
    removeFoto = false;
    const reader = new FileReader();
    reader.onload = function (e) { setFotoPreview(String(e.target && e.target.result || '')); };
    reader.readAsDataURL(file);
  });

  if (btnRemoveFoto) btnRemoveFoto.addEventListener('click', function () {
    removeFoto = true;
    if (fotoInput) fotoInput.value = '';
    setFotoPreview('');
  });

  if (btnOpenModal) {
    btnOpenModal.addEventListener('click', function (e) {
      e.preventDefault();
      editingRow = null;
      if (modalTitle) modalTitle.textContent = 'Tambah Alat Baru';
      if (modalSubtitle) modalSubtitle.textContent = 'Lengkapi informasi alat, stok, dan lokasi penyimpanan laboratorium';
      if (submitBtn) { submitBtn.dataset.mode = 'tambah'; delete submitBtn.dataset.id; submitBtn.querySelector('span').textContent = 'Simpan Alat'; }
      if (formTambahAlat) formTambahAlat.reset();
      const kodeInput = document.getElementById('input-kode-inventaris');
      if (kodeInput) kodeInput.value = '<%= nextKode %>';
      resetCategoryUI();
      resetFotoUI();
      openModal(false);
    });
  }

  if (btnCloseModal) btnCloseModal.addEventListener('click', closeModal);
  if (btnCancelModal) btnCancelModal.addEventListener('click', closeModal);
  if (modalOverlay) modalOverlay.addEventListener('click', closeModal);

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal();
  });


  // Edit buttons: open the existing form prefilled with the selected row.
  document.querySelectorAll('button[title="Edit"]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const row = btn.closest('tr');
      if (!row) return;
      editingRow = row;
      const data = {
        kode: btn.dataset.kode || '',
        nama: btn.dataset.nama || '',
        merek: btn.dataset.merek || '',
        kategori: btn.dataset.kategori || '',
        ruang: btn.dataset.ruang || '',
        lokasi: btn.dataset.lokasi || '',
        stok: btn.dataset.stok || '',
        foto: btn.dataset.foto || ''
      };

      if (modalTitle) modalTitle.textContent = 'Edit Alat';
      if (modalSubtitle) modalSubtitle.textContent = 'Perbarui informasi alat, stok, dan lokasi penyimpanan laboratorium';
      if (submitBtn) { submitBtn.dataset.mode = 'edit'; submitBtn.dataset.id = btn.getAttribute('data-id') || ''; submitBtn.querySelector('span').textContent = 'Simpan Perubahan'; }

      const fields = {
        'input-nama-alat': data.nama,
        'input-kode-inventaris': data.kode,
        'input-merek': data.merek,
        'input-stok': data.stok,
        'input-ruang': data.ruang,
        'input-lokasi-rak': data.lokasi
      };
      Object.keys(fields).forEach(function (id) {
        const input = document.getElementById(id);
        if (input) input.value = fields[id];
      });

      resetCategoryUI();
      resetFotoUI();
      if (data.kategori) setCategory(data.kategori);
      removeFoto = false;
      setFotoPreview(data.foto);
      openModal(true);
    });
  });

  // Form submit: simpan ke database lewat endpoint admin.
  if (formTambahAlat) {
    formTambahAlat.addEventListener('submit', async function (e) {
      e.preventDefault();
      const mode = submitBtn ? (submitBtn.dataset.mode || 'tambah') : 'tambah';
      const nama = (document.getElementById('input-nama-alat') || {}).value || '';
      const kode = (document.getElementById('input-kode-inventaris') || {}).value || '';
      const merek = (document.getElementById('input-merek') || {}).value || '';
      const stok = (document.getElementById('input-stok') || {}).value || '';
      const ruang = (document.getElementById('input-ruang') || {}).value || '';
      const lokasi = (document.getElementById('input-lokasi-rak') || {}).value || '';
      const kategori = getSelectedCategory();
      const fotoFile = fotoInput && fotoInput.files ? fotoInput.files[0] : null;

      if (!nama.trim()) {
        await window.sipatModal.alert({
          title: 'Data Belum Lengkap',
          subtitle: 'Periksa kembali isian formulir.',
          message: 'Nama Alat wajib diisi.',
          tone: 'warning'
        });
        return;
      }

      const originalHtml = submitBtn ? submitBtn.innerHTML : '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span><span>Menyimpan...</span>';
      }

      try {
        const formData = new FormData();
        formData.append('nama', nama.trim());
        formData.append('kode', kode.trim());
        formData.append('merek', merek.trim());
        formData.append('stok', stok);
        formData.append('ruang', ruang.trim());
        formData.append('lokasi', lokasi.trim());
        formData.append('kategori', kategori);
        if (fotoFile) formData.append('foto', fotoFile);
        if (removeFoto) formData.append('remove_foto', '1');

        const url = mode === 'edit' && submitBtn && submitBtn.dataset.id
          ? '/admin/alat/' + submitBtn.dataset.id
          : '/admin/alat';
        const response = await fetch(url, { method: 'POST', body: formData });
        const result = await response.json().catch(function () { return {}; });
        if (!response.ok) throw new Error(result.message || 'Gagal menyimpan data alat.');

        closeModal();
        window.sipatModal.toast(mode === 'edit' ? 'Perubahan data alat berhasil disimpan.' : 'Data alat baru berhasil disimpan.', 'success');
        setTimeout(function () { window.location.reload(); }, 600);
      } catch (error) {
        window.sipatModal.toast(error.message || 'Gagal menyimpan data alat. Silakan coba lagi.', 'danger');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalHtml || '<span>Simpan Alat</span>';
        }
      }
    });
  }

  // Delete buttons: custom confirmation with the selected item identity.
  document.querySelectorAll('button[title="Hapus"]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const row = btn.closest('tr');
      const id = btn.dataset.id;
      const kode = btn.dataset.kode || textOf(row && row.children[1]) || 'N/A';
      const nama = btn.dataset.nama || 'Alat';

      window.sipatModal.confirm({
        title: 'Hapus Data Alat?',
        subtitle: 'Tindakan ini tidak dapat dibatalkan.',
        tone: 'danger',
        message: '<div class="text-sm text-slate-700 space-y-2">' +
          '<p>Apakah Anda yakin ingin menghapus data alat berikut?</p>' +
          '<div class="rounded-xl border border-rose-100 bg-rose-50/70 px-4 py-3 space-y-1">' +
          '<p class="text-xs text-slate-500">Kode Inventaris</p>' +
          '<p class="font-mono font-bold text-rose-700">' + window.sipatModal.escape(kode) + '</p>' +
          '<p class="font-semibold text-slate-800 mt-1">' + window.sipatModal.escape(nama) + '</p>' +
          '</div></div>',
        confirmText: 'Ya, Hapus',
        confirmClass: 'px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 transition shadow-sm inline-flex items-center justify-center gap-2',
        loadingText: 'Menghapus...',
        onConfirm: async function () {
          if (!id) throw new Error('Data alat tidak ditemukan.');
          const response = await fetch('/admin/alat/' + id + '/delete', { method: 'POST' });
          const result = await response.json().catch(function () { return {}; });
          if (!response.ok) throw new Error(result.message || 'Gagal menghapus data alat.');
          window.sipatModal.toast('Data alat ' + kode + ' berhasil dihapus.', 'success');
          setTimeout(function () { window.location.reload(); }, 600);
        }
      });
    });
  });
});
</script>

