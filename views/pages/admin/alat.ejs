<!-- Script Interactivity Modal Tambah/Edit Alat & Aksi Tabel -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  const modal = document.getElementById('modal-tambah-alat');
  const modalOverlay = document.getElementById('modal-overlay');
  const modalContent = document.getElementById('modal-content');
  const formTambahAlat = document.getElementById('form-tambah-alat');
  const submitBtn = document.getElementById('btn-submit-alat');
  const modalTitle = document.querySelector('#modal-tambah-alat h2');
  const btnOpenModal = document.getElementById('btn-open-form-alat');
  const btnCloseModal = document.getElementById('btn-close-modal');
  const btnCancelModal = document.getElementById('btn-cancel-modal');
  let editingRow = null;

  const wait = function (ms) { return new Promise(function (resolve) { setTimeout(resolve, ms); }); };
  const textOf = function (el) { return el ? (el.textContent || '').replace(/\s+/g, ' ').trim() : ''; };

  function openModal(isEdit) {
    if (!modal || !modalOverlay || !modalContent) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modalOverlay.classList.remove('hidden');
    void modalContent.offsetWidth;
    modalContent.classList.remove('scale-95', 'opacity-0', 'translate-y-4');
    modalContent.classList.add('scale-100', 'opacity-100', 'translate-y-0');
    document.body.style.overflow = 'hidden';
    if (!isEdit && formTambahAlat) formTambahAlat.reset();
  }

  function closeModal() {
    if (!modal || !modalOverlay || !modalContent) return;
    modalContent.classList.remove('scale-100', 'opacity-100', 'translate-y-0');
    modalContent.classList.add('scale-95', 'opacity-0', 'translate-y-4');
    setTimeout(function () {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modalOverlay.classList.add('hidden');
      document.body.style.overflow = '';
      if (formTambahAlat) formTambahAlat.reset();
      resetCategoryUI();
      editingRow = null;
    }, 200);
  }

  function resetCategoryUI() {
    const txt = document.getElementById('selected-category-text');
    if (txt) { txt.textContent = 'Pilih Kategori'; txt.className = 'text-slate-500'; }
    document.querySelectorAll('input[name="category"]').forEach(function (radio) { radio.checked = false; });
    const inpNew = document.getElementById('input-new-category-name');
    if (inpNew) inpNew.value = '';
    const panel = document.getElementById('category-dropdown-panel');
    if (panel) panel.classList.add('hidden');
    const chevron = document.getElementById('category-chevron');
    if (chevron) chevron.textContent = 'expand_more';
  }

  function setCategory(value) {
    let found = false;
    document.querySelectorAll('input[name="category"]').forEach(function (radio) {
      if (radio.value === value) { radio.checked = true; found = true; }
    });
    const selectedCategoryText = document.getElementById('selected-category-text');
    if (found && selectedCategoryText) {
      selectedCategoryText.textContent = value;
      selectedCategoryText.className = 'text-slate-800 font-medium';
    }
    return found;
  }

  if (btnOpenModal) {
    btnOpenModal.addEventListener('click', function (e) {
      e.preventDefault();
      editingRow = null;
      if (modalTitle) modalTitle.textContent = 'Tambah Alat Baru';
      if (submitBtn) { submitBtn.dataset.mode = 'tambah'; delete submitBtn.dataset.id; }
      if (formTambahAlat) formTambahAlat.reset();
      resetCategoryUI();
      openModal(false);
    });
  }

  if (btnCloseModal) btnCloseModal.addEventListener('click', closeModal);
  if (btnCancelModal) btnCancelModal.addEventListener('click', closeModal);
  if (modalOverlay) modalOverlay.addEventListener('click', closeModal);
  if (modal) {
    modal.addEventListener('click', function (event) {
      if (event.target === modal) closeModal();
    });
  }

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal();
  });

  // Category dropdown
  const btnCategoryDropdown = document.getElementById('btn-category-dropdown');
  const categoryDropdownPanel = document.getElementById('category-dropdown-panel');
  const categoryChevron = document.getElementById('category-chevron');
  const selectedCategoryText = document.getElementById('selected-category-text');

  if (btnCategoryDropdown && categoryDropdownPanel) {
    btnCategoryDropdown.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      const isHidden = categoryDropdownPanel.classList.toggle('hidden');
      if (categoryChevron) categoryChevron.textContent = isHidden ? 'expand_more' : 'expand_less';
    });
    document.addEventListener('click', function (e) {
      if (!btnCategoryDropdown.contains(e.target) && !categoryDropdownPanel.contains(e.target)) {
        categoryDropdownPanel.classList.add('hidden');
        if (categoryChevron) categoryChevron.textContent = 'expand_more';
      }
    });
  }

  document.querySelectorAll('input[name="category"]').forEach(function (radio) {
    radio.addEventListener('change', function () {
      if (radio.checked && selectedCategoryText) {
        selectedCategoryText.textContent = radio.value;
        selectedCategoryText.className = 'text-slate-800 font-medium';
        if (categoryDropdownPanel) categoryDropdownPanel.classList.add('hidden');
        if (categoryChevron) categoryChevron.textContent = 'expand_more';
      }
    });
  });

  const btnSaveCategory = document.getElementById('btn-save-category');
  const inputNewCategory = document.getElementById('input-new-category-name');
  if (btnSaveCategory && inputNewCategory) {
    btnSaveCategory.addEventListener('click', function (e) {
      e.preventDefault();
      const name = (inputNewCategory.value || '').trim();
      if (!name) return;
      const list = document.getElementById('category-list-container');
      if (!list) return;
      const escaped = window.sipatModal ? window.sipatModal.escape(name) : name;
      const existing = Array.from(document.querySelectorAll('input[name="category"]')).some(function (r) { return r.value.toLowerCase() === name.toLowerCase(); });
      if (existing) {
        document.querySelectorAll('input[name="category"]').forEach(function (r) {
          if (r.value.toLowerCase() === name.toLowerCase()) { r.checked = true; r.dispatchEvent(new Event('change')); }
        });
        inputNewCategory.value = '';
        return;
      }
      const label = document.createElement('label');
      label.className = 'flex items-center gap-2 cursor-pointer select-none p-2 rounded-lg hover:bg-slate-50';
      label.innerHTML = '<input type="radio" name="category" value="' + escaped + '" class="w-3.5 h-3.5 text-slate-600 focus:ring-slate-500"><span class="font-medium text-slate-800 text-xs">' + escaped + '</span>';
      const radio = label.querySelector('input[type="radio"]');
      radio.addEventListener('change', function () {
        if (radio.checked && selectedCategoryText) {
          selectedCategoryText.textContent = radio.value;
          selectedCategoryText.className = 'text-slate-800 font-medium';
          if (categoryDropdownPanel) categoryDropdownPanel.classList.add('hidden');
          if (categoryChevron) categoryChevron.textContent = 'expand_more';
        }
      });
      list.appendChild(label);
      radio.checked = true;
      radio.dispatchEvent(new Event('change'));
      inputNewCategory.value = '';
    });
  }

  // Edit buttons: open the existing form prefilled with the selected row.
  document.querySelectorAll('button[title="Edit"]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const row = btn.closest('tr');
      if (!row) return;
      editingRow = row;
      const cells = row.children;
      const nameCell = cells[2];
      const nameSpans = nameCell ? nameCell.querySelectorAll('span') : [];
      const data = {
        kode: textOf(cells[1]),
        nama: textOf(nameSpans[0]),
        merek: textOf(nameSpans[1]),
        kategori: textOf(cells[3]),
        ruang: textOf(cells[4]),
        lokasi: textOf(cells[5]),
        stok: textOf(cells[7]).replace(/[^\d]/g, '')
      };

      if (modalTitle) modalTitle.textContent = 'Edit Alat';
      if (submitBtn) { submitBtn.dataset.mode = 'edit'; submitBtn.dataset.id = btn.getAttribute('data-id') || ''; }

      const fields = {
        'input-nama-alat': data.nama,
        'input-kode-inventaris': data.kode,
        'input-merek': data.merek,
        'input-stok': data.stok,
        'input-ruang': data.ruang,
        'input-lokasi-rak': data.lokasi
      };
      Object.keys(fields).forEach(function (id) {
        const input = document.getElementById(id);
        if (input) input.value = fields[id];
      });

      resetCategoryUI();
      if (data.kategori) setCategory(data.kategori);
      openModal(true);
    });
  });

  function updateRow(row, data) {
    const cells = row.children;
    if (cells[1]) cells[1].textContent = data.kode;
    if (cells[2]) {
      const spans = cells[2].querySelectorAll('span');
      if (spans[0]) spans[0].textContent = data.nama;
      if (spans[1]) spans[1].textContent = data.merek || spans[1].textContent;
    }
    if (cells[3]) cells[3].textContent = data.kategori || '-';
    if (cells[4]) cells[4].textContent = data.ruang || '-';
    if (cells[5]) cells[5].textContent = data.lokasi || '-';
    if (cells[7] && data.stok !== '') {
      cells[7].textContent = data.stok + ' Unit';
      const stock = Number(data.stok);
      cells[7].className = 'w-28 px-3.5 py-3.5 text-center font-bold text-xs whitespace-nowrap ' +
        (stock === 0 ? 'text-amber-600' : 'text-emerald-600');
    }

    row.querySelectorAll('button[title="Edit"]').forEach(function (button) {
      button.dataset.kode = data.kode;
      button.dataset.nama = data.nama;
      button.dataset.kategori = data.kategori;
      button.dataset.ruang = data.ruang;
      button.dataset.lokasi = data.lokasi;
    });
    row.querySelectorAll('button[title="Hapus"]').forEach(function (button) {
      button.dataset.kode = data.kode;
      button.dataset.nama = data.nama;
    });
  }

  // Form submit. The prototype has no persistence endpoint, so a successful
  // edit updates the row in place and confirms the result with a toast.
  if (formTambahAlat) {
    formTambahAlat.addEventListener('submit', async function (e) {
      e.preventDefault();
      const mode = submitBtn ? (submitBtn.dataset.mode || 'tambah') : 'tambah';
      const nama = (document.getElementById('input-nama-alat') || {}).value || '';
      const kode = (document.getElementById('input-kode-inventaris') || {}).value || '';
      const merek = (document.getElementById('input-merek') || {}).value || '';
      const stok = (document.getElementById('input-stok') || {}).value || '';
      const ruang = (document.getElementById('input-ruang') || {}).value || '';
      const lokasi = (document.getElementById('input-lokasi-rak') || {}).value || '';
      const selectedRadio = document.querySelector('input[name="category"]:checked');
      const kategori = selectedRadio ? selectedRadio.value : '';

      if (!nama.trim() || !kode.trim()) {
        await window.sipatModal.alert({
          title: 'Data Belum Lengkap',
          subtitle: 'Periksa kembali isian formulir.',
          message: 'Nama Alat dan Kode Inventaris wajib diisi.',
          tone: 'warning'
        });
        return;
      }

      const originalHtml = submitBtn ? submitBtn.innerHTML : '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span><span>Menyimpan...</span>';
      }

      try {
        await wait(600);
        if (mode === 'edit' && editingRow) {
          updateRow(editingRow, { nama: nama.trim(), kode: kode.trim(), merek: merek.trim(), stok: stok, ruang: ruang.trim(), lokasi: lokasi.trim(), kategori: kategori });
          window.sipatModal.toast('Perubahan data alat berhasil disimpan.', 'success');
        } else {
          window.sipatModal.toast('Data alat baru berhasil disimpan.', 'success');
        }
        closeModal();
      } catch (error) {
        window.sipatModal.toast('Gagal menyimpan data alat. Silakan coba lagi.', 'danger');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalHtml || '<span>Simpan Alat</span>';
        }
      }
    });
  }

  function renumberRows() {
    const table = document.querySelector('table tbody');
    if (!table) return;
    Array.prototype.forEach.call(table.querySelectorAll('tr'), function (row, index) {
      const firstCell = row.children[0];
      if (firstCell) firstCell.textContent = String(index + 1).padStart(2, '0');
    });
  }

  // Delete buttons: custom confirmation with the selected item identity.
  document.querySelectorAll('button[title="Hapus"]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const row = btn.closest('tr');
      const kode = btn.getAttribute('data-kode') || textOf(row && row.children[1]) || 'N/A';
      const nama = btn.getAttribute('data-nama') || (row && row.querySelector('span.font-bold') ? textOf(row.querySelector('span.font-bold')) : 'Alat');

      window.sipatModal.confirm({
        title: 'Hapus Data Alat?',
        subtitle: 'Tindakan ini tidak dapat dibatalkan.',
        tone: 'danger',
        message: '<div class="text-sm text-slate-700 space-y-2">' +
          '<p>Apakah Anda yakin ingin menghapus data alat berikut?</p>' +
          '<div class="rounded-xl border border-rose-100 bg-rose-50/70 px-4 py-3 space-y-1">' +
          '<p class="text-xs text-slate-500">Kode Inventaris</p>' +
          '<p class="font-mono font-bold text-rose-700">' + window.sipatModal.escape(kode) + '</p>' +
          '<p class="font-semibold text-slate-800 mt-1">' + window.sipatModal.escape(nama) + '</p>' +
          '</div></div>',
        confirmText: 'Ya, Hapus',
        confirmClass: 'px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 transition shadow-sm inline-flex items-center justify-center gap-2',
        loadingText: 'Menghapus...',
        onConfirm: async function () {
          await wait(550);
          if (!row || !row.parentNode) throw new Error('Data alat tidak ditemukan atau sudah dihapus.');
          row.style.transition = 'opacity 0.18s ease, transform 0.18s ease';
          row.style.opacity = '0';
          row.style.transform = 'translateY(-4px)';
          await wait(180);
          row.remove();
          renumberRows();
          window.sipatModal.toast('Data alat ' + kode + ' berhasil dihapus.', 'success');
        }
      });
    });
  });
});
</script>
