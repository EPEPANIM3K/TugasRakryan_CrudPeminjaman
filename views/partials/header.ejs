<header class="bg-white border-b border-slate-200 px-3 sm:px-8 py-3 sm:py-3.5 flex items-center justify-between gap-2">
  <div class="flex items-center space-x-2 sm:space-x-3 text-sm font-semibold text-slate-800 min-w-0">
    <button id="menu-toggle" type="button"
      aria-label="Tampilkan atau sembunyikan sidebar"
      aria-controls="sidebar" aria-expanded="true"
      class="is-open p-2 -ml-2 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-lg transition">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line class="bar bar-1" x1="4" y1="6" x2="20" y2="6"></line>
        <line class="bar bar-2" x1="4" y1="12" x2="20" y2="12"></line>
        <line class="bar bar-3" x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
    </button>

    <div class="flex items-center space-x-2 min-w-0 whitespace-nowrap">
      <span class="hidden sm:inline text-slate-900 font-bold uppercase tracking-wider text-xs">SIPAT</span>
      <span class="hidden sm:inline text-slate-400">/</span>
      <span class="text-slate-800 sm:text-slate-600 font-semibold truncate"><%= pageTitle || 'Dashboard Admin' %></span>
    </div>
  </div>

  <div class="flex items-center space-x-1 sm:space-x-5 shrink-0">
    <button aria-label="Notifikasi"
      class="relative p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition"
      type="button">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 00-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
          stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
      </svg>
      <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-blue-600 rounded-full"></span>
    </button>

    <div class="hidden sm:block h-6 w-px bg-slate-200"></div>

    <div class="flex items-center space-x-3 pl-1 sm:pl-0">
      <div class="text-right leading-tight hidden sm:block">
        <span class="block text-sm font-bold text-slate-800">Admin Utama</span>
        <span class="block text-xs font-medium text-slate-400">Super Admin</span>
      </div>
      <div class="w-9 h-9 rounded-full bg-blue-100 border border-blue-200 flex items-center justify-center text-blue-700 font-bold text-xs uppercase shadow-sm">AU</div>
    </div>
  </div>
</header>