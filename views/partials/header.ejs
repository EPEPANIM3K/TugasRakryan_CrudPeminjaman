<header class="bg-white border-b border-slate-200 px-4 sm:px-8 py-3.5 sm:py-3.5 flex items-center justify-between gap-3">
  <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
    <button id="menu-toggle" type="button"
      aria-label="Tampilkan atau sembunyikan sidebar"
      aria-controls="sidebar" aria-expanded="true"
      class="is-open inline-flex items-center justify-center w-10 h-10 sm:w-9 sm:h-9 -ml-1.5 sm:-ml-2 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-lg transition shrink-0">
      <svg class="w-6 h-6 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line class="bar bar-1" x1="4" y1="6" x2="20" y2="6"></line>
        <line class="bar bar-2" x1="4" y1="12" x2="20" y2="12"></line>
        <line class="bar bar-3" x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
    </button>

    <div class="flex items-center gap-2 min-w-0 whitespace-nowrap">
      <span class="hidden sm:inline text-slate-900 font-bold uppercase tracking-wider text-xs">SIPAT</span>
      <span class="hidden sm:inline text-slate-400 text-sm">/</span>
      <span class="text-[15px] sm:text-sm text-slate-900 sm:text-slate-600 font-bold sm:font-semibold truncate leading-tight"><%= pageTitle || 'Dashboard Admin' %></span>
    </div>
  </div>

  <div class="flex items-center gap-1.5 sm:gap-5 shrink-0">
    <button aria-label="Notifikasi"
      class="relative inline-flex items-center justify-center w-10 h-10 sm:w-9 sm:h-9 text-slate-500 sm:text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition"
      type="button">
      <svg class="w-6 h-6 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 00-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
          stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
      </svg>
      <span class="absolute top-2 right-2 sm:top-1.5 sm:right-1.5 w-2.5 h-2.5 sm:w-2 sm:h-2 bg-blue-600 rounded-full ring-2 ring-white"></span>
    </button>

    <div class="hidden sm:block h-6 w-px bg-slate-200"></div>

    <div class="flex items-center gap-2 sm:gap-3 pl-0.5 sm:pl-0">
      <div class="text-right leading-tight hidden sm:block">
        <span class="block text-sm font-bold text-slate-800"><%= typeof userName !== 'undefined' ? userName : 'Admin Utama' %></span>
        <span class="block text-xs font-medium text-slate-400"><%= typeof userRole !== 'undefined' ? userRole : 'Super Admin' %></span>
      </div>
      <div class="w-10 h-10 sm:w-9 sm:h-9 rounded-full bg-blue-100 border border-blue-200 flex items-center justify-center text-blue-700 font-bold text-sm sm:text-xs uppercase shadow-sm"><%= typeof userInitials !== 'undefined' ? userInitials : 'AU' %></div>
    </div>
  </div>
</header>
